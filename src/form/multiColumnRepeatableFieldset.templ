package uiForm

import (
	_ "embed"
	"encoding/json"
	"log/slog"
	"strconv"
	"strings"
	"unicode/utf8"

	uiControl "github.com/goinfinite/ui/src/control"
	uiToolset "github.com/goinfinite/ui/src/toolset"
)

//go:embed multiColumnRepeatableFieldsetState.js
var multiColumnRepeatableFieldsetAlpineState string

var multiColumnRepeatableFieldsetAlpineStateOnce = templ.NewOnceHandle(
	templ.WithComponent(uiToolset.MinifierTemplateJs(&multiColumnRepeatableFieldsetAlpineState)),
)

const (
	MultiColumnRepeatableFieldsetColumnTypeText     string = "text"
	MultiColumnRepeatableFieldsetColumnTypeNumber   string = "number"
	MultiColumnRepeatableFieldsetColumnTypeSelect   string = "select"
	MultiColumnRepeatableFieldsetColumnTypeCheckbox string = "checkbox"
)

type MultiColumnRepeatableFieldsetDropdownStyle struct {
	// OptionalFields
	BackgroundColor string
	BorderColor     string
	BorderRadius    string
}

type MultiColumnRepeatableFieldsetCheckboxStyle struct {
	// OptionalFields
	CheckedColor   string
	FocusRingColor string
	Shape          string
	UncheckedColor string
}

type MultiColumnRepeatableFieldsetSelectStyle struct {
	// OptionalFields
	SelectedIconColor string
	Trigger           SelectInputTriggerStyle
}

type MultiColumnRepeatableFieldsetColumn struct {
	Id                   string
	Label                string
	LabelOneWayStatePath string
	InputType            string

	// OptionalFields
	IsRequired bool
	Max        string
	Min        string
	Options    []SelectLabelValueOption
	Step       string
}

type MultiColumnRepeatableFieldsetBulkEditSettings struct {
	// OptionalFields
	ButtonIcon       string
	ButtonLabel      string
	Delimiter        string
	HintValue        string
	IsEnabled        bool
	TableButtonIcon  string
	TableButtonLabel string
	TextAreaLabel    string
}

type MultiColumnRepeatableFieldsetAddRowButtonStyle struct {
	// OptionalFields
	BackgroundColor      string
	BackgroundColorHover string
	IconLeft             string
	IconRight            string
	Shape                string
	TextColor            string
	TextColorHover       string
}

type MultiColumnRepeatableFieldsetBulkEditButtonStyle struct {
	// OptionalFields
	BackgroundColor      string
	BackgroundColorHover string
	Shape                string
	TextColor            string
	TextColorHover       string
}

type MultiColumnRepeatableFieldsetSettings struct {
	Columns         []MultiColumnRepeatableFieldsetColumn
	TwoWayStatePath string

	// OptionalFields
	AddRowButton    MultiColumnRepeatableFieldsetAddRowButtonStyle
	AddRowLabel     string
	BulkEdit        MultiColumnRepeatableFieldsetBulkEditSettings
	BulkEditButton  MultiColumnRepeatableFieldsetBulkEditButtonStyle
	Checkbox        MultiColumnRepeatableFieldsetCheckboxStyle
	Dropdown        MultiColumnRepeatableFieldsetDropdownStyle
	EmptyStateLabel string
	InputName       string
	NewRowFunc      string
	Select          MultiColumnRepeatableFieldsetSelectStyle
	Size            string
	TextCase        string
}

type multiColumnRepeatableFieldsetColumnMetadata struct {
	Id         string `json:"id"`
	InputType  string `json:"inputType"`
	IsRequired bool   `json:"isRequired"`
}

func multiColumnRepeatableFieldsetColumnMetadataJsonBuilder(
	columns []MultiColumnRepeatableFieldsetColumn,
) string {
	metadata := make([]multiColumnRepeatableFieldsetColumnMetadata, 0, len(columns))
	for _, column := range columns {
		metadata = append(metadata, multiColumnRepeatableFieldsetColumnMetadata{
			Id:         column.Id,
			InputType:  column.InputType,
			IsRequired: column.IsRequired,
		})
	}
	encodedMetadata, marshalErr := json.Marshal(metadata)
	if marshalErr != nil {
		slog.Debug(
			"MultiColumnRepeatableFieldsetMetadataMarshalFailure",
			slog.String("error", marshalErr.Error()),
		)
		return "[]"
	}
	return string(encodedMetadata)
}

func multiColumnRepeatableFieldsetAddRowIconResolver(
	componentSettings MultiColumnRepeatableFieldsetSettings,
) string {
	if componentSettings.AddRowButton.IconLeft != "" {
		return componentSettings.AddRowButton.IconLeft
	}
	return "ph-plus"
}

func multiColumnRepeatableFieldsetAddRowLabelResolver(
	componentSettings MultiColumnRepeatableFieldsetSettings,
) string {
	if componentSettings.AddRowLabel != "" {
		return componentSettings.AddRowLabel
	}
	return "add row"
}

func multiColumnRepeatableFieldsetEmptyStateLabelResolver(
	componentSettings MultiColumnRepeatableFieldsetSettings,
) string {
	if componentSettings.EmptyStateLabel != "" {
		return componentSettings.EmptyStateLabel
	}
	return "No rows yet"
}

func multiColumnRepeatableFieldsetInputTypeResolver(
	column MultiColumnRepeatableFieldsetColumn,
) string {
	if column.InputType == MultiColumnRepeatableFieldsetColumnTypeNumber {
		return MultiColumnRepeatableFieldsetColumnTypeNumber
	}
	return MultiColumnRepeatableFieldsetColumnTypeText
}

func multiColumnRepeatableFieldsetBulkEditDelimiterIsValid(
	delimiter string,
) bool {
	if utf8.RuneCountInString(delimiter) != 1 {
		return false
	}
	if strings.HasPrefix(delimiter, "n") || strings.HasPrefix(delimiter, "\\") {
		return false
	}
	return !strings.ContainsAny(delimiter, "\r\n")
}

func multiColumnRepeatableFieldsetBulkEditDelimiterResolver(
	componentSettings MultiColumnRepeatableFieldsetSettings,
) string {
	configuredDelimiter := componentSettings.BulkEdit.Delimiter
	if configuredDelimiter != "" &&
		multiColumnRepeatableFieldsetBulkEditDelimiterIsValid(configuredDelimiter) {
		return configuredDelimiter
	}
	if len(componentSettings.Columns) > 2 {
		return "|"
	}
	return "="
}

func multiColumnRepeatableFieldsetBulkEditButtonLabelResolver(
	componentSettings MultiColumnRepeatableFieldsetSettings,
) string {
	if componentSettings.BulkEdit.ButtonLabel != "" {
		return componentSettings.BulkEdit.ButtonLabel
	}
	return "bulk edit"
}

func multiColumnRepeatableFieldsetBulkEditTableButtonLabelResolver(
	componentSettings MultiColumnRepeatableFieldsetSettings,
) string {
	if componentSettings.BulkEdit.TableButtonLabel != "" {
		return componentSettings.BulkEdit.TableButtonLabel
	}
	return "table view"
}

func multiColumnRepeatableFieldsetBulkEditTextAreaLabelResolver(
	componentSettings MultiColumnRepeatableFieldsetSettings,
) string {
	if componentSettings.BulkEdit.TextAreaLabel != "" {
		return componentSettings.BulkEdit.TextAreaLabel
	}
	return "Bulk edit"
}

func multiColumnRepeatableFieldsetBulkEditHintValueResolver(
	componentSettings MultiColumnRepeatableFieldsetSettings,
) string {
	if componentSettings.BulkEdit.HintValue != "" {
		return componentSettings.BulkEdit.HintValue
	}
	if len(componentSettings.Columns) < 2 {
		return "One row per line. Blank lines are ignored."
	}
	return "One row per line. Separate the columns with \"" +
		multiColumnRepeatableFieldsetBulkEditDelimiterResolver(componentSettings) +
		"\". Blank lines are ignored."
}

type multiColumnRepeatableFieldsetBulkEditMetadata struct {
	Delimiter        string `json:"delimiter"`
	ButtonLabel      string `json:"buttonLabel"`
	TableButtonLabel string `json:"tableButtonLabel"`
	ButtonIcon       string `json:"buttonIcon"`
	TableButtonIcon  string `json:"tableButtonIcon"`
}

func multiColumnRepeatableFieldsetBulkEditMetadataJsonBuilder(
	componentSettings MultiColumnRepeatableFieldsetSettings,
) string {
	delimiter := multiColumnRepeatableFieldsetBulkEditDelimiterResolver(componentSettings)
	buttonLabel := multiColumnRepeatableFieldsetBulkEditButtonLabelResolver(componentSettings)
	tableButtonLabel := multiColumnRepeatableFieldsetBulkEditTableButtonLabelResolver(componentSettings)
	metadata := multiColumnRepeatableFieldsetBulkEditMetadata{
		Delimiter:        delimiter,
		ButtonLabel:      buttonLabel,
		TableButtonLabel: tableButtonLabel,
		ButtonIcon:       componentSettings.BulkEdit.ButtonIcon,
		TableButtonIcon:  componentSettings.BulkEdit.TableButtonIcon,
	}
	encodedMetadata, marshalErr := json.Marshal(metadata)
	if marshalErr != nil {
		slog.Debug(
			"MultiColumnRepeatableFieldsetBulkEditMetadataMarshalFailure",
			slog.String("error", marshalErr.Error()),
		)
		return `{"delimiter":` + strconv.Quote(delimiter) +
			`,"buttonLabel":` + strconv.Quote(buttonLabel) +
			`,"tableButtonLabel":` + strconv.Quote(tableButtonLabel) +
			`,"buttonIcon":` + strconv.Quote(componentSettings.BulkEdit.ButtonIcon) +
			`,"tableButtonIcon":` + strconv.Quote(componentSettings.BulkEdit.TableButtonIcon) + `}`
	}
	return string(encodedMetadata)
}

templ multiColumnRepeatableFieldsetCell(
	column MultiColumnRepeatableFieldsetColumn,
	componentSettings MultiColumnRepeatableFieldsetSettings,
) {
	{{ rowExpression := "row[" + strconv.Quote(column.Id) + "]" }}
	{{ invalidExpression := "columnIsInvalid(row, " + strconv.Quote(column.Id) + ")" }}
	switch column.InputType {
		case MultiColumnRepeatableFieldsetColumnTypeCheckbox:
			@CheckboxInput(CheckboxInputSettings{
				AriaLabel:                column.Label,
				AriaLabelOneWayStatePath: column.LabelOneWayStatePath,
				CheckedColor:             componentSettings.Checkbox.CheckedColor,
				FocusRingColor:           componentSettings.Checkbox.FocusRingColor,
				IsInvalidOneWayStatePath: invalidExpression,
				IsRequired:               column.IsRequired,
				Shape:                    componentSettings.Checkbox.Shape,
				Size:                     componentSettings.Size,
				TwoWayStatePath:          rowExpression,
				UncheckedColor:           componentSettings.Checkbox.UncheckedColor,
			})
		case MultiColumnRepeatableFieldsetColumnTypeSelect:
			@SelectInput(SelectInputSettings{
				Label:                    column.Label,
				LabelOneWayStatePath:     column.LabelOneWayStatePath,
				LabelValueOptions:        column.Options,
				ShouldIncludeBlankOption: true,
				IsInvalidOneWayStatePath: invalidExpression,
				IsRequired:               column.IsRequired,
				Size:                     componentSettings.Size,
				TextCase:                 componentSettings.TextCase,
				TwoWayStatePath:          rowExpression,
				DropdownBackgroundColor:  componentSettings.Dropdown.BackgroundColor,
				DropdownBorderColor:      componentSettings.Dropdown.BorderColor,
				DropdownBorderRadius:     componentSettings.Dropdown.BorderRadius,
				SelectedIconColor:        componentSettings.Select.SelectedIconColor,
				Trigger:                  componentSettings.Select.Trigger,
			})
		default:
			@InputField(InputFieldSettings{
				InputType:                multiColumnRepeatableFieldsetInputTypeResolver(column),
				Label:                    column.Label,
				LabelOneWayStatePath:     column.LabelOneWayStatePath,
				InputNumberMax:           column.Max,
				InputNumberMin:           column.Min,
				InputNumberStep:          column.Step,
				IsInvalidOneWayStatePath: invalidExpression,
				IsRequired:               column.IsRequired,
				Size:                     componentSettings.Size,
				TextCase:                 componentSettings.TextCase,
				TwoWayStatePath:          rowExpression,
			})
	}
}

templ MultiColumnRepeatableFieldset(componentSettings MultiColumnRepeatableFieldsetSettings) {
	{{ statePath := componentSettings.TwoWayStatePath }}
	{{ columnMetadataJson := multiColumnRepeatableFieldsetColumnMetadataJsonBuilder(componentSettings.Columns) }}
	{{ addRowIcon := multiColumnRepeatableFieldsetAddRowIconResolver(componentSettings) }}
	{{ addRowLabel := multiColumnRepeatableFieldsetAddRowLabelResolver(componentSettings) }}
	{{ emptyStateLabel := multiColumnRepeatableFieldsetEmptyStateLabelResolver(componentSettings) }}
	{{ isBulkEditEnabled := componentSettings.BulkEdit.IsEnabled }}
	{{ bulkEditMetadataJson := multiColumnRepeatableFieldsetBulkEditMetadataJsonBuilder(componentSettings) }}
	{{ bulkEditTextAreaLabel := multiColumnRepeatableFieldsetBulkEditTextAreaLabelResolver(componentSettings) }}
	{{ bulkEditHintValue := multiColumnRepeatableFieldsetBulkEditHintValueResolver(componentSettings) }}
	@multiColumnRepeatableFieldsetAlpineStateOnce.Once()
	<!-- MultiColumnRepeatableFieldset -->
	<div
		class="w-full"
		x-data={ templ.JSFuncCall("multiColumnRepeatableFieldset", templ.JSExpression(columnMetadataJson), componentSettings.NewRowFunc, templ.JSExpression(bulkEditMetadataJson)) }
	>
		<table
			class="w-full border-collapse text-sm"
			if isBulkEditEnabled {
				x-show="!isBulkEditing"
			}
		>
			<thead>
				<tr class="border-b border-neutral-50/10 text-left text-xs text-neutral-400">
					for _, column := range componentSettings.Columns {
						<th scope="col" class="px-2 py-2 font-medium">
							@statePathBoundLabelText(column.Label, column.LabelOneWayStatePath)
						</th>
					}
					<th scope="col" class="w-0 px-2 py-2">
						<span class="sr-only">Row actions</span>
					</th>
				</tr>
			</thead>
			<tbody>
				<template x-for={ "(row, rowIndex) in " + statePath } :key="rowKeyResolver(row)">
					<tr class="border-b border-neutral-50/5">
						for _, column := range componentSettings.Columns {
							<td class="px-2 py-2">
								@multiColumnRepeatableFieldsetCell(column, componentSettings)
							</td>
						}
						<td class="w-0 whitespace-nowrap px-2 py-2">
							<div class="flex items-center justify-end gap-1">
								<span :class={ "rowIndex === 0 ? 'pointer-events-none opacity-30' : ''" }>
									@uiControl.Button(uiControl.ButtonSettings{
										AriaLabel:                 "Move row up",
										IconLeft:                  "ph-arrow-up",
										IsDisabledOneWayStatePath: "rowIndex === 0",
										OnClickFunc:               "moveRow(" + statePath + ", rowIndex, -1)",
										Size:                      uiControl.ButtonSizeXs,
									})
								</span>
								<span :class={ "rowIndex === " + statePath + ".length - 1 ? 'pointer-events-none opacity-30' : ''" }>
									@uiControl.Button(uiControl.ButtonSettings{
										AriaLabel:                 "Move row down",
										IconLeft:                  "ph-arrow-down",
										IsDisabledOneWayStatePath: "rowIndex === " + statePath + ".length - 1",
										OnClickFunc:               "moveRow(" + statePath + ", rowIndex, 1)",
										Size:                      uiControl.ButtonSizeXs,
									})
								</span>
								@uiControl.Button(uiControl.ButtonSettings{
									AriaLabel:   "Duplicate row",
									IconLeft:    "ph-copy",
									OnClickFunc: "duplicateRow(" + statePath + ", rowIndex)",
									Size:        uiControl.ButtonSizeXs,
								})
								@uiControl.Button(uiControl.ButtonSettings{
									AriaLabel:      "Remove row",
									IconLeft:       "ph-trash",
									OnClickFunc:    "removeRow(" + statePath + ", rowIndex)",
									Size:           uiControl.ButtonSizeXs,
									TextColor:      "red-400",
									TextColorHover: "red-300",
								})
							</div>
						</td>
					</tr>
				</template>
				<tr x-show={ statePath + ".length === 0" }>
					<td class="px-2 py-3 text-sm text-neutral-500" colspan={ strconv.Itoa(len(componentSettings.Columns) + 1) }>
						{ emptyStateLabel }
					</td>
				</tr>
			</tbody>
		</table>
		if isBulkEditEnabled {
			<div
				x-show="isBulkEditing"
				style="display: none"
				@input={ "replaceRowsFromBulkText(" + statePath + ", $event.target.value)" }
				@click={ "reconcileRowsFromBulkText(" + statePath + ")" }
			>
				@TextArea(TextAreaSettings{
					Label:           bulkEditTextAreaLabel,
					TwoWayStatePath: "bulkEditText",
					Size:            componentSettings.Size,
					TextCase:        componentSettings.TextCase,
					HintValue:       bulkEditHintValue,
					HintDisplay:     InputHintDisplayDescription,
					IsCode:          true,
				})
			</div>
		}
		<div class="mt-3 flex flex-wrap items-center gap-2">
			<div
				if isBulkEditEnabled {
					x-show="!isBulkEditing"
				}
			>
				@uiControl.Button(uiControl.ButtonSettings{
					BackgroundColor:      componentSettings.AddRowButton.BackgroundColor,
					BackgroundColorHover: componentSettings.AddRowButton.BackgroundColorHover,
					IconLeft:             addRowIcon,
					IconRight:            componentSettings.AddRowButton.IconRight,
					Label:                addRowLabel,
					OnClickFunc:          "appendRow(" + statePath + ")",
					Shape:                componentSettings.AddRowButton.Shape,
					Size:                 uiControl.ButtonSizeSm,
					TextColor:            componentSettings.AddRowButton.TextColor,
					TextColorHover:       componentSettings.AddRowButton.TextColorHover,
				})
			</div>
			if isBulkEditEnabled {
				@uiControl.Button(uiControl.ButtonSettings{
					BackgroundColor:         componentSettings.BulkEditButton.BackgroundColor,
					BackgroundColorHover:    componentSettings.BulkEditButton.BackgroundColorHover,
					IconLeftOneWayStatePath: "bulkEditToggleIconResolver",
					LabelOneWayStatePath:    "bulkEditToggleLabelResolver",
					OnClickFunc:             "toggleBulkEdit(" + statePath + ")",
					Shape:                   componentSettings.BulkEditButton.Shape,
					Size:                    uiControl.ButtonSizeSm,
					TextColor:               componentSettings.BulkEditButton.TextColor,
					TextColorHover:          componentSettings.BulkEditButton.TextColorHover,
				})
			}
		</div>
		if componentSettings.InputName != "" {
			<input type="hidden" name={ componentSettings.InputName } :value={ "JSON.stringify(" + statePath + ")" }/>
		}
	</div>
}
