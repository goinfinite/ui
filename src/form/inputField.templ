package uiForm

import (
	"strconv"
	"strings"

	uiToolset "github.com/goinfinite/ui/src/toolset"
)

const (
	InputTypeColor    string = "color"
	InputTypeDate     string = "date"
	InputTypeEmail    string = "email"
	InputTypeHidden   string = "hidden"
	InputTypeMonth    string = "month"
	InputTypeNumber   string = "number"
	InputTypePassword string = "password"
	InputTypeTel      string = "tel"
	InputTypeText     string = "text"
	InputTypeTime     string = "time"
	InputTypeUrl      string = "url"

	InputFieldSizeXs string = "xs"
	InputFieldSizeSm string = "sm"
	InputFieldSizeMd string = "md"
	InputFieldSizeLg string = "lg"
	InputFieldSizeXl string = "xl"
)

type inputFieldSizeTokens struct {
	AffixPadding   string
	InputPadding   string
	LabelOffset    string
	LeftPadding    string
	LegendBand     string
	LegendTextSize string
	TextSize       string
}

func inputFieldSizeTokensResolver(size string) inputFieldSizeTokens {
	switch size {
	case InputFieldSizeXs:
		return inputFieldSizeTokens{
			AffixPadding:   "p-1",
			LeftPadding:    "pl-1",
			InputPadding:   "p-1 pt-0",
			LabelOffset:    "0.5",
			LegendBand:     "1.15",
			LegendTextSize: "text-[0.625rem]",
			TextSize:       "text-xs",
		}
	case InputFieldSizeSm:
		return inputFieldSizeTokens{
			AffixPadding:   "p-1.5",
			LeftPadding:    "pl-1.5",
			InputPadding:   "p-1.5 pt-0",
			LabelOffset:    "1",
			LegendBand:     "1.15",
			LegendTextSize: "text-[0.625rem]",
			TextSize:       "text-xs",
		}
	case InputFieldSizeLg:
		return inputFieldSizeTokens{
			AffixPadding:   "p-2",
			LeftPadding:    "pl-2",
			InputPadding:   "p-2 pt-0",
			LabelOffset:    "2",
			LegendBand:     "1.65",
			LegendTextSize: "text-sm",
			TextSize:       "text-base",
		}
	case InputFieldSizeXl:
		return inputFieldSizeTokens{
			AffixPadding:   "p-2.5",
			LeftPadding:    "pl-2.5",
			InputPadding:   "p-2.5 pt-0",
			LabelOffset:    "2.5",
			LegendBand:     "1.65",
			LegendTextSize: "text-base",
			TextSize:       "text-lg",
		}
	}
	return inputFieldSizeTokens{
		AffixPadding:   "p-1.5",
		LeftPadding:    "pl-1.5",
		InputPadding:   "p-1.5 pt-0",
		LabelOffset:    "1.5",
		LegendBand:     "1.4",
		LegendTextSize: "text-xs",
		TextSize:       "text-sm",
	}
}

type InputFieldSettings struct {
	InputType            string
	InputName            string
	Label                string
	LabelOneWayStatePath string

	// OptionalFields
	TwoWayStatePath                   string
	Value                             string
	AffixLeftValue                    string
	AffixLeftStatePath                string
	AffixLeftWidthPercent             uint
	AffixRightValue                   string
	AffixRightStatePath               string
	AffixRightWidthPercent            uint
	AffixRightComponent               templ.Component
	IconLeft                          string
	InputId                           string
	InputTypeExpression               string
	InputNumberMin                    string
	InputNumberMax                    string
	InputNumberStep                   string
	IsRequired                        bool
	IsInvalidOneWayStatePath          string
	IsReadOnly                        bool
	TextCase                          string
	HintValue                         string
	HintStatePath                     string
	HintDisplay                       string
	HintDisplayTooltipBackgroundColor string
	HintDisplayTooltipMinWidthClass   string
	HintDisplayTooltipMaxWidthClass   string
	HintDisplayTooltipMinHeightClass  string
	HintDisplayTooltipMaxHeightClass  string
	HintIconStyle                     string
	Size                              string
}

func notchedFieldActionOverlapClassesResolver(legendTextSizeClass string) string {
	switch legendTextSizeClass {
	case "text-[0.625rem]":
		return "-mt-[calc(0.625rem/2-1px)]"
	case "text-sm":
		return "-mt-[calc(0.875rem/2-1px)]"
	case "text-base":
		return "-mt-[calc(1rem/2-1px)]"
	}
	return "-mt-[calc(0.75rem/2-1px)]"
}

templ InputField(componentSettings InputFieldSettings) {
	<!-- InputField -->
	{{ sizeTokens := inputFieldSizeTokensResolver(componentSettings.Size) }}
	{{ textCaseClass := uiToolset.TextCaseClassResolver(componentSettings.TextCase) }}
	{{ labelAccessibleNameExpression := statePathFallbackExpressionBuilder(componentSettings.LabelOneWayStatePath, componentSettings.Label) }}
	{{ legendClasses := "ml-1 select-none px-1 font-bold leading-none text-neutral-50/80 " + sizeTokens.LegendTextSize }}
	if textCaseClass != "" {
		{{ legendClasses += " " + textCaseClass }}
	}
	{{ fieldsetClassEntries := make([]string, 0, 2) }}
	if componentSettings.TwoWayStatePath != "" {
		{{ fieldsetClassEntries = append(fieldsetClassEntries, "'mt-0': !"+componentSettings.TwoWayStatePath) }}
	}
	if componentSettings.IsInvalidOneWayStatePath != "" {
		{{ fieldsetClassEntries = append(fieldsetClassEntries, "'!border-red-500': "+componentSettings.IsInvalidOneWayStatePath) }}
	}
	{{ actionOverlapExpression := "" }}
	if componentSettings.Label != "" || componentSettings.LabelOneWayStatePath != "" ||
		componentSettings.IsRequired {
		{{ actionOverlapExpression = strconv.Quote(notchedFieldActionOverlapClassesResolver(sizeTokens.LegendTextSize)) }}
		if componentSettings.TwoWayStatePath != "" {
			{{ actionOverlapExpression = componentSettings.TwoWayStatePath + " && " + actionOverlapExpression }}
		}
	}
	{{ hasHintTooltip := shouldRenderInputHintTooltip(componentSettings.HintDisplay, componentSettings.HintValue, componentSettings.HintStatePath) }}
	<div class="flex w-full flex-col">
		<fieldset
			class={ "bg-neutral-50/7.5 relative -mt-" + sizeTokens.LabelOffset + " w-full min-w-0 rounded border border-neutral-50/5 transition-colors autofill:bg-neutral-50/20 focus-within:border-neutral-50/30 hover:border-neutral-50/30" }
			if len(fieldsetClassEntries) > 0 {
				:class={ "{" + strings.Join(fieldsetClassEntries, ", ") + "}" }
			}
		>
			<legend
				class={ legendClasses }
				if componentSettings.TwoWayStatePath != "" {
					:class={ `!` + componentSettings.TwoWayStatePath + ` && 'hidden'` }
				}
			>
				@statePathBoundLabelText(componentSettings.Label, componentSettings.LabelOneWayStatePath)
				if componentSettings.IsRequired {
					<span class="text-red-700">*</span>
				}
			</legend>
			<div class="flex items-center">
				if componentSettings.AffixLeftValue != "" || componentSettings.AffixLeftStatePath != "" {
					<!-- LeftAffix -->
					{{ leftAffixClasses := "shrink-0 truncate rounded-l border-r border-neutral-50/5 bg-neutral-50/5 text-neutral-400 " + sizeTokens.AffixPadding + " " + sizeTokens.TextSize }}
					if componentSettings.AffixLeftWidthPercent == 0 {
						{{ leftAffixClasses += " max-w-[50%]" }}
					}
					<div
						class={ leftAffixClasses }
						if componentSettings.AffixLeftWidthPercent > 0 {
							style={ "width:" + strconv.FormatUint(uint64(componentSettings.AffixLeftWidthPercent), 10) + "%" }
						}
						if componentSettings.TwoWayStatePath != "" {
							:class={ componentSettings.TwoWayStatePath + ` && '-mt-` + sizeTokens.LabelOffset + `'` }
						}
						if componentSettings.AffixLeftStatePath != "" {
							x-text={ componentSettings.AffixLeftStatePath }
						}
					>
						if componentSettings.AffixLeftValue != "" {
							{ componentSettings.AffixLeftValue }
						}
					</div>
				}
				if componentSettings.IconLeft != "" {
					<span
						class="flex shrink-0 self-stretch items-center"
						if actionOverlapExpression != "" {
							:class={ actionOverlapExpression }
						}
					>
						<i class={ "ph-bold text-neutral-400 " + componentSettings.IconLeft + " " + sizeTokens.LeftPadding + " " + sizeTokens.TextSize } aria-hidden="true"></i>
					</span>
				}
				{{ inputClasses := "w-full min-w-0 bg-transparent placeholder:text-neutral-50 placeholder:opacity-80 outline-none focus:outline-none peer " + sizeTokens.InputPadding + " " + sizeTokens.TextSize }}
				if componentSettings.IconLeft != "" {
					{{ inputClasses += " pl-1" }}
				}
				if textCaseClass != "" {
					{{ inputClasses += " placeholder:" + textCaseClass }}
				}
				if componentSettings.IsReadOnly {
					{{ inputClasses += " text-neutral-400 cursor-not-allowed" }}
				} else {
					{{ inputClasses += " text-neutral-100" }}
				}
				<input
					type={ componentSettings.InputType }
					if componentSettings.InputTypeExpression != "" {
						:type={ componentSettings.InputTypeExpression }
					}
					if componentSettings.Label != "" {
						aria-label={ componentSettings.Label }
					}
					if labelAccessibleNameExpression != "" {
						:aria-label={ labelAccessibleNameExpression }
					}
					if componentSettings.IsInvalidOneWayStatePath != "" {
						:aria-invalid={ componentSettings.IsInvalidOneWayStatePath }
					}
					if componentSettings.InputNumberMin != "" {
						min={ componentSettings.InputNumberMin }
					}
					if componentSettings.InputNumberMax != "" {
						max={ componentSettings.InputNumberMax }
					}
					if componentSettings.InputNumberStep != "" {
						step={ componentSettings.InputNumberStep }
					}
					if componentSettings.InputId != "" {
						id={ componentSettings.InputId }
					}
					if componentSettings.InputName != "" {
						name={ componentSettings.InputName }
					}
					if componentSettings.TwoWayStatePath != "" {
						x-model:value={ componentSettings.TwoWayStatePath }
					}
					if componentSettings.Value != "" {
						value={ componentSettings.Value }
					}
					if componentSettings.Label != "" {
						placeholder={ componentSettings.Label }
					}
					if labelAccessibleNameExpression != "" {
						:placeholder={ labelAccessibleNameExpression }
					}
					if componentSettings.IsRequired {
						required
					}
					class={ inputClasses }
					if componentSettings.TwoWayStatePath != "" {
						:class={ `!` + componentSettings.TwoWayStatePath + ` && 'pt-` + sizeTokens.LabelOffset + `'` }
					}
					if componentSettings.IsReadOnly {
						readonly
					}
				/>
				if componentSettings.AffixRightValue != "" || componentSettings.AffixRightStatePath != "" {
					<!-- RightAffix -->
					{{ rightAffixClasses := "shrink-0 truncate rounded-r border-l border-neutral-50/5 bg-neutral-50/5 text-neutral-400 " + sizeTokens.AffixPadding + " " + sizeTokens.TextSize }}
					if componentSettings.AffixRightWidthPercent == 0 {
						{{ rightAffixClasses += " max-w-[50%]" }}
					}
					<div
						class={ rightAffixClasses }
						if componentSettings.AffixRightWidthPercent > 0 {
							style={ "width:" + strconv.FormatUint(uint64(componentSettings.AffixRightWidthPercent), 10) + "%" }
						}
						if componentSettings.TwoWayStatePath != "" {
							:class={ componentSettings.TwoWayStatePath + ` && '-mt-` + sizeTokens.LabelOffset + `'` }
						}
						if componentSettings.AffixRightStatePath != "" {
							x-text={ componentSettings.AffixRightStatePath }
						}
					>
						if componentSettings.AffixRightValue != "" {
							{ componentSettings.AffixRightValue }
						}
					</div>
				}
				if componentSettings.AffixRightComponent != nil || hasHintTooltip {
					<div
						class="flex shrink-0 self-stretch items-center"
						if actionOverlapExpression != "" {
							:class={ actionOverlapExpression }
						}
					>
						if componentSettings.AffixRightComponent != nil {
							@componentSettings.AffixRightComponent
						}
						if hasHintTooltip {
							@InputHintTooltip(InputHintSettings{
								Value:                  componentSettings.HintValue,
								StatePath:              componentSettings.HintStatePath,
								TooltipBackgroundColor: componentSettings.HintDisplayTooltipBackgroundColor,
								TooltipMinWidthClass:   componentSettings.HintDisplayTooltipMinWidthClass,
								TooltipMaxWidthClass:   componentSettings.HintDisplayTooltipMaxWidthClass,
								TooltipMinHeightClass:  componentSettings.HintDisplayTooltipMinHeightClass,
								TooltipMaxHeightClass:  componentSettings.HintDisplayTooltipMaxHeightClass,
								Size:                   InputHintSizeSm,
								IconStyle:              componentSettings.HintIconStyle,
							})
						}
					</div>
				}
			</div>
		</fieldset>
		if shouldRenderInputHintDescription(componentSettings.HintDisplay) {
			@InputHintDescription(InputHintSettings{
				Value:     componentSettings.HintValue,
				StatePath: componentSettings.HintStatePath,
			})
		}
	</div>
}
