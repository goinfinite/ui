package uiForm

import (
	_ "embed"
	"fmt"
	"strconv"
	"strings"
	"sync/atomic"

	uiToolset "github.com/goinfinite/ui/src/toolset"
)

//go:embed selectInputState.js
var selectInputAlpineState string

var selectInputAlpineStateOnce = templ.NewOnceHandle(
	templ.WithComponent(uiToolset.MinifierTemplateJs(&selectInputAlpineState)),
)

var labelValueOptionsScriptIdCounter atomic.Uint64

func generateLabelValueOptionsScriptId() string {
	return fmt.Sprintf("label-value-options-%d", labelValueOptionsScriptIdCounter.Add(1))
}

const (
	SelectInputSizeXs string = "xs"
	SelectInputSizeSm string = "sm"
	SelectInputSizeMd string = "md"
	SelectInputSizeLg string = "lg"
	SelectInputSizeXl string = "xl"
)

type SelectLabelValueOption struct {
	Label     string          `json:"label"`
	LabelHtml templ.Component `json:"-"`
	Value     string          `json:"value"`
}

type SelectInputTriggerStyle struct {
	// OptionalFields
	BackgroundColor string
	BorderColor     string
	BorderRadius    string
	TextColor       string
}

type SelectInputSettings struct {
	InputName string
	Label     string

	// OptionalFields
	LabelOneWayStatePath              string
	FlatOptions                       []string
	LabelValueOptions                 []SelectLabelValueOption
	OptionsOneWayStatePath            string
	TwoWayStatePath                   string
	InputId                           string
	IsInvalidOneWayStatePath          string
	IsMultiSelect                     bool
	OnChangeFunc                      string
	Size                              string
	TextCase                          string
	Trigger                           SelectInputTriggerStyle
	DropdownBackgroundColor           string
	DropdownBorderColor               string
	DropdownBorderRadius              string
	DropdownMinHeightClass            string
	DropdownMaxHeightClass            string
	SelectedIconColor                 string
	MaxVisibleOptions                 uint
	IsDisabledOneWayStatePath         string
	IsRequired                        bool
	ShouldIncludeBlankOption          bool
	HintValue                         string
	HintStatePath                     string
	HintDisplay                       string
	HintDisplayTooltipBackgroundColor string
	HintDisplayTooltipMinWidthClass   string
	HintDisplayTooltipMaxWidthClass   string
	HintDisplayTooltipMinHeightClass  string
	HintDisplayTooltipMaxHeightClass  string
	HintIconStyle                     string
}

func selectInputSizeClassesResolver(size string) (
	legendClasses, triggerClasses, emptyPaddingClass string,
) {
	switch size {
	case SelectInputSizeXs:
		return "text-[0.625rem]", "px-1 text-xs", "pt-0.5"
	case SelectInputSizeSm:
		return "text-[0.625rem]", "px-1.5 text-xs", "pt-1"
	case SelectInputSizeLg:
		return "text-sm", "px-2 text-base", "pt-2"
	case SelectInputSizeXl:
		return "text-base", "px-2.5 text-lg", "pt-2.5"
	}
	return "text-xs", "px-1.5 text-sm", "pt-1.5"
}

func selectInputEmptyStateCheckExpressionBuilder(
	statePath string, isMultiSelect bool,
) string {
	if isMultiSelect {
		return "!(" + statePath + ".length)"
	}
	return "!(" + statePath + ")"
}

templ selectInputOptionCheckboxBox() {
	<span class="flex h-4 w-4 items-center justify-center rounded border-2 border-neutral-50/20 text-transparent transition-colors peer-enabled:peer-hover:border-secondary-500 peer-checked:border-secondary-500 peer-checked:text-secondary-500 peer-focus-visible:ring-2 peer-focus-visible:ring-secondary-500">
		<i class="ph-bold ph-check text-[0.625rem]"></i>
	</span>
}

templ selectInputOptionCheckbox(
	inputIdPrefix, inputName, optionValue, selectedItemsStatePath, onChangeFunc string,
	optionIndex int,
) {
	<span class="relative ml-auto inline-flex h-4 w-4 shrink-0 items-center justify-center">
		<input
			type="checkbox"
			if inputIdPrefix != "" {
				id={ fmt.Sprintf("%s-%d", inputIdPrefix, optionIndex) }
			}
			if inputName != "" {
				name={ inputName }
			}
			value={ optionValue }
			x-model={ selectedItemsStatePath }
			if onChangeFunc != "" {
				@change={ onChangeFunc }
			}
			class="peer absolute inset-0 h-full w-full cursor-pointer opacity-0"
		/>
		@selectInputOptionCheckboxBox()
	</span>
}

func selectInputOptionIconExpressionBuilder(
	selectedValueStatePath, optionValueExpression string,
) string {
	return "String(" + selectedValueStatePath + ") === String(" +
		optionValueExpression + `) ? "ph-check-circle" : "ph-circle"`
}

templ selectInputOptionIcon(selectedIconColor, iconClassExpression string) {
	<i
		class={ "ph-duotone text-lg text-neutral-400 peer-checked:text-" + selectedIconColor + " peer-focus-visible:ring-2 peer-focus-visible:ring-" + selectedIconColor }
		:class={ iconClassExpression }
	></i>
}

templ SelectInput(componentSettings SelectInputSettings) {
	@selectInputAlpineStateOnce.Once()
	{{ selectValueStatePath := "selectedValue" }}
	if componentSettings.IsMultiSelect {
		{{ selectValueStatePath = "selectedItems" }}
	}
	if componentSettings.TwoWayStatePath != "" {
		{{ selectValueStatePath = componentSettings.TwoWayStatePath }}
	}
	{{ selectedCheckExpression := "String(" + selectValueStatePath + ") === $el.value" }}
	{{ onChangeFuncSuffix := "" }}
	if componentSettings.OnChangeFunc != "" {
		{{ onChangeFuncSuffix = "; " + componentSettings.OnChangeFunc }}
	}
	{{ toggleExpression := "toggleDropdown()" }}
	{{ openWithOptionFocusExpression := "openWithOptionFocus()" }}
	{{ isDisabledPath := componentSettings.IsDisabledOneWayStatePath }}
	if isDisabledPath != "" {
		{{ toggleExpression = "!(" + isDisabledPath + ") && toggleDropdown()" }}
		{{ openWithOptionFocusExpression = "!(" + isDisabledPath + ") && openWithOptionFocus()" }}
	}
	{{ legendSizeClasses, triggerSizeClasses, emptyPaddingClass := selectInputSizeClassesResolver(componentSettings.Size) }}
	{{ displayPaddingClass := strings.Replace(emptyPaddingClass, "pt-", "pb-", 1) }}
	{{ textCaseClass := uiToolset.TextCaseClassResolver(componentSettings.TextCase) }}
	{{ triggerStyle := componentSettings.Trigger }}
	{{ triggerBackgroundClass := uiToolset.BackgroundColorClassResolver(triggerStyle.BackgroundColor, "bg-neutral-50/7.5") }}
	{{ triggerBorderClass := uiToolset.BorderColorClassResolver(triggerStyle.BorderColor, "border-neutral-50/5") }}
	{{ triggerBorderRadiusClass := uiToolset.BorderRadiusClassResolver(triggerStyle.BorderRadius, "rounded") }}
	{{ triggerTextColorClass := uiToolset.TextColorClassResolver(triggerStyle.TextColor, "text-neutral-100") }}
	{{ selectedIconColor := componentSettings.SelectedIconColor }}
	{{ labelValueOptionsScriptId := generateLabelValueOptionsScriptId() }}
	{{ emptyStateCheckExpression := "" }}
	if componentSettings.TwoWayStatePath != "" {
		{{ emptyStateCheckExpression = selectInputEmptyStateCheckExpressionBuilder(componentSettings.TwoWayStatePath, componentSettings.IsMultiSelect) }}
	}
	{{ fieldsetClassEntries := make([]string, 0, 2) }}
	{{ legendClassEntries := make([]string, 0, 1) }}
	{{ displayClassEntries := make([]string, 0, 1) }}
	if emptyStateCheckExpression != "" {
		{{ fieldsetClassEntries = append(fieldsetClassEntries, "'mt-0': "+emptyStateCheckExpression) }}
		{{ legendClassEntries = append(legendClassEntries, "'opacity-0 !p-0 w-0 h-0': "+emptyStateCheckExpression) }}
		{{ displayClassEntries = append(displayClassEntries, "'"+emptyPaddingClass+"': "+emptyStateCheckExpression) }}
	}
	{{ actionOverlapExpression := "" }}
	if componentSettings.Label != "" || componentSettings.LabelOneWayStatePath != "" ||
		componentSettings.IsRequired {
		{{ actionOverlapExpression = strconv.Quote(notchedFieldActionOverlapClassesResolver(legendSizeClasses)) }}
		if emptyStateCheckExpression != "" {
			{{ actionOverlapExpression = "!(" + emptyStateCheckExpression + ") && " + actionOverlapExpression }}
		}
	}
	if componentSettings.IsInvalidOneWayStatePath != "" {
		{{ fieldsetClassEntries = append(fieldsetClassEntries, "'!border-red-500': "+componentSettings.IsInvalidOneWayStatePath) }}
	}
	{{ selectedDisplayExpression := selectValueStatePath }}
	if componentSettings.IsMultiSelect {
		{{ selectedDisplayExpression = "selectedItemsDisplayFormatter(" + selectValueStatePath + ")" }}
	}
	if !componentSettings.IsMultiSelect && componentSettings.OptionsOneWayStatePath == "" &&
		len(componentSettings.LabelValueOptions) > 0 {
		{{ selectedDisplayExpression = `JSON.parse(document.getElementById('` + labelValueOptionsScriptId + `').textContent).find(option => option.value == ` + selectValueStatePath + `)?.label` }}
	}
	if componentSettings.OptionsOneWayStatePath != "" {
		{{ selectedDisplayExpression = "dynamicOptionsDisplayResolver(" + componentSettings.OptionsOneWayStatePath + ", " + selectValueStatePath + ")" }}
	}
	{{ selectedDisplayCheckExpression := selectedDisplayExpression + " !== null && " + selectedDisplayExpression + " !== undefined && " + selectedDisplayExpression + " !== ''" }}
	<!-- SelectInput -->
	<div
		x-data={ templ.JSFuncCall("selectInput", labelValueOptionsScriptId) }
		class="relative w-full"
		@click.away="closeDropdown()"
		@keydown.escape.window="closeWithFocusReturn()"
		if isDisabledPath != "" {
			:class={ isDisabledPath + " && 'pointer-events-none opacity-50'" }
		}
	>
		if componentSettings.OptionsOneWayStatePath == "" &&
			len(componentSettings.LabelValueOptions) > 0 {
			@templ.JSONScript(labelValueOptionsScriptId, componentSettings.LabelValueOptions)
		}
		<div class="flex w-full flex-col">
			<fieldset
				class={ triggerBackgroundClass + " relative -mt-1.5 w-full " + triggerBorderRadiusClass + " border " + triggerBorderClass + " transition-colors autofill:bg-neutral-50/20 focus-within:border-neutral-50/30 hover:border-neutral-50/30" }
				if len(fieldsetClassEntries) > 0 {
					:class={ "{" + strings.Join(fieldsetClassEntries, ", ") + "}" }
				}
			>
				<legend
					class={ "ml-1 select-none px-1 font-bold leading-none text-neutral-50/80 " + legendSizeClasses + " " + textCaseClass }
					if len(legendClassEntries) > 0 {
						:class={ "{" + strings.Join(legendClassEntries, ", ") + "}" }
					}
				>
					@statePathBoundLabelText(componentSettings.Label, componentSettings.LabelOneWayStatePath)
					if componentSettings.IsRequired {
						<span class="text-red-700">*</span>
					}
				</legend>
				<!-- SelectField -->
				<div
					x-ref="selectTrigger"
					class={ "group flex w-full cursor-pointer items-center justify-between " + triggerTextColorClass + " " + triggerSizeClasses }
					tabindex="0"
					role="button"
					:aria-expanded="isOpen"
					if componentSettings.IsInvalidOneWayStatePath != "" {
						:aria-invalid={ componentSettings.IsInvalidOneWayStatePath }
					}
					@keydown.enter.prevent={ toggleExpression }
					@keydown.space.prevent={ toggleExpression }
					@keydown.arrow-down.prevent={ openWithOptionFocusExpression }
					if isDisabledPath != "" {
						:aria-disabled={ isDisabledPath }
					}
					@click={ toggleExpression }
				>
					<div
						class={ "w-full overflow-hidden text-ellipsis " + displayPaddingClass }
						if len(displayClassEntries) > 0 {
							:class={ "{" + strings.Join(displayClassEntries, ", ") + "}" }
						}
					>
						<span x-show={ selectedDisplayCheckExpression } x-text={ selectedDisplayExpression }></span>
						<span
							class={ textCaseClass }
							x-show={ "!(" + selectedDisplayCheckExpression + ")" }
						>
							@statePathBoundLabelText(componentSettings.Label, componentSettings.LabelOneWayStatePath)
						</span>
					</div>
					<div
						class="flex shrink-0 self-stretch items-center gap-2.5 text-neutral-100/60"
						if actionOverlapExpression != "" {
							:class={ actionOverlapExpression }
						}
					>
						<!-- SelectDropdownIcon -->
						<i class="ph-bold ph-caret-down pt-0.5 text-sm transition-transform hover:text-neutral-300 group-focus-within:text-neutral-300 group-hover:text-neutral-300" :class="isOpen ? 'rotate-180' : ''"></i>
						if componentSettings.IsMultiSelect {
							<!-- SelectClearIcon -->
							<i
								x-show={ selectValueStatePath + ".length > 0" }
								@click.stop.prevent={ selectValueStatePath + " = []" + onChangeFuncSuffix }
								class="ph-bold ph-x-circle text-lg hover:text-neutral-300"
							></i>
						}
						if !componentSettings.IsMultiSelect && componentSettings.ShouldIncludeBlankOption {
							<!-- SelectClearIcon -->
							<i
								x-show={ selectValueStatePath + " !== ''" }
								@click.stop.prevent={ selectValueStatePath + " = ''; closeDropdown()" + onChangeFuncSuffix }
								class="ph-bold ph-x-circle text-lg hover:text-neutral-300"
							></i>
						}
						if shouldRenderInputHintTooltip(componentSettings.HintDisplay, componentSettings.HintValue, componentSettings.HintStatePath) {
							@InputHintTooltip(InputHintSettings{
								Value:                  componentSettings.HintValue,
								StatePath:              componentSettings.HintStatePath,
								TooltipBackgroundColor: componentSettings.HintDisplayTooltipBackgroundColor,
								TooltipMinWidthClass:   componentSettings.HintDisplayTooltipMinWidthClass,
								TooltipMaxWidthClass:   componentSettings.HintDisplayTooltipMaxWidthClass,
								TooltipMinHeightClass:  componentSettings.HintDisplayTooltipMinHeightClass,
								TooltipMaxHeightClass:  componentSettings.HintDisplayTooltipMaxHeightClass,
								Size:                   InputHintSizeLg,
								IconStyle:              componentSettings.HintIconStyle,
							})
						}
					</div>
				</div>
				<!-- SelectDropdown -->
				{{ dropdownSurfaceClasses := selectDropdownSurfaceClassesResolver(componentSettings.DropdownBackgroundColor, componentSettings.DropdownBorderColor, componentSettings.DropdownBorderRadius, componentSettings.DropdownMinHeightClass, componentSettings.DropdownMaxHeightClass) }}
				{{ dropdownMaxVisibleOptionsStyle := selectDropdownMaxVisibleOptionsStyle(componentSettings.MaxVisibleOptions, selectInputOptionRowHeightRem) }}
				<ul
					x-ref="selectDropdown"
					class={ dropdownSurfaceClasses }
					if dropdownMaxVisibleOptionsStyle != "" {
						style={ dropdownMaxVisibleOptionsStyle }
					}
					:class={ "openUpward ? 'bottom-full mb-1' : 'mt-1'" }
					x-show="isOpen"
					@keydown.arrow-down.prevent="focusAdjacentOption(1)"
					@keydown.arrow-up.prevent="focusAdjacentOption(-1)"
					if !componentSettings.IsMultiSelect {
						@click="closeWithFocusReturn()"
						@keydown.enter.prevent="commitFocusedOption()"
					}
					x-transition
				>
					{{ dropdownClasses := "transition-colors hover:bg-neutral-50/5 border-neutral-50/5 border-t first:border-t-0" }}
					{{ dropdownSelectedClasses := "" }}
					if !componentSettings.IsMultiSelect {
						{{ dropdownSelectedClasses = "has-checked:bg-neutral-50/10 has-checked:border-y has-checked:!border-neutral-50/10" }}
					}
					{{ optionLabelClasses := "flex w-full cursor-pointer items-center px-3 py-2" }}
					if componentSettings.IsMultiSelect {
						{{ optionLabelClasses += " gap-2" }}
					}
					if selectedIconColor != "" {
						{{ optionLabelClasses += " gap-2" }}
					}
					if componentSettings.ShouldIncludeBlankOption && !componentSettings.IsMultiSelect {
						<li class={ dropdownClasses + " " + dropdownSelectedClasses }>
							<label class={ optionLabelClasses }>
								<input
									type="radio"
									name={ componentSettings.InputName }
									value=""
									:checked={ selectedCheckExpression }
									@change={ selectValueStatePath + " = $event.target.value" + onChangeFuncSuffix }
									if isDisabledPath != "" {
										:disabled={ isDisabledPath }
									}
									@click.stop
									class="sr-only peer"
								/>
								if selectedIconColor != "" {
									@selectInputOptionIcon(selectedIconColor, selectInputOptionIconExpressionBuilder(selectValueStatePath, strconv.Quote("")))
								}
								<span>--</span>
							</label>
						</li>
					}
					if componentSettings.OptionsOneWayStatePath != "" {
						{{ dynamicOptionValueExpression := "dynamicOption?.value ?? dynamicOption" }}
						{{ dynamicOptionLabelExpression := "dynamicOption?.label ?? dynamicOption?.value ?? dynamicOption" }}
						{{ dynamicSelectedCheckExpression := "String(" + selectValueStatePath + ") === String(" + dynamicOptionValueExpression + ")" }}
						{{ dynamicOptionIconExpression := selectInputOptionIconExpressionBuilder(selectValueStatePath, dynamicOptionValueExpression) }}
						<template
							x-for={ "(dynamicOption, optionIndex) in " + componentSettings.OptionsOneWayStatePath }
							:key={ "String(dynamicOption?.value ?? dynamicOption) + '-' + optionIndex" }
						>
							<li class={ dropdownClasses + " " + dropdownSelectedClasses }>
								<label class={ optionLabelClasses }>
									if componentSettings.IsMultiSelect {
										<span x-text={ dynamicOptionLabelExpression }></span>
										<span class="relative ml-auto inline-flex h-4 w-4 shrink-0 items-center justify-center">
											<input
												type="checkbox"
												if componentSettings.InputId != "" {
													:id={ strconv.Quote(componentSettings.InputId+"-") + " + optionIndex" }
												}
												if componentSettings.InputName != "" {
													name={ componentSettings.InputName }
												}
												:value={ dynamicOptionValueExpression }
												x-model={ selectValueStatePath }
												if componentSettings.OnChangeFunc != "" {
													@change={ componentSettings.OnChangeFunc }
												}
												class="peer absolute inset-0 h-full w-full cursor-pointer opacity-0"
											/>
											@selectInputOptionCheckboxBox()
										</span>
									}
									if !componentSettings.IsMultiSelect {
										<input
											type="radio"
											name={ componentSettings.InputName }
											:value={ dynamicOptionValueExpression }
											:checked={ dynamicSelectedCheckExpression }
											@change={ selectValueStatePath + " = " + dynamicOptionValueExpression + onChangeFuncSuffix }
											if isDisabledPath != "" {
												:disabled={ isDisabledPath }
											}
											@click.stop
											class="sr-only peer"
										/>
										if selectedIconColor != "" {
											@selectInputOptionIcon(selectedIconColor, dynamicOptionIconExpression)
										}
										<span x-text={ dynamicOptionLabelExpression }></span>
									}
								</label>
							</li>
						</template>
					}
					if componentSettings.OptionsOneWayStatePath == "" {
						for optionIndex, option := range componentSettings.FlatOptions {
							<li class={ dropdownClasses + " " + dropdownSelectedClasses }>
								<label class={ optionLabelClasses }>
									if componentSettings.IsMultiSelect {
										<span>{ option }</span>
										@selectInputOptionCheckbox(
											componentSettings.InputId,
											componentSettings.InputName, option,
											selectValueStatePath,
											componentSettings.OnChangeFunc,
											optionIndex,
										)
									}
									if !componentSettings.IsMultiSelect {
										<input
											type="radio"
											name={ componentSettings.InputName }
											value={ option }
											:checked={ selectedCheckExpression }
											@change={ selectValueStatePath + " = $event.target.value" + onChangeFuncSuffix }
											if isDisabledPath != "" {
												:disabled={ isDisabledPath }
											}
											@click.stop
											class="sr-only peer"
										/>
										if selectedIconColor != "" {
											@selectInputOptionIcon(selectedIconColor, selectInputOptionIconExpressionBuilder(selectValueStatePath, strconv.Quote(option)))
										}
										<span>{ option }</span>
									}
								</label>
							</li>
						}
						for optionIndex, option := range componentSettings.LabelValueOptions {
							<li class={ dropdownClasses + " " + dropdownSelectedClasses }>
								<label class={ optionLabelClasses }>
									if componentSettings.IsMultiSelect {
										if option.LabelHtml != nil {
											@option.LabelHtml
										}
										if option.LabelHtml == nil {
											<span>{ option.Label }</span>
										}
										@selectInputOptionCheckbox(
											componentSettings.InputId,
											componentSettings.InputName, option.Value,
											selectValueStatePath,
											componentSettings.OnChangeFunc,
											optionIndex+len(componentSettings.FlatOptions),
										)
									}
									if !componentSettings.IsMultiSelect {
										<input
											type="radio"
											name={ componentSettings.InputName }
											value={ option.Value }
											:checked={ selectedCheckExpression }
											@change={ selectValueStatePath + " = $event.target.value" + onChangeFuncSuffix }
											if isDisabledPath != "" {
												:disabled={ isDisabledPath }
											}
											@click.stop
											class="sr-only peer"
										/>
										if selectedIconColor != "" {
											@selectInputOptionIcon(selectedIconColor, selectInputOptionIconExpressionBuilder(selectValueStatePath, strconv.Quote(option.Value)))
										}
										if option.LabelHtml != nil {
											@option.LabelHtml
										}
										if option.LabelHtml == nil {
											<span>{ option.Label }</span>
										}
									}
								</label>
							</li>
						}
					}
				</ul>
			</fieldset>
			if shouldRenderInputHintDescription(componentSettings.HintDisplay) {
				@InputHintDescription(InputHintSettings{
					Value:     componentSettings.HintValue,
					StatePath: componentSettings.HintStatePath,
				})
			}
		</div>
	</div>
}
