package uiForm

type RemoteSearchableSelectInputSettings struct {
	InputName  string
	Label      string
	OptionsUrl string

	// OptionalFields
	OptionsQueryParam                 string
	MinQueryLength                    uint
	DebounceMs                        uint
	TwoWayStatePath                   string
	InputId                           string
	IsMultiSelect                     bool
	OnChangeFunc                      string
	Size                              string
	TextCase                          string
	DropdownBackgroundColor           string
	DropdownMaxHeightClass            string
	IsDisabledOneWayStatePath         string
	HintValue                         string
	HintStatePath                     string
	HintDisplay                       string
	HintDisplayTooltipBackgroundColor string
	HintDisplayTooltipMinWidthClass   string
	HintDisplayTooltipMaxWidthClass   string
	HintDisplayTooltipMinHeightClass  string
	HintDisplayTooltipMaxHeightClass  string
	HintIconStyle                     string
}

func remoteSearchableSelectInputRemoteConfigResolver(
	optionsUrl, optionsQueryParam string, minQueryLength, debounceMs uint,
) *searchableSelectInputRemoteConfig {
	remoteConfig := &searchableSelectInputRemoteConfig{
		Url:            optionsUrl,
		QueryParam:     "q",
		MinQueryLength: 3,
		DebounceMs:     300,
	}
	if optionsQueryParam != "" {
		remoteConfig.QueryParam = optionsQueryParam
	}
	if minQueryLength > 0 {
		remoteConfig.MinQueryLength = minQueryLength
	}
	if debounceMs > 0 {
		remoteConfig.DebounceMs = debounceMs
	}
	return remoteConfig
}

templ RemoteSearchableSelectInput(componentSettings RemoteSearchableSelectInputSettings) {
	<!-- RemoteSearchableSelectInput -->
	{{ onChangeSuffix := "" }}
	if componentSettings.OnChangeFunc != "" {
		{{ onChangeSuffix = "; " + componentSettings.OnChangeFunc }}
	}
	{{ remoteConfig := remoteSearchableSelectInputRemoteConfigResolver(componentSettings.OptionsUrl, componentSettings.OptionsQueryParam, componentSettings.MinQueryLength, componentSettings.DebounceMs) }}
	{{ clientConfig := searchableSelectInputClientConfigResolver(componentSettings.IsMultiSelect, nil, nil, remoteConfig) }}
	{{ initExpression := "" }}
	if !componentSettings.IsMultiSelect {
		{{ initExpression = "$watch('" + componentSettings.TwoWayStatePath + "', (value) => { userInput = optionLabelResolver(value) }); userInput = optionLabelResolver(" + componentSettings.TwoWayStatePath + " ?? '')" }}
	}
	{{ shellSettings := searchableSelectInputShellSettings{
		Label:                             componentSettings.Label,
		TwoWayStatePath:                   componentSettings.TwoWayStatePath,
		InputId:                           componentSettings.InputId,
		ClientConfig:                      clientConfig,
		Size:                              componentSettings.Size,
		TextCase:                          componentSettings.TextCase,
		DropdownBackgroundColor:           componentSettings.DropdownBackgroundColor,
		DropdownMaxHeightClass:            componentSettings.DropdownMaxHeightClass,
		OnChangeSuffix:                    onChangeSuffix,
		InitExpression:                    initExpression,
		IsDisabledOneWayStatePath:         componentSettings.IsDisabledOneWayStatePath,
		HintValue:                         componentSettings.HintValue,
		HintStatePath:                     componentSettings.HintStatePath,
		HintDisplay:                       componentSettings.HintDisplay,
		HintDisplayTooltipBackgroundColor: componentSettings.HintDisplayTooltipBackgroundColor,
		HintDisplayTooltipMinWidthClass:   componentSettings.HintDisplayTooltipMinWidthClass,
		HintDisplayTooltipMaxWidthClass:   componentSettings.HintDisplayTooltipMaxWidthClass,
		HintDisplayTooltipMinHeightClass:  componentSettings.HintDisplayTooltipMinHeightClass,
		HintDisplayTooltipMaxHeightClass:  componentSettings.HintDisplayTooltipMaxHeightClass,
		HintIconStyle:                     componentSettings.HintIconStyle,
	} }}
	@searchableSelectInputShell(shellSettings) {
		@searchableSelectInputTriggerRow(shellSettings) {
			if componentSettings.IsMultiSelect {
				@searchableSelectInputSelectedLabels(shellSettings)
			}
			@searchableSelectInputFilterInput(shellSettings, "", "")
			@searchableSelectInputTriggerEndIcons(shellSettings)
		}
		@searchableSelectInputDropdown(shellSettings) {
			<li x-show="isLoading" class="flex items-center gap-2 px-3 py-2 text-sm text-neutral-400">
				<i class="ph-bold ph-spinner animate-spin"></i>
				Loading...
			</li>
			<li x-show="hasError" class="px-3 py-2 text-sm text-red-400">Could not load options.</li>
			<li
				x-show="shouldPromptMinQueryLength"
				class="px-3 py-2 text-sm text-neutral-400"
				x-text="minQueryLengthPromptResolver"
			></li>
			<template x-for="option in remoteOptions" :key="option.value">
				@searchableSelectInputOptionRow(
					shellSettings,
					"", "option.value", "option.label", "", nil,
				)
			</template>
			<li x-show="hasNoMatches" class="px-3 py-2 text-sm text-neutral-400">No matches</li>
		}
		@searchableSelectInputHiddenInputs(
			componentSettings.InputName,
			componentSettings.TwoWayStatePath,
			componentSettings.IsMultiSelect,
		)
	}
}
