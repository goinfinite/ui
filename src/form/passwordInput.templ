package uiForm

import (
	_ "embed"
	"fmt"
	"sync/atomic"

	uiToolset "github.com/goinfinite/ui/src/toolset"
)

//go:embed passwordInputState.js
var passwordInputAlpineState string

var passwordInputAlpineStateOnce = templ.NewOnceHandle(
	templ.WithComponent(uiToolset.MinifierTemplateJs(&passwordInputAlpineState)),
)

var passwordInputRulesScriptIdCounter atomic.Uint64

func generatePasswordInputRulesScriptId() string {
	return fmt.Sprintf(
		"password-input-rules-%d", passwordInputRulesScriptIdCounter.Add(1),
	)
}

type PasswordInputRules struct {
	MinLength                   uint
	MaxLength                   uint
	GenerationLength            uint
	ShouldIncludeLowercaseChars bool
	ShouldIncludeUppercaseChars bool
	ShouldIncludeNumbers        bool
	ShouldIncludeSpecialChars   bool
}

type passwordInputRulesConfig struct {
	MinLength           uint `json:"minLength"`
	MaxLength           uint `json:"maxLength"`
	Length              uint `json:"length"`
	IncludeLowercase    bool `json:"includeLowercase"`
	IncludeUppercase    bool `json:"includeUppercase"`
	IncludeNumbers      bool `json:"includeNumbers"`
	IncludeSpecialChars bool `json:"includeSpecialChars"`
}

type passwordStrengthCriteriaItem struct {
	StateKey string
	Label    string
}

func passwordInputRulesResolver(rules PasswordInputRules) passwordInputRulesConfig {
	config := passwordInputRulesConfig{
		MinLength:           rules.MinLength,
		MaxLength:           rules.MaxLength,
		Length:              rules.GenerationLength,
		IncludeLowercase:    rules.ShouldIncludeLowercaseChars,
		IncludeUppercase:    rules.ShouldIncludeUppercaseChars,
		IncludeNumbers:      rules.ShouldIncludeNumbers,
		IncludeSpecialChars: rules.ShouldIncludeSpecialChars,
	}
	if config.MinLength == 0 {
		config.MinLength = 6
	}
	if config.MaxLength == 0 {
		config.MaxLength = 64
	}
	if config.MaxLength < config.MinLength {
		config.MaxLength = config.MinLength
	}
	if config.Length == 0 {
		config.Length = 16
	}
	if !config.IncludeLowercase && !config.IncludeUppercase &&
		!config.IncludeNumbers && !config.IncludeSpecialChars {
		config.IncludeLowercase = true
		config.IncludeUppercase = true
		config.IncludeNumbers = true
		config.IncludeSpecialChars = true
	}
	return config
}

func passwordStrengthCriteriaItemsResolver(
	config passwordInputRulesConfig,
) []passwordStrengthCriteriaItem {
	criteriaItems := []passwordStrengthCriteriaItem{
		{
			StateKey: "isLongEnough",
			Label: fmt.Sprintf(
				"Between %d and %d characters", config.MinLength, config.MaxLength,
			),
		},
	}
	if config.IncludeNumbers {
		criteriaItems = append(criteriaItems, passwordStrengthCriteriaItem{
			StateKey: "hasNumbers",
			Label:    "At least 1 number",
		})
	}
	if config.IncludeUppercase {
		criteriaItems = append(criteriaItems, passwordStrengthCriteriaItem{
			StateKey: "hasUppercaseChars",
			Label:    "At least 1 uppercase letter",
		})
	}
	if config.IncludeLowercase {
		criteriaItems = append(criteriaItems, passwordStrengthCriteriaItem{
			StateKey: "hasLowercaseChars",
			Label:    "At least 1 lowercase letter",
		})
	}
	if config.IncludeSpecialChars {
		criteriaItems = append(criteriaItems, passwordStrengthCriteriaItem{
			StateKey: "hasSpecialChars",
			Label:    "At least 1 special character",
		})
	}
	return criteriaItems
}

type PasswordInputSettings struct {
	InputName       string
	Label           string
	TwoWayStatePath string

	// OptionalFields
	Rules                             PasswordInputRules
	Value                             string
	Size                              string
	TextCase                          string
	IsRequired                        bool
	IsReadOnly                        bool
	ShouldShowGenerateButton          bool
	ShouldShowStrengthMeter           bool
	HintValue                         string
	HintStatePath                     string
	HintDisplay                       string
	HintDisplayTooltipBackgroundColor string
	HintDisplayTooltipMinWidthClass   string
	HintDisplayTooltipMaxWidthClass   string
	HintDisplayTooltipMinHeightClass  string
	HintDisplayTooltipMaxHeightClass  string
	HintIconStyle                     string
}

templ passwordInputActions(shouldShowGenerateButton bool, passwordStatePath string) {
	<div class="flex shrink-0 items-center gap-1 pr-1 text-neutral-400">
		<button
			type="button"
			class="cursor-pointer rounded bg-transparent p-1 text-lg transition-colors hover:bg-neutral-50/5 hover:text-neutral-100"
			:aria-label="isPasswordVisible ? 'Hide password' : 'Show password'"
			@click="isPasswordVisible = !isPasswordVisible"
		>
			<i class="ph-bold ph-eye" x-show="!isPasswordVisible"></i>
			<i class="ph-bold ph-eye-slash" x-show="isPasswordVisible"></i>
		</button>
		if shouldShowGenerateButton {
			<button
				type="button"
				class="cursor-pointer rounded bg-transparent p-1 text-lg transition-colors hover:bg-neutral-50/5 hover:text-neutral-100"
				aria-label="Generate random password"
				@click={ passwordStatePath + " = generateRandomPassword()" }
			>
				<i class="ph-bold ph-binary"></i>
			</button>
		}
	</div>
}

templ PasswordInput(componentSettings PasswordInputSettings) {
	<!-- PasswordInput -->
	@passwordInputAlpineStateOnce.Once()
	{{ rulesConfig := passwordInputRulesResolver(componentSettings.Rules) }}
	{{ criteriaItems := passwordStrengthCriteriaItemsResolver(rulesConfig) }}
	{{ rulesScriptId := generatePasswordInputRulesScriptId() }}
	@templ.JSONScript(rulesScriptId, rulesConfig)
	{{ shouldShowStrengthCriteria := "(" + componentSettings.TwoWayStatePath + " ?? '').length > 0" }}
	<div
		class="flex w-full flex-col gap-2"
		x-data={ templ.JSFuncCall("passwordInput", rulesScriptId) }
		x-effect={ "updatePasswordStrength(" + componentSettings.TwoWayStatePath + ")" }
	>
		@InputField(InputFieldSettings{
			InputType:           InputTypePassword,
			InputTypeExpression: "isPasswordVisible ? 'text' : 'password'",
			InputName:           componentSettings.InputName,
			Label:               componentSettings.Label,
			TwoWayStatePath:     componentSettings.TwoWayStatePath,
			Value:               componentSettings.Value,
			IsRequired:          componentSettings.IsRequired,
			IsReadOnly:          componentSettings.IsReadOnly,
			Size:                componentSettings.Size,
			TextCase:            componentSettings.TextCase,
			AffixRightComponent: passwordInputActions(
				componentSettings.ShouldShowGenerateButton,
				componentSettings.TwoWayStatePath,
			),
			HintValue:                         componentSettings.HintValue,
			HintStatePath:                     componentSettings.HintStatePath,
			HintDisplay:                       componentSettings.HintDisplay,
			HintDisplayTooltipBackgroundColor: componentSettings.HintDisplayTooltipBackgroundColor,
			HintDisplayTooltipMinWidthClass:   componentSettings.HintDisplayTooltipMinWidthClass,
			HintDisplayTooltipMaxWidthClass:   componentSettings.HintDisplayTooltipMaxWidthClass,
			HintDisplayTooltipMinHeightClass:  componentSettings.HintDisplayTooltipMinHeightClass,
			HintDisplayTooltipMaxHeightClass:  componentSettings.HintDisplayTooltipMaxHeightClass,
			HintIconStyle:                     componentSettings.HintIconStyle,
		})
		if componentSettings.ShouldShowStrengthMeter {
			<!-- PasswordInputStrengthMeter -->
			<div class="flex flex-col gap-1.5">
				<div class="h-1.5 w-full overflow-hidden rounded-full bg-neutral-50/10">
					<div
						class="h-full rounded-full bg-secondary-500 transition-all duration-200"
						:style={ "'width: ' + passwordStrengthPercentage + '%'" }
					></div>
				</div>
				<ul class="grid grid-cols-1 gap-x-4 gap-y-0.5 text-xs text-neutral-400 sm:grid-cols-2" x-show={ shouldShowStrengthCriteria }>
					for _, criteriaItem := range criteriaItems {
						<li class="flex items-center gap-1">
							<i
								class="ph-bold ph-check text-green-500"
								x-show={ "passwordStrengthCriteria." + criteriaItem.StateKey }
							></i>
							<i
								class="ph-bold ph-x text-red-500"
								x-show={ "!passwordStrengthCriteria." + criteriaItem.StateKey }
							></i>
							{ criteriaItem.Label }
						</li>
					}
				</ul>
			</div>
		}
	</div>
}
