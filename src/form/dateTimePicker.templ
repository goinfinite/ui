package uiForm

import (
	_ "embed"
	"encoding/json"
	"log/slog"
	"strconv"
	"strings"

	uiControl "github.com/goinfinite/ui/src/control"
	uiToolset "github.com/goinfinite/ui/src/toolset"
)

//go:embed dateTimePickerState.js
var dateTimePickerAlpineState string

var dateTimePickerAlpineStateOnce = templ.NewOnceHandle(
	templ.WithComponent(uiToolset.MinifierTemplateJs(&dateTimePickerAlpineState)),
)

const (
	DateTimePickerModeDate     string = "date"
	DateTimePickerModeDateTime string = "datetime"
	DateTimePickerModeTime     string = "time"
)

type DateTimePickerTimeSelectorStyle struct {
	// OptionalFields
	BackgroundColor         string
	BorderColor             string
	BorderRadius            string
	DropdownBackgroundColor string
	DropdownBorderColor     string
	DropdownBorderRadius    string
	TextColor               string
}

type DateTimePickerDoneButtonStyle struct {
	// OptionalFields
	BackgroundColor      string
	BackgroundColorHover string
	IconSizeClass        string
	RingColor            string
	RingColorHover       string
	RingThickness        string
	Shape                string
	TextColor            string
	TextColorHover       string
	TextSizeClass        string
}

type DateTimePickerStyle struct {
	// OptionalFields
	CalendarBackgroundColor    string
	CalendarBorderColor        string
	CalendarBorderRadius       string
	CalendarButtonIconColor    string
	DayDisabledTextColor       string
	DayHoverBackgroundColor    string
	DayMutedTextColor          string
	DayRangeBackgroundColor    string
	DayRangeTextColor          string
	DaySelectedBackgroundColor string
	DaySelectedTextColor       string
	DayTextColor               string
	DayTodayRingColor          string
	FieldBackgroundColor       string
	FieldBorderColor           string
	FieldBorderRadius          string
	PlaceholderColor           string
	RangeDividerColor          string
	RangeLabelTextColor        string
	TextColor                  string
}

type DateTimePickerSettings struct {
	Label                string
	LabelOneWayStatePath string

	// OptionalFields
	CalendarButtonStyle               string
	DoneButtonIconLeft                string
	DoneButtonIconRight               string
	DoneButtonLabel                   string
	DoneButtonSize                    string
	DoneButtonStyle                   DateTimePickerDoneButtonStyle
	FirstDayOfWeek                    string
	HintDisplay                       string
	HintDisplayTooltipBackgroundColor string
	HintDisplayTooltipMaxHeightClass  string
	HintDisplayTooltipMaxWidthClass   string
	HintDisplayTooltipMinHeightClass  string
	HintDisplayTooltipMinWidthClass   string
	HintIconStyle                     string
	HintStatePath                     string
	HintValue                         string
	InputId                           string
	InputName                         string
	IsRange                           bool
	Locale                            string
	MaxValue                          string
	MinValue                          string
	Mode                              string
	RangeEndInputName                 string
	RangeEndLabel                     string
	RangeEndTwoWayStatePath           string
	RangeEndValue                     string
	RangeStartLabel                   string
	Size                              string
	Style                             DateTimePickerStyle
	TextCase                          string
	TimeSelector                      DateTimePickerTimeSelectorStyle
	TimeSelectorSize                  string
	Timezone                          string
	TimezoneInputName                 string
	TimezoneOptions                   []string
	TimezoneTwoWayStatePath           string
	TwoWayStatePath                   string
	Value                             string
}

type dateTimePickerStyleConfig struct {
	DayDisabledTextColor       string `json:"dayDisabledTextColor"`
	DayHoverBackgroundColor    string `json:"dayHoverBackgroundColor"`
	DayMutedTextColor          string `json:"dayMutedTextColor"`
	DayRangeBackgroundColor    string `json:"dayRangeBackgroundColor"`
	DayRangeTextColor          string `json:"dayRangeTextColor"`
	DaySelectedBackgroundColor string `json:"daySelectedBackgroundColor"`
	DaySelectedTextColor       string `json:"daySelectedTextColor"`
	DayTextColor               string `json:"dayTextColor"`
	DayTodayRingColor          string `json:"dayTodayRingColor"`
}

type dateTimePickerConfig struct {
	Mode           string                    `json:"mode"`
	Locale         string                    `json:"locale"`
	MinValue       string                    `json:"minValue"`
	MaxValue       string                    `json:"maxValue"`
	FirstDayOfWeek string                    `json:"firstDayOfWeek"`
	IsRange        bool                      `json:"isRange"`
	Timezone       string                    `json:"timezone"`
	Style          dateTimePickerStyleConfig `json:"style"`
}

func dateTimePickerTextDefaulter(text, defaultText string) string {
	if text == "" {
		return defaultText
	}
	return text
}

func dateTimePickerModeResolver(componentSettings DateTimePickerSettings) string {
	switch componentSettings.Mode {
	case DateTimePickerModeDate, DateTimePickerModeDateTime, DateTimePickerModeTime:
		return componentSettings.Mode
	}
	return DateTimePickerModeDate
}

func dateTimePickerLocaleResolver(componentSettings DateTimePickerSettings) string {
	if componentSettings.Locale != "" {
		return componentSettings.Locale
	}
	return "en-US"
}

func dateTimePickerRangeEndInputNameResolver(componentSettings DateTimePickerSettings) string {
	if componentSettings.RangeEndInputName != "" {
		return componentSettings.RangeEndInputName
	}
	return componentSettings.InputName + "-end"
}

func dateTimePickerInputPlaceholderResolver(mode string) string {
	switch mode {
	case DateTimePickerModeTime:
		return "HH:MM"
	case DateTimePickerModeDateTime:
		return "yyyy-mm-ddTHH:MM"
	}
	return "yyyy-mm-dd"
}

func dateTimePickerStyleConfigResolver(
	componentStyle DateTimePickerStyle,
) dateTimePickerStyleConfig {
	return dateTimePickerStyleConfig{
		DayDisabledTextColor: dateTimePickerTextDefaulter(
			componentStyle.DayDisabledTextColor, "neutral-600",
		),
		DayHoverBackgroundColor: dateTimePickerTextDefaulter(
			componentStyle.DayHoverBackgroundColor, "neutral-50/10",
		),
		DayMutedTextColor: dateTimePickerTextDefaulter(
			componentStyle.DayMutedTextColor, "neutral-500",
		),
		DayRangeBackgroundColor: dateTimePickerTextDefaulter(
			componentStyle.DayRangeBackgroundColor, "secondary-500/20",
		),
		DayRangeTextColor: dateTimePickerTextDefaulter(
			componentStyle.DayRangeTextColor, "neutral-50",
		),
		DaySelectedBackgroundColor: dateTimePickerTextDefaulter(
			componentStyle.DaySelectedBackgroundColor, "secondary-500",
		),
		DaySelectedTextColor: dateTimePickerTextDefaulter(
			componentStyle.DaySelectedTextColor, "neutral-950",
		),
		DayTextColor: dateTimePickerTextDefaulter(
			componentStyle.DayTextColor, "neutral-100",
		),
		DayTodayRingColor: dateTimePickerTextDefaulter(
			componentStyle.DayTodayRingColor, "neutral-50/30",
		),
	}
}

func dateTimePickerConfigJsonBuilder(componentSettings DateTimePickerSettings) string {
	config := dateTimePickerConfig{
		Mode:           dateTimePickerModeResolver(componentSettings),
		Locale:         dateTimePickerLocaleResolver(componentSettings),
		MinValue:       componentSettings.MinValue,
		MaxValue:       componentSettings.MaxValue,
		FirstDayOfWeek: componentSettings.FirstDayOfWeek,
		IsRange:        componentSettings.IsRange,
		Timezone:       componentSettings.Timezone,
		Style:          dateTimePickerStyleConfigResolver(componentSettings.Style),
	}
	encodedConfig, marshalErr := json.Marshal(config)
	if marshalErr != nil {
		slog.Debug(
			"DateTimePickerConfigMarshalFailure",
			slog.String("err", marshalErr.Error()),
		)
		return "{}"
	}
	return string(encodedConfig)
}

func dateTimePickerDataExpressionBuilder(
	componentSettings DateTimePickerSettings, pickerConfigJson string,
) string {
	startExpression := strconv.Quote(componentSettings.Value)
	if componentSettings.TwoWayStatePath != "" {
		startExpression = componentSettings.TwoWayStatePath
	}
	endExpression := strconv.Quote(componentSettings.RangeEndValue)
	if componentSettings.RangeEndTwoWayStatePath != "" {
		endExpression = componentSettings.RangeEndTwoWayStatePath
	}
	timezoneExpression := strconv.Quote(componentSettings.Timezone)
	if componentSettings.TimezoneTwoWayStatePath != "" {
		timezoneExpression = componentSettings.TimezoneTwoWayStatePath
	}
	return "dateTimePicker(" + pickerConfigJson + ", " + startExpression + ", " + endExpression + ", " + timezoneExpression + ")"
}

func dateTimePickerWritebackExpressionBuilder(componentSettings DateTimePickerSettings) string {
	writebackAssignments := []string{}
	if componentSettings.TwoWayStatePath != "" {
		writebackAssignments = append(
			writebackAssignments, componentSettings.TwoWayStatePath+" = startDraft",
		)
	}
	if componentSettings.RangeEndTwoWayStatePath != "" {
		writebackAssignments = append(
			writebackAssignments, componentSettings.RangeEndTwoWayStatePath+" = endDraft",
		)
	}
	if componentSettings.TimezoneTwoWayStatePath != "" {
		writebackAssignments = append(
			writebackAssignments, componentSettings.TimezoneTwoWayStatePath+" = timezone",
		)
	}
	if len(writebackAssignments) == 0 {
		return ""
	}
	return "initialized && (" + strings.Join(writebackAssignments, ", ") + ")"
}

func dateTimePickerPopoverClassesResolver(componentStyle DateTimePickerStyle) string {
	dropdownSurfaceClasses := selectDropdownSurfaceClassesResolver(
		componentStyle.CalendarBackgroundColor,
		componentStyle.CalendarBorderColor,
		componentStyle.CalendarBorderRadius,
		"", "max-h-none",
	)
	return strings.Replace(
		dropdownSurfaceClasses, "overflow-auto", "overflow-visible", 1,
	) + " top-full mt-1 p-3"
}

func dateTimePickerDoneButtonSizeResolver(size string) string {
	switch size {
	case uiControl.ButtonSizeXs, uiControl.ButtonSizeSm,
		uiControl.ButtonSizeMd, uiControl.ButtonSizeLg,
		uiControl.ButtonSizeXl:
		return size
	}
	return uiControl.ButtonSizeXs
}

func dateTimePickerTimeSelectorSizeResolver(size string) string {
	switch size {
	case SelectInputSizeXs, SelectInputSizeSm, SelectInputSizeMd,
		SelectInputSizeLg, SelectInputSizeXl:
		return size
	}
	return SelectInputSizeMd
}

func dateTimePickerCalendarButtonSettingsResolver(
	componentSettings DateTimePickerSettings,
) uiControl.ButtonSettings {
	buttonSettings := inputActionButtonSettingsResolver(
		componentSettings.Size, componentSettings.CalendarButtonStyle,
		"Toggle date picker", "ph-calendar-blank", "togglePopover()",
		"toggle the calendar",
	)
	buttonSettings.AriaExpandedOneWayStatePath = "isOpen"
	if componentSettings.Style.CalendarButtonIconColor != "" {
		buttonSettings.TextColor = componentSettings.Style.CalendarButtonIconColor
		buttonSettings.TextColorHover = componentSettings.Style.CalendarButtonIconColor
	}
	return buttonSettings
}

func dateTimePickerDoneButtonTextCaseResolver(textCase string) string {
	if textCase == "" {
		return uiToolset.TextCaseLower
	}
	return textCase
}

func dateTimePickerDoneButtonIconSizeClassResolver(size string) string {
	switch size {
	case uiControl.ButtonSizeXs:
		return "text-xs"
	case uiControl.ButtonSizeSm:
		return "text-sm"
	case uiControl.ButtonSizeMd:
		return "text-base"
	case uiControl.ButtonSizeLg:
		return "text-lg"
	case uiControl.ButtonSizeXl:
		return "text-xl"
	}
	return "text-xs"
}

func dateTimePickerDoneButtonSettingsResolver(
	componentSettings DateTimePickerSettings,
) uiControl.ButtonSettings {
	doneStyle := componentSettings.DoneButtonStyle
	resolvedSize := dateTimePickerDoneButtonSizeResolver(componentSettings.DoneButtonSize)
	return uiControl.ButtonSettings{
		Label:                dateTimePickerTextDefaulter(componentSettings.DoneButtonLabel, "Done"),
		IconLeft:             dateTimePickerTextDefaulter(componentSettings.DoneButtonIconLeft, "ph-check"),
		IconRight:            componentSettings.DoneButtonIconRight,
		IconSizeClass:        dateTimePickerTextDefaulter(doneStyle.IconSizeClass, dateTimePickerDoneButtonIconSizeClassResolver(resolvedSize)),
		TextSizeClass:        doneStyle.TextSizeClass,
		OnClickFunc:          "closePopover()",
		Size:                 resolvedSize,
		TextCase:             dateTimePickerDoneButtonTextCaseResolver(componentSettings.TextCase),
		BackgroundColor:      doneStyle.BackgroundColor,
		BackgroundColorHover: doneStyle.BackgroundColorHover,
		RingColor:            doneStyle.RingColor,
		RingColorHover:       doneStyle.RingColorHover,
		RingThickness:        doneStyle.RingThickness,
		Shape:                doneStyle.Shape,
		TextColor:            doneStyle.TextColor,
		TextColorHover:       doneStyle.TextColorHover,
	}
}

templ dateTimePickerTimeSelects(componentSettings DateTimePickerSettings, resolvedMode string) {
	{{ timeSelectorStyle := componentSettings.TimeSelector }}
	{{
		triggerStyle := SelectInputTriggerStyle{
			BackgroundColor: timeSelectorStyle.BackgroundColor,
			BorderColor:     timeSelectorStyle.BorderColor,
			BorderRadius:    timeSelectorStyle.BorderRadius,
			TextColor:       timeSelectorStyle.TextColor,
		}
	}}
	{{ timeSelectorSize := dateTimePickerTimeSelectorSizeResolver(componentSettings.TimeSelectorSize) }}
	<div class="mt-3 flex flex-wrap items-end justify-center gap-2 border-t border-neutral-50/5 pt-3">
		<div class="w-20">
			@SelectInput(SelectInputSettings{
				FlatOptions:             dateTimePickerHourOptions,
				Label:                   "Hour",
				OnChangeFunc:            "commitTime()",
				Size:                    timeSelectorSize,
				TextCase:                componentSettings.TextCase,
				Trigger:                 triggerStyle,
				TwoWayStatePath:         "timeHour",
				DropdownBackgroundColor: timeSelectorStyle.DropdownBackgroundColor,
				DropdownBorderColor:     timeSelectorStyle.DropdownBorderColor,
				DropdownBorderRadius:    timeSelectorStyle.DropdownBorderRadius,
				DropdownMaxHeightClass:  "max-h-40",
			})
		</div>
		<span class="pb-1.5 text-sm font-bold text-neutral-400" aria-hidden="true">:</span>
		<div class="w-20">
			@SelectInput(SelectInputSettings{
				FlatOptions:             dateTimePickerMinuteOptions,
				Label:                   "Minute",
				OnChangeFunc:            "commitTime()",
				Size:                    timeSelectorSize,
				TextCase:                componentSettings.TextCase,
				Trigger:                 triggerStyle,
				TwoWayStatePath:         "timeMinute",
				DropdownBackgroundColor: timeSelectorStyle.DropdownBackgroundColor,
				DropdownBorderColor:     timeSelectorStyle.DropdownBorderColor,
				DropdownBorderRadius:    timeSelectorStyle.DropdownBorderRadius,
				DropdownMaxHeightClass:  "max-h-40",
			})
		</div>
		if componentSettings.Timezone != "" && resolvedMode == DateTimePickerModeDateTime {
			<div class="max-w-64 grow shrink-0 basis-40">
				@SelectInput(SelectInputSettings{
					LabelValueOptions:       dateTimePickerTimezoneOptionsResolver(componentSettings.Timezone, componentSettings.TimezoneOptions),
					Label:                   "Timezone",
					OnChangeFunc:            "commitTimezone()",
					Size:                    timeSelectorSize,
					TextCase:                componentSettings.TextCase,
					Trigger:                 triggerStyle,
					TwoWayStatePath:         "timezone",
					DropdownBackgroundColor: timeSelectorStyle.DropdownBackgroundColor,
					DropdownBorderColor:     timeSelectorStyle.DropdownBorderColor,
					DropdownBorderRadius:    timeSelectorStyle.DropdownBorderRadius,
					DropdownMaxHeightClass:  "max-h-40",
				})
			</div>
		}
	</div>
}

templ dateTimePickerCalendarNavigationButton(iconClass, ariaLabel, clickExpression string) {
	@uiControl.Button(uiControl.ButtonSettings{
		AriaLabel:   ariaLabel,
		IconLeft:    iconClass,
		OnClickFunc: clickExpression,
		Size:        uiControl.ButtonSizeXs,
	})
}

templ dateTimePickerCalendar() {
	<div class="flex items-center justify-between">
		<div class="flex items-center gap-0.5">
			@dateTimePickerCalendarNavigationButton("ph-caret-double-left", "Previous year", "shiftYear(-1)")
			@dateTimePickerCalendarNavigationButton("ph-caret-left", "Previous month", "shiftMonth(-1)")
		</div>
		<span class="text-sm font-bold text-neutral-50" x-text="monthYearLabel"></span>
		<div class="flex items-center gap-0.5">
			@dateTimePickerCalendarNavigationButton("ph-caret-right", "Next month", "shiftMonth(1)")
			@dateTimePickerCalendarNavigationButton("ph-caret-double-right", "Next year", "shiftYear(1)")
		</div>
	</div>
	<div
		class="mt-2 grid grid-cols-7 gap-y-0.5"
		@keydown.arrow-left.prevent={ "focusDayOffset($event, -1)" }
		@keydown.arrow-right.prevent={ "focusDayOffset($event, 1)" }
		@keydown.arrow-up.prevent={ "focusDayOffset($event, -7)" }
		@keydown.arrow-down.prevent={ "focusDayOffset($event, 7)" }
		@keydown.home.prevent={ "focusDayEdge($event, 'start')" }
		@keydown.end.prevent={ "focusDayEdge($event, 'end')" }
	>
		<template x-for="weekdayLabel in weekdayLabels" :key="weekdayLabel">
			<span
				class="flex h-8 w-full items-center justify-center text-[0.625rem] font-bold uppercase text-neutral-500"
				x-text="weekdayLabel"
			></span>
		</template>
		<template x-for="(day, dayIndex) in calendarDays" :key="day.iso">
			<button
				type="button"
				:data-day-index="dayIndex"
				:class="dayClassesBuilder(day)"
				:disabled="day.isDisabled"
				:aria-label="dayAriaLabelFormatter(day)"
				:aria-current="day.isSelected ? 'date' : false"
				@click="selectDay(day)"
			>
				<span :class="dayNumberClassesBuilder(day)" x-text="day.dayNumber"></span>
			</button>
		</template>
	</div>
}

func (componentSettings DateTimePickerSettings) rangeAriaLabelExpressionBuilder(
	sideLabel, staticAriaLabel string,
) string {
	if componentSettings.LabelOneWayStatePath == "" {
		return ""
	}
	return "(" + componentSettings.LabelOneWayStatePath + " ? (" +
		componentSettings.LabelOneWayStatePath + ") + \" " + sideLabel + "\" : " +
		strconv.Quote(staticAriaLabel) + ")"
}

templ dateTimePickerRangeSide(
	side, ariaLabel, ariaLabelExpression, caption, placeholder, inputClasses, captionClasses, sidePaddingClasses string,
) {
	<div
		class={ "flex min-w-0 flex-1 flex-col gap-0.5 " + sidePaddingClasses }
		:class={ "isRange && activeEnd !== '" + side + "' && 'opacity-60'" }
	>
		<span class={ "text-[0.625rem] font-bold leading-none " + captionClasses }>
			{ caption }
		</span>
		<input
			type="text"
			x-model={ side + "TypedValue" }
			@click={ "activateEnd('" + side + "')" }
			@focus={ "activateEnd('" + side + "')" }
			@change={ "commitTypedValueForSide('" + side + "')" }
			@keydown.enter.prevent={ "commitTypedValueForSide('" + side + "')" }
			placeholder={ placeholder }
			autocomplete="off"
			aria-label={ ariaLabel }
			if ariaLabelExpression != "" {
				:aria-label={ ariaLabelExpression }
			}
			class={ inputClasses }
		/>
	</div>
}

templ DateTimePicker(componentSettings DateTimePickerSettings) {
	<!-- DateTimePicker -->
	@dateTimePickerAlpineStateOnce.Once()
	{{ resolvedMode := dateTimePickerModeResolver(componentSettings) }}
	{{ pickerConfigJson := dateTimePickerConfigJsonBuilder(componentSettings) }}
	{{ sizeTokens := inputFieldSizeTokensResolver(componentSettings.Size) }}
	{{ inputPlaceholder := dateTimePickerInputPlaceholderResolver(resolvedMode) }}
	{{ dataExpression := dateTimePickerDataExpressionBuilder(componentSettings, pickerConfigJson) }}
	{{ writebackExpression := dateTimePickerWritebackExpressionBuilder(componentSettings) }}
	{{ popoverClasses := dateTimePickerPopoverClassesResolver(componentSettings.Style) }}
	{{ fieldBackgroundClass := uiToolset.BackgroundColorClassResolver(componentSettings.Style.FieldBackgroundColor, "bg-neutral-50/7.5") }}
	{{ fieldBorderClass := uiToolset.BorderColorClassResolver(componentSettings.Style.FieldBorderColor, "border-neutral-50/5") }}
	{{ fieldRadiusClass := uiToolset.BorderRadiusClassResolver(componentSettings.Style.FieldBorderRadius, "rounded") }}
	{{ textColorClass := uiToolset.TextColorClassResolver(componentSettings.Style.TextColor, "text-neutral-100") }}
	{{ placeholderColorClass := "placeholder:" + uiToolset.TextColorClassResolver(componentSettings.Style.PlaceholderColor, "text-neutral-50/60") }}
	{{ textCaseClass := uiToolset.TextCaseClassResolver(componentSettings.TextCase) }}
	{{ labelAccessibleNameExpression := statePathFallbackExpressionBuilder(componentSettings.LabelOneWayStatePath, componentSettings.Label) }}
	{{ inputClasses := "w-full min-w-0 flex-1 bg-transparent outline-none focus:outline-none " + sizeTokens.InputPadding + " " + textColorClass + " " + placeholderColorClass }}
	{{ rangeInputClasses := "w-full min-w-0 flex-1 bg-transparent outline-none focus:outline-none " + textColorClass + " " + placeholderColorClass }}
	if textCaseClass != "" {
		{{ inputClasses += " " + textCaseClass + " placeholder:" + textCaseClass }}
		{{ rangeInputClasses += " " + textCaseClass + " placeholder:" + textCaseClass }}
	}
	{{ emptyInputPaddingClass := "pt-" + sizeTokens.LabelOffset }}
	{{ legendClasses := "ml-1 select-none px-1 font-bold leading-none text-neutral-50/80 " + sizeTokens.LegendTextSize }}
	if textCaseClass != "" {
		{{ legendClasses += " " + textCaseClass }}
	}
	{{ rangeDividerClass := uiToolset.BackgroundColorClassResolver(componentSettings.Style.RangeDividerColor, "bg-neutral-50/10") }}
	{{ rangeLabelClass := uiToolset.TextColorClassResolver(componentSettings.Style.RangeLabelTextColor, "text-neutral-500") }}
	if textCaseClass != "" {
		{{ rangeLabelClass += " " + textCaseClass }}
	}
	{{ rangeStartLabel := dateTimePickerTextDefaulter(componentSettings.RangeStartLabel, "Start") }}
	{{ rangeEndLabel := dateTimePickerTextDefaulter(componentSettings.RangeEndLabel, "End") }}
	{{ rowRightPaddingClass := strings.Replace(sizeTokens.LeftPadding, "pl-", "pr-", 1) }}
	{{ inputRowClasses := "flex w-full items-center gap-1 " + rowRightPaddingClass + " " + textColorClass + " " + sizeTokens.TextSize }}
	{{ legendOverlapClasses := notchedFieldActionOverlapClassesResolver(sizeTokens.LegendTextSize) }}
	{{ rangeSidePaddingClasses := "px-2 pt-1 " + strings.Replace(sizeTokens.AffixPadding, "p-", "pb-", 1) }}
	{{ calendarButtonSettings := dateTimePickerCalendarButtonSettingsResolver(componentSettings) }}
	{{ doneButtonSettings := dateTimePickerDoneButtonSettingsResolver(componentSettings) }}
	{{ rangeStartAriaLabel := "Start" }}
	{{ rangeEndAriaLabel := "End" }}
	if componentSettings.Label != "" {
		{{ rangeStartAriaLabel = componentSettings.Label + " start" }}
		{{ rangeEndAriaLabel = componentSettings.Label + " end" }}
	}
	{{ rangeStartAriaLabelExpression := componentSettings.rangeAriaLabelExpressionBuilder("start", rangeStartAriaLabel) }}
	{{ rangeEndAriaLabelExpression := componentSettings.rangeAriaLabelExpressionBuilder("end", rangeEndAriaLabel) }}
	<div
		class="relative w-full"
		x-data={ templ.JSExpression(dataExpression) }
		if writebackExpression != "" {
			x-effect={ writebackExpression }
		}
		@click.outside="closePopover()"
		@keydown.escape.window="closePopover()"
	>
		<div class="flex w-full flex-col">
			<fieldset
				class={ fieldBackgroundClass + " relative -mt-" + sizeTokens.LabelOffset + " w-full min-w-0 " + fieldRadiusClass + " border " + fieldBorderClass + " transition-colors autofill:bg-neutral-50/20 focus-within:border-neutral-50/30 hover:border-neutral-50/30" }
				:class="!hasValue && 'mt-0'"
			>
				<legend
					class={ legendClasses }
					:class="!hasValue && 'opacity-0 !p-0 w-0 h-0'"
				>
					@statePathBoundLabelText(componentSettings.Label, componentSettings.LabelOneWayStatePath)
				</legend>
				<div class={ inputRowClasses }>
					if componentSettings.IsRange {
						<div class="flex min-w-0 flex-1 items-stretch">
							@dateTimePickerRangeSide("start", rangeStartAriaLabel, rangeStartAriaLabelExpression, rangeStartLabel, inputPlaceholder, rangeInputClasses, rangeLabelClass, rangeSidePaddingClasses)
							<span class={ "my-1.5 w-px shrink-0 " + rangeDividerClass } aria-hidden="true"></span>
							@dateTimePickerRangeSide("end", rangeEndAriaLabel, rangeEndAriaLabelExpression, rangeEndLabel, inputPlaceholder, rangeInputClasses, rangeLabelClass, rangeSidePaddingClasses)
						</div>
					} else {
						<input
							type="text"
							if componentSettings.InputId != "" {
								id={ componentSettings.InputId }
							}
							x-model="startTypedValue"
							@click="openPopover()"
							@focus="$event.target.select()"
							@change="commitTypedValueForSide('start')"
							@keydown.enter.prevent="commitTypedValueForSide('start')"
							placeholder={ inputPlaceholder }
							autocomplete="off"
							aria-label={ componentSettings.Label }
							if labelAccessibleNameExpression != "" {
								:aria-label={ labelAccessibleNameExpression }
							}
							class={ inputClasses }
							:class={ "!hasValue && '" + emptyInputPaddingClass + "'" }
						/>
					}
					<div
						class="flex self-stretch items-center gap-1"
						:class={ "hasValue && '" + legendOverlapClasses + "'" }
					>
						@uiControl.Button(calendarButtonSettings)
						if shouldRenderInputHintTooltip(componentSettings.HintDisplay, componentSettings.HintValue, componentSettings.HintStatePath) {
							<span class="flex items-center">
								@InputHintTooltip(InputHintSettings{
									Value:                  componentSettings.HintValue,
									StatePath:              componentSettings.HintStatePath,
									TooltipBackgroundColor: componentSettings.HintDisplayTooltipBackgroundColor,
									TooltipMinWidthClass:   componentSettings.HintDisplayTooltipMinWidthClass,
									TooltipMaxWidthClass:   componentSettings.HintDisplayTooltipMaxWidthClass,
									TooltipMinHeightClass:  componentSettings.HintDisplayTooltipMinHeightClass,
									TooltipMaxHeightClass:  componentSettings.HintDisplayTooltipMaxHeightClass,
									Size:                   InputHintSizeSm,
									IconStyle:              componentSettings.HintIconStyle,
								})
							</span>
						}
					</div>
				</div>
			</fieldset>
			if shouldRenderInputHintDescription(componentSettings.HintDisplay) {
				@InputHintDescription(InputHintSettings{
					Value:     componentSettings.HintValue,
					StatePath: componentSettings.HintStatePath,
				})
			}
			<div x-show="isOpen" class={ popoverClasses }>
				if resolvedMode != DateTimePickerModeTime {
					@dateTimePickerCalendar()
				}
				if resolvedMode != DateTimePickerModeDate {
					@dateTimePickerTimeSelects(componentSettings, resolvedMode)
				}
				<div class="mt-2 flex justify-end border-t border-neutral-50/5 pt-2">
					@uiControl.Button(doneButtonSettings)
				</div>
			</div>
			if componentSettings.Timezone != "" && componentSettings.TimezoneInputName != "" {
				<input
					type="hidden"
					name={ componentSettings.TimezoneInputName }
					:value="timezone"
				/>
			}
			if componentSettings.InputName != "" {
				<input
					type="hidden"
					name={ componentSettings.InputName }
					:value="startDraft"
				/>
			}
			if componentSettings.IsRange && componentSettings.InputName != "" {
				<input
					type="hidden"
					name={ dateTimePickerRangeEndInputNameResolver(componentSettings) }
					:value="endDraft"
				/>
			}
		</div>
	</div>
}
