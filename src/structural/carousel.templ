package uiStructural

import (
	_ "embed"
	"strconv"
	"strings"

	uiForm "github.com/goinfinite/ui/src/form"
	uiToolset "github.com/goinfinite/ui/src/toolset"
)

//go:embed carouselState.js
var carouselAlpineState string

var carouselAlpineStateOnce = templ.NewOnceHandle(
	templ.WithComponent(uiToolset.MinifierTemplateJs(&carouselAlpineState)),
)

templ CarouselDefaultEmptyState() {
	No items found.
}

templ CarouselDefaultSearchBox() {
	@uiForm.InputField(uiForm.InputFieldSettings{
		InputType:       uiForm.InputTypeText,
		InputName:       "search",
		Label:           "Search",
		TwoWayStatePath: "searchQuery",
	})
}

templ carouselDots(dotsHeightClass string, dotClassesExpression string, dotCurrentExpression string) {
	<div class="flex items-center justify-center gap-1.5" x-show="hasMultipleWindows()">
		<template x-for="dotIndex in dotIndexes" :key="dotIndex">
			<button
				type="button"
				class={ "cursor-pointer rounded-full border-0 p-0 transition-all " + dotsHeightClass }
				:class={ dotClassesExpression }
				:aria-label="'Go to item ' + (dotIndex + 1)"
				:aria-current={ dotCurrentExpression }
				@click="goToWindow(dotIndex)"
			></button>
		</template>
	</div>
}

templ carouselArrowButton(
	ariaLabel string, arrowClasses string, positionClasses string,
	disabledExpression string, clickExpression string, icon string,
) {
	<button
		type="button"
		aria-label={ ariaLabel }
		class={ "border-0 transition-all disabled:pointer-events-none disabled:opacity-30 " + arrowClasses + " " + positionClasses }
		x-show="hasMultipleWindows()"
		:disabled={ disabledExpression }
		@click={ clickExpression }
	>
		<i class={ "ph-bold " + icon }></i>
	</button>
}

templ carouselSearchBoxBar(searchBoxComponent templ.Component, searchBoxJustifyClass, separatorClass string) {
	<div class={ "flex flex-wrap items-center gap-2 border-neutral-50/10 p-2 " + separatorClass }>
		<div class={ "flex flex-1 flex-wrap items-center gap-2 " + searchBoxJustifyClass }>
			<div class="w-72" @input="resetPageAndRefresh()">
				@searchBoxComponent
			</div>
		</div>
		<i class="ph-bold ph-circle-notch animate-spin text-lg text-neutral-400" x-show="isLoading"></i>
	</div>
}

templ Carousel[Item any](componentSettings CarouselSettings[Item]) {
	@refreshRequestAlpineStateOnce.Once()
	@carouselAlpineStateOnce.Once()
	{{ carouselId := componentSettings.idResolver() }}
	{{ settingsScriptId := carouselId + "-settings" }}
	{{ paginationId := carouselId + "-pagination" }}
	{{ surfaceClasses := componentSettings.surfaceClassesResolver() }}
	{{ stagePaddingClasses := uiToolset.PaddingClassResolver(componentSettings.PaddingSize, "p-5") }}
	{{ trackGapClasses := uiToolset.GapClassResolver(componentSettings.GapSize, "gap-3") }}
	{{ isArrowsInside := componentSettings.ArrowsPosition == CarouselArrowsPositionInside }}
	{{ arrowsClasses := carouselArrowsClassesResolver(componentSettings.ArrowsPosition, componentSettings.ArrowsShape, componentSettings.ArrowsSize, componentSettings.ArrowsBackgroundColor, componentSettings.ArrowsIconColor) }}
	{{ dotsHeightClass, dotsInactiveClass, dotsActiveClass := carouselDotsSizeClassesResolver(componentSettings.DotsSize) }}
	{{ dotActiveClasses := dotsActiveClass + " " + uiToolset.BackgroundColorClassResolver(componentSettings.dotsActiveColorResolver(), "") }}
	{{ dotInactiveClasses := dotsInactiveClass + " " + uiToolset.BackgroundColorClassResolver(componentSettings.dotsInactiveColorResolver(), "") }}
	{{ dotClassesExpression := "dotIndex === windowStart ? " + strconv.Quote(dotActiveClasses) + " : " + strconv.Quote(dotInactiveClasses) }}
	{{ dotCurrentExpression := "dotIndex === windowStart ? 'true' : 'false'" }}
	{{ areDotsOnTop := componentSettings.DotsPosition == CarouselDotsPositionTop }}
	{{ itemClasses := carouselItemClassesResolver(componentSettings.ItemBackgroundColor, componentSettings.ItemBorderRadius, componentSettings.ItemPaddingSize, componentSettings.ItemRingColor, componentSettings.ItemRingThickness, componentSettings.ItemShadowSize) }}
	{{ searchBoxJustifyClass := componentSettings.searchBoxAlignmentResolver().justifyClassResolver() }}
	{{ isSearchBoxOnTop := componentSettings.searchBoxPositionResolver() == CarouselSearchBoxPositionTop }}
	{{ searchBoxComponent := componentSettings.SearchBox }}
	if searchBoxComponent == nil && strings.Contains(componentSettings.QueryUrlTemplate, CarouselUrlPlaceholderSearch) {
		{{ searchBoxComponent = CarouselDefaultSearchBox() }}
	}
	{{ itemsPerPageSizeChoices := itemsPerPageSizeChoicesResolver(componentSettings.ItemsPerPageSizeChoices) }}
	{{ itemsPerPage := itemsPerPageResolver(componentSettings.ItemsPerPage, itemsPerPageSizeChoices) }}
	{{ pageNumber := componentSettings.PageNumber }}
	<div
		class={ surfaceClasses }
		x-data={ templ.JSFuncCall("carousel", settingsScriptId) }
		hx-sync="this:replace"
		if componentSettings.Id != "" {
			id={ componentSettings.Id }
		}
	>
		@templ.JSONScript(settingsScriptId, componentSettings.clientSettingsResolver(itemsPerPage, pageNumber))
		if searchBoxComponent != nil && isSearchBoxOnTop {
			@carouselSearchBoxBar(searchBoxComponent, searchBoxJustifyClass, "border-b")
		}
		<p class="sr-only" aria-live="polite" x-text="liveMessage"></p>
		<div data-ui-carousel>
			<div x-show="!hasRefreshError" class={ "flex flex-col gap-3 " + stagePaddingClasses }>
				if areDotsOnTop {
					@carouselDots(dotsHeightClass, dotClassesExpression, dotCurrentExpression)
				}
				<div
					class="flex items-stretch gap-2"
					@mouseenter="enterPointerRegion()"
					@mouseleave="leavePointerRegion()"
				>
					if !isArrowsInside {
						@carouselArrowButton("Previous items", arrowsClasses, carouselArrowPositionClassesResolver(isArrowsInside, ""), "!canSlidePrevious", "slidePrevious()", "ph-caret-left")
					}
					<div
						class="relative min-w-0 flex-1 select-none overflow-hidden [contain:inline-size] [touch-action:pan-y]"
						x-ref="viewport"
						:class="{ 'pointer-events-none opacity-50': isLoading }"
						@pointerdown="startSwipe($event)"
						@pointerup="finishSwipe($event)"
						@pointercancel="cancelSwipe()"
					>
						if isArrowsInside {
							@carouselArrowButton("Previous items", arrowsClasses, carouselArrowPositionClassesResolver(isArrowsInside, "left-2"), "!canSlidePrevious", "slidePrevious()", "ph-caret-left")
						}
						if len(componentSettings.Items) == 0 {
							{{ emptyStateComponent := componentSettings.EmptyState }}
							if emptyStateComponent == nil {
								{{ emptyStateComponent = CarouselDefaultEmptyState() }}
							}
							<div class="w-full p-8 text-center text-neutral-400">
								@emptyStateComponent
							</div>
						}
						if len(componentSettings.Items) > 0 {
							<div data-ui-carousel-track class={ "flex transition-transform duration-300 ease-out " + trackGapClasses }>
								for _, item := range componentSettings.Items {
									<div class={ "shrink-0 " + itemClasses }>
										@componentSettings.ItemRenderer(item)
									</div>
								}
							</div>
						}
						if isArrowsInside {
							@carouselArrowButton("Next items", arrowsClasses, carouselArrowPositionClassesResolver(isArrowsInside, "right-2"), "!canSlideNext", "slideNext()", "ph-caret-right")
						}
					</div>
					if !isArrowsInside {
						@carouselArrowButton("Next items", arrowsClasses, carouselArrowPositionClassesResolver(isArrowsInside, ""), "!canSlideNext", "slideNext()", "ph-caret-right")
					}
				</div>
				if !areDotsOnTop {
					@carouselDots(dotsHeightClass, dotClassesExpression, dotCurrentExpression)
				}
			</div>
			<div x-show="hasRefreshError" style="display: none" class="flex flex-col items-center gap-3 p-8 text-center">
				<i class="ph-bold ph-warning-circle text-2xl text-red-400"></i>
				<p class="text-sm text-neutral-400">Could not refresh the carousel.</p>
				<button
					type="button"
					class="rounded bg-neutral-50/7.5 px-3 py-1.5 text-sm font-bold text-neutral-50 transition-all hover:bg-neutral-50/12.5"
					@click="refresh()"
				>
					Retry
				</button>
			</div>
		</div>
		if searchBoxComponent != nil && !isSearchBoxOnTop {
			@carouselSearchBoxBar(searchBoxComponent, searchBoxJustifyClass, "border-t")
		}
		if len(componentSettings.Filters) > 0 {
			<div class="border-t border-neutral-50/10 p-2">
				@FilterBar(FilterBarSettings{
					Filters:                        componentSettings.Filters,
					ValuesTwoWayStatePath:          "filterValues",
					EnumSelectRadioGroupNamePrefix: carouselId + "-",
					OnChangeFunc:                   "resetPageAndRefresh()",
					DropdownBackgroundColor:        componentSettings.FilterDropdownBackgroundColor,
				})
			</div>
		}
		<div data-ui-carousel-pagination class="border-t border-neutral-50/10" id={paginationId} hx-swap-oob={"outerHTML:#" + paginationId}>
			@Pagination(PaginationSettings{
				PageNumberTwoWayStatePath:    "pageNumber",
				ItemsPerPageTwoWayStatePath:  "itemsPerPage",
				ItemsTotal:                   componentSettings.ItemsTotal,
				PagesTotal:                   componentSettings.PagesTotal,
				AriaLabel:                    componentSettings.paginationAriaLabelResolver(),
				IsDisabledOneWayStatePath:    "isLoading",
				IsHiddenWhenSinglePage:       componentSettings.IsPaginationHiddenWhenSinglePage,
				ItemsPerPageInputName:        carouselId + "-itemsPerPage",
				ItemsPerPageSizeChoices:      itemsPerPageSizeChoices,
				OnChangeFunc:                 "requestRefresh()",
				ShouldUseOneBasedPageDisplay: componentSettings.ShouldUseOneBasedPageDisplay,
			})
		</div>
	</div>
}
