package uiStructural

import (
	_ "embed"
	"strconv"

	uiToolset "github.com/goinfinite/ui/src/toolset"
)

//go:embed tabsState.js
var tabsAlpineState string

var tabsAlpineStateOnce = templ.NewOnceHandle(
	templ.WithComponent(uiToolset.MinifierTemplateJs(&tabsAlpineState)),
)

const (
	TabOrientationHorizontal string = "horizontal"
	TabOrientationVertical   string = "vertical"

	TabSideLeft  string = "left"
	TabSideRight string = "right"

	TabAlignmentTop    string = "top"
	TabAlignmentCenter string = "center"
	TabAlignmentBottom string = "bottom"

	TabGapSizeNone string = "none"
	TabGapSizeXs   string = "xs"
	TabGapSizeSm   string = "sm"
	TabGapSizeMd   string = "md"
	TabGapSizeLg   string = "lg"
	TabGapSizeXl   string = "xl"

	TabIconPositionLeft string = "left"
	TabIconPositionTop  string = "top"

	TabPaddingSizeNone string = "none"
	TabPaddingSizeXs   string = "xs"
	TabPaddingSizeSm   string = "sm"
	TabPaddingSizeMd   string = "md"
	TabPaddingSizeLg   string = "lg"
	TabPaddingSizeXl   string = "xl"

	TabRingThicknessXs string = "xs"
	TabRingThicknessSm string = "sm"
	TabRingThicknessMd string = "md"
	TabRingThicknessLg string = "lg"
	TabRingThicknessXl string = "xl"

	TabShadowSizeNone string = "none"
	TabShadowSizeXs   string = "xs"
	TabShadowSizeSm   string = "sm"
	TabShadowSizeMd   string = "md"
	TabShadowSizeLg   string = "lg"
	TabShadowSizeXl   string = "xl"
)

type TabItemSettings struct {
	Label string
	Value string

	// OptionalFields
	BadgeBackgroundColor      string
	BadgeBorderRadius         string
	BadgeCount                uint
	BadgeCountOneWayStatePath string
	BadgeRingColor            string
	BadgeRingThickness        string
	BadgeTextColor            string
	Content                   templ.Component
	Icon                      string
	IconPosition              string
}

type TabSettings struct {
	Items                        []TabItemSettings
	SelectedValueTwoWayStatePath string

	// OptionalFields
	Alignment            string
	AriaLabel            string
	BackgroundColor      string
	BorderRadius         string
	ContentBackgroundColor string
	ContentBorderRadius    string
	ContentPaddingSize     string
	ContentRingColor       string
	ContentRingThickness   string
	ContentShadowSize      string
	ContentTextColor       string
	GapSize                string
	IsUrlHashSynced        bool
	MaxHeightClass         string
	MaxHeightPercent       uint
	MaxWidthClass          string
	MaxWidthPercent        uint
	MaxVisibleTabs         uint
	MinHeightClass         string
	MinHeightPercent       uint
	MinWidthClass          string
	MinWidthPercent        uint
	Orientation            string
	PaddingSize            string
	RingColor              string
	RingThickness          string
	ShadowSize             string
	Side                   string
	TextCase               string
	TextColor              string
}

templ Tabs(componentSettings TabSettings) {
	@tabsAlpineStateOnce.Once()
	{{ selectedValuePath := componentSettings.SelectedValueTwoWayStatePath }}
	{{ orientation := tabOrientationResolver(componentSettings.Orientation) }}
	{{ isVertical := orientation == TabOrientationVertical }}
	{{ isRight := isVertical && tabSideResolver(componentSettings.Side) == TabSideRight }}
	{{ ariaLabel := tabAriaLabelResolver(componentSettings.AriaLabel) }}
	{{ hasVisibleTabsCap := isVertical && componentSettings.MaxVisibleTabs > 0 }}
	{{ visibleTabsArgument := strconv.FormatUint(uint64(componentSettings.MaxVisibleTabs), 10) }}
	{{ textCaseClass := uiToolset.TextCaseClassResolver(componentSettings.TextCase) }}
	{{ idPrefix := tabIdPrefixGenerator.GenerateNext() }}
	{{ previousKeyExpression := tabArrowKeyExpressionBuilder(selectedValuePath, "previous") }}
	{{ nextKeyExpression := tabArrowKeyExpressionBuilder(selectedValuePath, "next") }}
	{{ homeKeyExpression := tabEdgeKeyExpressionBuilder(selectedValuePath, "firstElementChild") }}
	{{ endKeyExpression := tabEdgeKeyExpressionBuilder(selectedValuePath, "lastElementChild") }}
	{{ anySelectedExpression := tabAnySelectedExpressionBuilder(selectedValuePath, componentSettings.Items) }}
	{{ rootClasses := "flex" }}
	if isVertical {
		{{ rootClasses += " w-full" }}
		if isRight {
			{{ rootClasses += " flex-row-reverse" }}
		}
	}
	if !isVertical {
		{{ rootClasses += " flex-col" }}
	}
	{{ verticalTabListBorderClass := "border-r" }}
	if isRight {
		{{ verticalTabListBorderClass = "border-l" }}
	}
	{{ tabListClasses := "flex w-full " + uiToolset.GapClassResolver(componentSettings.GapSize, "gap-1") + " overflow-x-auto border-b border-neutral-50/10" }}
	if isVertical {
		{{ tabListClasses = "flex w-fit flex-col " + uiToolset.GapClassResolver(componentSettings.GapSize, "gap-1") + " overflow-y-auto " + verticalTabListBorderClass + " border-neutral-50/10" }}
		{{ tabListClasses += " " + tabAlignmentClassResolver(componentSettings.Alignment) }}
	}
	{{ constraintClasses := tabConstraintClassesResolver(componentSettings) }}
	if constraintClasses != "" {
		{{ tabListClasses += " " + constraintClasses }}
	}
	if componentSettings.PaddingSize != "" {
		{{ tabListClasses += " " + uiToolset.PaddingClassResolver(componentSettings.PaddingSize, "") }}
	}
	if componentSettings.ShadowSize != "" {
		{{ tabListClasses += " " + uiToolset.ShadowClassResolver(componentSettings.ShadowSize, "") }}
	}
	{{ ringClasses := uiToolset.RingClassResolver(componentSettings.RingColor, componentSettings.RingThickness) }}
	if ringClasses != "" {
		{{ tabListClasses += " " + ringClasses }}
	}
	{{ tabListClasses += " " + uiToolset.BackgroundColorClassResolver(componentSettings.BackgroundColor, "") }}
	{{ tabClasses := "flex cursor-pointer select-none items-center gap-1.5 px-3 py-2 text-sm transition-all" }}
	{{ tabClasses += " " + uiToolset.TextColorClassResolver(componentSettings.TextColor, "text-neutral-50/80") }}
	{{ tabClasses += " bg-neutral-50/5 hover:bg-neutral-50/7.5" }}
	{{ tabClasses += " " + tabEdgeClassResolver(componentSettings.BorderRadius, isVertical, isRight) }}
	{{ tabActiveClasses := "!font-bold !text-secondary-500 !border-secondary-500" }}
	{{ tabPanelsClasses := "pt-4" }}
	if isVertical {
		{{ tabPanelsClasses = "grow" }}
		if isRight {
			{{ tabPanelsClasses += " pr-4" }}
		}
		if !isRight {
			{{ tabPanelsClasses += " pl-4" }}
		}
	}
	if componentSettings.ContentPaddingSize != "" {
		{{ contentPaddingClasses := uiToolset.PaddingClassResolver(componentSettings.ContentPaddingSize, "") }}
		if isVertical {
			{{ tabPanelsClasses = "grow " + contentPaddingClasses }}
		}
		if !isVertical {
			{{ tabPanelsClasses = contentPaddingClasses }}
		}
	}
	{{ tabPanelsClasses += " " + uiToolset.BackgroundColorClassResolver(componentSettings.ContentBackgroundColor, "") }}
	if componentSettings.ContentShadowSize != "" {
		{{ tabPanelsClasses += " " + uiToolset.ShadowClassResolver(componentSettings.ContentShadowSize, "") }}
	}
	{{ contentRingClasses := uiToolset.RingClassResolver(componentSettings.ContentRingColor, componentSettings.ContentRingThickness) }}
	if contentRingClasses != "" {
		{{ tabPanelsClasses += " " + contentRingClasses }}
	}
	if componentSettings.ContentBorderRadius != "" {
		{{ tabPanelsClasses += " rounded-" + uiToolset.BorderRadiusTokenResolver(componentSettings.ContentBorderRadius, uiToolset.BorderRadiusMd) }}
	}
	{{ tabPanelsClasses += " " + uiToolset.TextColorClassResolver(componentSettings.ContentTextColor, "") }}
	<!-- Tabs -->
	<div
		class={ rootClasses }
		if componentSettings.IsUrlHashSynced {
			x-init={ tabUrlHashSyncExpressionBuilder(selectedValuePath, componentSettings.Items) }
			@hashchange.window={ tabUrlHashSyncExpressionBuilder(selectedValuePath, componentSettings.Items) }
		}
	>
		<!-- TabList -->
		<div
			role="tablist"
			aria-label={ ariaLabel }
			data-ui-tabs-list
			class={ tabListClasses }
			if isVertical {
				aria-orientation="vertical"
			}
			if hasVisibleTabsCap {
				x-data={ templ.JSFuncCall("tabs", templ.JSExpression(visibleTabsArgument)) }
				:style="{ maxHeight: tabsViewportMaxHeightPx > 0 ? tabsViewportMaxHeightPx + 'px' : '' }"
			}
		>
			for index, item := range componentSettings.Items {
				{{ selectedExpression := tabSelectedExpressionBuilder(selectedValuePath, item.Value) }}
				{{ tabId := tabIdTextBuilder(idPrefix, index) }}
				{{ panelId := tabPanelIdTextBuilder(idPrefix, index) }}
				{{ badgeClasses := tabBadgeClassesResolver(item) }}
				{{ itemTabClasses := tabClasses }}
				if item.IconPosition == TabIconPositionTop {
					{{ itemTabClasses += " flex-col text-center" }}
				}
				if isVertical {
					{{ itemTabClasses += " w-full" }}
				}
				<button
					type="button"
					role="tab"
					id={ tabId }
					:class={ selectedExpression + " && '" + tabActiveClasses + "'" }
					:aria-selected={ selectedExpression + " ? 'true' : 'false'" }
					:tabindex={ tabTabindexExpressionBuilder(selectedExpression, anySelectedExpression, index == 0) }
					@click={ tabClickExpressionBuilder(selectedValuePath, item.Value, componentSettings.IsUrlHashSynced) }
					if item.Content != nil {
						aria-controls={ panelId }
					}
					data-tab-value={ item.Value }
					class={ itemTabClasses }
					if isVertical {
						@keydown.arrow-up.prevent={ previousKeyExpression }
						@keydown.arrow-down.prevent={ nextKeyExpression }
					}
					if !isVertical {
						@keydown.arrow-left.prevent={ previousKeyExpression }
						@keydown.arrow-right.prevent={ nextKeyExpression }
					}
					@keydown.home.prevent={ homeKeyExpression }
					@keydown.end.prevent={ endKeyExpression }
				>
					if item.Icon != "" {
						<i class={ "ph-duotone " + item.Icon + " text-lg" } aria-hidden="true"></i>
					}
					<span class={ textCaseClass }>{ item.Label }</span>
					if item.BadgeCountOneWayStatePath != "" {
						<span
							class={ badgeClasses }
							x-show={ item.BadgeCountOneWayStatePath + " > 0" }
							x-text={ item.BadgeCountOneWayStatePath }
						></span>
					}
					if item.BadgeCountOneWayStatePath == "" && item.BadgeCount > 0 {
						<span class={ badgeClasses }>{ item.BadgeCount }</span>
					}
				</button>
			}
		</div>
		<!-- TabPanels -->
		<div class={ tabPanelsClasses }>
			for index, item := range componentSettings.Items {
				if item.Content != nil {
					{{ selectedExpression := tabSelectedExpressionBuilder(selectedValuePath, item.Value) }}
					{{ tabId := tabIdTextBuilder(idPrefix, index) }}
					{{ panelId := tabPanelIdTextBuilder(idPrefix, index) }}
					<div
						role="tabpanel"
						id={ panelId }
						aria-labelledby={ tabId }
						tabindex="0"
						x-show={ selectedExpression }
					>
						@item.Content
					</div>
				}
			}
		</div>
	</div>
}
