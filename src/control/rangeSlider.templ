package uiControl

import (
	"strconv"

	uiToolset "github.com/goinfinite/ui/src/toolset"
)

const (
	RangeSliderSizeXs string = "xs"
	RangeSliderSizeSm string = "sm"
	RangeSliderSizeMd string = "md"
	RangeSliderSizeLg string = "lg"
	RangeSliderSizeXl string = "xl"

	RangeSliderThumbShapePipe string = "pipe"

	RangeSliderThumbValueBubblePositionTop    string = "top"
	RangeSliderThumbValueBubblePositionBottom string = "bottom"

	RangeSliderThumbValueBubbleDisplayModeAlways string = "always"
	RangeSliderThumbValueBubbleDisplayModeHover  string = "hover"

	RangeSliderThumbValueBubbleSizeXs string = "xs"
	RangeSliderThumbValueBubbleSizeSm string = "sm"
	RangeSliderThumbValueBubbleSizeMd string = "md"
	RangeSliderThumbValueBubbleSizeLg string = "lg"
	RangeSliderThumbValueBubbleSizeXl string = "xl"

	RangeSliderTrackValueLabelPositionTop    string = "top"
	RangeSliderTrackValueLabelPositionBottom string = "bottom"

	RangeSliderTrackTooltipPositionTop    string = "top"
	RangeSliderTrackTooltipPositionBottom string = "bottom"
)

type RangeSliderThumbSettings struct {
	// OptionalFields
	AriaLabel                  string
	AriaLabelOneWayStatePath   string
	BackgroundColor            string
	Label                      string
	LabelIcon                  string
	LabelOneWayStatePath       string
	Shape                      string
	TextColor                  string
	ValueBubbleBackgroundColor string
	ValueBubbleDisplayMode     string
	ValueBubbleEnabled         bool
	ValueBubblePosition        string
	ValueBubbleRingColor       string
	ValueBubbleRingThickness   string
	ValueBubbleShape           string
	ValueBubbleSize            string
	ValueBubbleTextColor       string
}

type RangeSliderTrackSettings struct {
	// OptionalFields
	BackgroundColor          string
	BackgroundColorFrom      string
	BackgroundColorTo        string
	BackgroundColorVia       string
	EndValueLabelEnabled     bool
	EndValueLabelIcon        string
	EndValueLabelPosition    string
	EndValueLabelTextColor   string
	FillColor                string
	FillColorFrom            string
	FillColorTo              string
	FillColorVia             string
	StartValueLabelEnabled   bool
	StartValueLabelIcon      string
	StartValueLabelPosition  string
	StartValueLabelTextColor string
	TickStep                 string
	TicksEnabled             bool
	TooltipBackgroundColor   string
	TooltipEnabled           bool
	TooltipPosition          string
	TooltipRingColor         string
	TooltipRingThickness     string
	TooltipTextColor         string
}

type RangeSliderSettings struct {
	// OptionalFields
	ShouldNormalizeInitialState    bool
	Size                           string
	Thumb                          RangeSliderThumbSettings
	ThumbDualValueModeEnabled      bool
	ThumbUpper                     RangeSliderThumbSettings
	ThumbUpperValue                string
	ThumbUpperValueTwoWayStatePath string
	ThumbValue                     string
	ThumbValueTwoWayStatePath      string
	Track                          RangeSliderTrackSettings
	TrackEndValue                  string
	TrackEndValueOneWayStatePath   string
	TrackStartValue                string
	TrackStartValueOneWayStatePath string
	TrackSteps                     string
}

func resolveRangeSliderThumbSizeUnit(componentSettings RangeSliderSettings) string {
	switch componentSettings.Size {
	case RangeSliderSizeXs:
		return "2.5"
	case RangeSliderSizeSm:
		return "3.5"
	case RangeSliderSizeLg:
		return "5.5"
	case RangeSliderSizeXl:
		return "6.5"
	}
	return "4.5"
}

templ Thumb(componentSettings RangeSliderSettings, thumbSettings RangeSliderThumbSettings, isUpper bool) {
	{{ thumbSizeUnit := resolveRangeSliderThumbSizeUnit(componentSettings) }}
	{{ thumbSize := "w-" + thumbSizeUnit + " h-" + thumbSizeUnit }}
	{{ thumbPosition := "-top-1.25" }}
	switch componentSettings.Size {
		case RangeSliderSizeXs:
			{{ thumbPosition = "-top-0.75" }}
		case RangeSliderSizeSm:
			{{ thumbPosition = "-top-1.25" }}
		case RangeSliderSizeMd:
			{{ thumbPosition = "-top-1.5" }}
		case RangeSliderSizeLg:
			{{ thumbPosition = "-top-1.75" }}
		case RangeSliderSizeXl:
			{{ thumbPosition = "-top-2" }}
	}
	<!-- Thumb -->
	{{ thumbShape := uiToolset.ShapeClassResolver(thumbSettings.Shape, "rounded-full") }}
	if thumbSettings.Shape == RangeSliderThumbShapePipe {
		{{ thumbShape = "rounded-none" }}
		switch componentSettings.Size {
			case RangeSliderSizeXs:
				{{ thumbShape += " !w-1" }}
			case RangeSliderSizeSm:
				{{ thumbShape += " !w-1" }}
			case RangeSliderSizeMd:
				{{ thumbShape += " !w-1" }}
			case RangeSliderSizeLg:
				{{ thumbShape += " !w-1.5" }}
			case RangeSliderSizeXl:
				{{ thumbShape += " !w-1.5" }}
			default:
				{{ thumbShape += " !w-1" }}
		}
	}
	{{ thumbBackgroundColor := "bg-neutral-50" }}
	{{ thumbTextColor := "text-neutral-800" }}
	if thumbSettings.BackgroundColor != "" {
		{{ thumbBackgroundColor = "bg-" + thumbSettings.BackgroundColor }}
	}
	if thumbSettings.TextColor != "" {
		{{ thumbTextColor = "text-" + thumbSettings.TextColor }}
	}
	{{ percentValue := "thumbValuePercent" }}
	{{ bubbleValue := "thumbValue" }}
	{{ hoverState := "thumbHover" }}
	{{ focusState := "thumbFocused" }}
	if isUpper {
		{{ percentValue = "thumbUpperValuePercent" }}
		{{ bubbleValue = "thumbUpperValue" }}
		{{ hoverState = "thumbUpperHover" }}
		{{ focusState = "thumbUpperFocused" }}
	}
	<div
		class={ "absolute select-none flex justify-center items-center " + thumbPosition + " " + thumbSize + " " + thumbShape + " " + thumbBackgroundColor + " " + thumbTextColor + " cursor-pointer shadow-md transition-transform duration-200 z-10" }
		:style={ "'left: calc(' + " + percentValue + " + '%); transform: translateX(-50%) scale(' + (" + hoverState + " || " + focusState + " ? 1.1 : 1) + ');'" }
		:class={ "{" + "'!z-30': " + hoverState + " || " + focusState + ", 'ring-2 ring-secondary-500/50': " + focusState + "}" }
		@mouseenter={ hoverState + " = true" }
		@mouseleave={ hoverState + " = false" }
	>
		if thumbSettings.LabelIcon != "" {
			<!-- ThumbLabelIcon -->
			{{ thumbIconSize := "text-sm" }}
			switch componentSettings.Size {
				case RangeSliderSizeXs:
					{{ thumbIconSize = "text-[0.5rem]" }}
				case RangeSliderSizeSm:
					{{ thumbIconSize = "text-xs" }}
				case RangeSliderSizeMd:
					{{ thumbIconSize = "text-sm" }}
				case RangeSliderSizeLg:
					{{ thumbIconSize = "text-base" }}
				case RangeSliderSizeXl:
					{{ thumbIconSize = "text-lg" }}
			}
			<i class={ "ph-bold " + thumbSettings.LabelIcon + " flex h-full w-full items-center justify-center " + thumbIconSize }></i>
		}
		if thumbSettings.Label != "" || thumbSettings.LabelOneWayStatePath != "" {
			<!-- ThumbLabel -->
			{{ thumbLabelSize := "text-xs" }}
			switch componentSettings.Size {
				case RangeSliderSizeXs:
					{{ thumbLabelSize = "text-[0.5rem]" }}
				case RangeSliderSizeSm:
					{{ thumbLabelSize = "text-xs" }}
				case RangeSliderSizeMd:
					{{ thumbLabelSize = "text-sm" }}
				case RangeSliderSizeLg:
					{{ thumbLabelSize = "text-base" }}
				case RangeSliderSizeXl:
					{{ thumbLabelSize = "text-lg" }}
			}
			<span
				class={ "flex h-full w-full items-center justify-center " + thumbLabelSize }
				if thumbSettings.LabelOneWayStatePath != "" {
					x-text={ thumbSettings.LabelOneWayStatePath }
				}
			>
				{ thumbSettings.Label }
			</span>
		}
		<!-- ThumbValueBubble -->
		if thumbSettings.ValueBubbleEnabled {
			{{ bubblePositionOffset := "7.5" }}
			switch componentSettings.Size {
				case RangeSliderSizeXs:
					{{ bubblePositionOffset = "5.5" }}
				case RangeSliderSizeSm:
					{{ bubblePositionOffset = "6.5" }}
				case RangeSliderSizeMd:
					{{ bubblePositionOffset = "7.5" }}
				case RangeSliderSizeLg:
					{{ bubblePositionOffset = "8.5" }}
				case RangeSliderSizeXl:
					{{ bubblePositionOffset = "9.5" }}
			}
			switch thumbSettings.ValueBubbleSize {
				case RangeSliderThumbValueBubbleSizeXs:
					{{ bubblePositionOffset = "5.5" }}
				case RangeSliderThumbValueBubbleSizeSm:
					{{ bubblePositionOffset = "6.5" }}
				case RangeSliderThumbValueBubbleSizeMd:
					{{ bubblePositionOffset = "7.5" }}
				case RangeSliderThumbValueBubbleSizeLg:
					{{ bubblePositionOffset = "8.5" }}
				case RangeSliderThumbValueBubbleSizeXl:
					{{ bubblePositionOffset = "9.5" }}
			}
			{{ bubblePosition := "-top-" + bubblePositionOffset }}
			if thumbSettings.ValueBubblePosition == RangeSliderThumbValueBubblePositionBottom {
				{{ bubblePosition = "-bottom-" + bubblePositionOffset }}
			}
			{{ bubbleSize := "min-w-8 p-1 text-base" }}
			switch thumbSettings.ValueBubbleSize {
				case RangeSliderThumbValueBubbleSizeXs:
					{{ bubbleSize = "min-w-6 p-0.5 text-xs" }}
				case RangeSliderThumbValueBubbleSizeSm:
					{{ bubbleSize = "min-w-7 p-0.75 text-sm" }}
				case RangeSliderThumbValueBubbleSizeMd:
					{{ bubbleSize = "min-w-8 p-1 text-base" }}
				case RangeSliderThumbValueBubbleSizeLg:
					{{ bubbleSize = "min-w-10 p-1.5 text-lg" }}
				case RangeSliderThumbValueBubbleSizeXl:
					{{ bubbleSize = "min-w-12 p-2 text-xl" }}
			}
			{{ bubbleShape := uiToolset.ShapeClassResolver(thumbSettings.ValueBubbleShape, "rounded-full") }}
			{{ bubbleBackgroundColor := "bg-neutral-800" }}
			if thumbSettings.ValueBubbleBackgroundColor != "" {
				{{ bubbleBackgroundColor = "bg-" + thumbSettings.ValueBubbleBackgroundColor }}
			}
			{{ bubbleTextColor := "text-neutral-50" }}
			if thumbSettings.ValueBubbleTextColor != "" {
				{{ bubbleTextColor = "text-" + thumbSettings.ValueBubbleTextColor }}
			}
			{{ bubbleRingClasses := uiToolset.CompactRingClassResolver(thumbSettings.ValueBubbleRingColor, thumbSettings.ValueBubbleRingThickness) }}
			<div
				data-ui-range-slider-thumb-bubble
				class={ "absolute " + bubblePosition + " select-none flex items-center justify-center " + bubbleSize + " " + bubbleShape + " " + bubbleBackgroundColor + " " + bubbleTextColor + " " + bubbleRingClasses }
				if thumbSettings.ValueBubbleDisplayMode == RangeSliderThumbValueBubbleDisplayModeHover {
					x-show={ hoverState + " || " + focusState }
					style="display: none"
					x-transition.opacity.duration.150ms
				}
				x-text={ bubbleValue }
				@mouseenter={ hoverState + " = true" }
				@mouseleave={ hoverState + " = false" }
			></div>
		}
	</div>
}

func (componentSettings RangeSliderSettings) resolveThumbAriaLabel(
	thumbSettings RangeSliderThumbSettings, isUpper bool,
) string {
	if thumbSettings.AriaLabel != "" {
		return thumbSettings.AriaLabel
	}
	if thumbSettings.Label != "" {
		if isUpper {
			return "Upper " + thumbSettings.Label
		}
		return thumbSettings.Label
	}
	if isUpper {
		return "Upper value"
	}
	if componentSettings.ThumbDualValueModeEnabled {
		return "Lower value"
	}
	return "Value"
}

func (componentSettings RangeSliderSettings) resolveThumbAriaLabelExpression(
	thumbSettings RangeSliderThumbSettings, isUpper bool,
) string {
	if thumbSettings.AriaLabelOneWayStatePath == "" {
		return ""
	}
	fallbackAriaLabel := componentSettings.resolveThumbAriaLabel(thumbSettings, isUpper)
	return "(" + thumbSettings.AriaLabelOneWayStatePath + ") || " + strconv.Quote(fallbackAriaLabel)
}

func resolveRangeSliderThumbPathClamp(statePath string) string {
	return "if (" + statePath + " < trackStartValue) " + statePath + " = trackStartValue; if (" + statePath + " > trackEndValue) " + statePath + " = trackEndValue;"
}

func resolveRangeSliderThumbWatch(statePath, localProperty, orderingPush string) string {
	return "$watch('" + statePath + "', (newValue, oldValue) => { if (oldValue == newValue) return; if (newValue < trackStartValue) newValue = trackStartValue; if (newValue > trackEndValue) newValue = trackEndValue; " + resolveRangeSliderThumbPathClamp(statePath) + " if (" + localProperty + " != newValue) " + localProperty + " = newValue;" + orderingPush + " });"
}

func resolveRangeSliderLowerOrderingPush(componentSettings RangeSliderSettings) string {
	if !componentSettings.ThumbDualValueModeEnabled {
		return ""
	}
	orderingPush := " if (thumbValue > thumbUpperValue) { thumbUpperValue = Math.min(Number(thumbValue) + Number(trackSteps), trackEndValue);"
	if componentSettings.ThumbUpperValueTwoWayStatePath != "" {
		orderingPush += " if (" + componentSettings.ThumbUpperValueTwoWayStatePath + " < thumbValue) " + componentSettings.ThumbUpperValueTwoWayStatePath + " = thumbUpperValue;"
	}
	return orderingPush + " }"
}

func resolveRangeSliderLowerWatch(componentSettings RangeSliderSettings) string {
	if componentSettings.ThumbValueTwoWayStatePath == "" {
		return ""
	}
	return resolveRangeSliderThumbWatch(componentSettings.ThumbValueTwoWayStatePath, "thumbValue", resolveRangeSliderLowerOrderingPush(componentSettings))
}

func resolveRangeSliderUpperOrderingPush(componentSettings RangeSliderSettings) string {
	if !componentSettings.ThumbDualValueModeEnabled {
		return ""
	}
	orderingPush := " if (thumbUpperValue < thumbValue) { thumbValue = Math.max(Number(thumbUpperValue) - Number(trackSteps), trackStartValue);"
	if componentSettings.ThumbValueTwoWayStatePath != "" {
		orderingPush += " if (" + componentSettings.ThumbValueTwoWayStatePath + " > thumbUpperValue) " + componentSettings.ThumbValueTwoWayStatePath + " = thumbValue;"
	}
	return orderingPush + " }"
}

func resolveRangeSliderUpperWatch(componentSettings RangeSliderSettings) string {
	if componentSettings.ThumbUpperValueTwoWayStatePath == "" || !componentSettings.ThumbDualValueModeEnabled {
		return ""
	}
	return resolveRangeSliderThumbWatch(componentSettings.ThumbUpperValueTwoWayStatePath, "thumbUpperValue", resolveRangeSliderUpperOrderingPush(componentSettings))
}

func resolveRangeSliderInitialStateNormalization(componentSettings RangeSliderSettings) string {
	if !componentSettings.ShouldNormalizeInitialState {
		return ""
	}
	normalization := ""
	if componentSettings.ThumbValueTwoWayStatePath != "" {
		normalization += resolveRangeSliderThumbPathClamp(componentSettings.ThumbValueTwoWayStatePath)
	}
	if componentSettings.ThumbUpperValueTwoWayStatePath != "" && componentSettings.ThumbDualValueModeEnabled {
		normalization += " " + resolveRangeSliderThumbPathClamp(componentSettings.ThumbUpperValueTwoWayStatePath)
	}
	return normalization + resolveRangeSliderLowerOrderingPush(componentSettings)
}

templ RangeSlider(componentSettings RangeSliderSettings) {
	<!-- RangeSlider -->
	{{ thumbValue := "0" }}
	{{ thumbUpperValue := "75" }}
	{{ trackStartValue := "0" }}
	{{ trackEndValue := "100" }}
	{{ trackSteps := "1" }}
	if componentSettings.ThumbValue != "" {
		{{ thumbValue = componentSettings.ThumbValue }}
	}
	if componentSettings.ThumbValueTwoWayStatePath != "" {
		{{ thumbValue = componentSettings.ThumbValueTwoWayStatePath }}
	}
	if componentSettings.ThumbUpperValue != "" {
		{{ thumbUpperValue = componentSettings.ThumbUpperValue }}
	}
	if componentSettings.ThumbUpperValueTwoWayStatePath != "" {
		{{ thumbUpperValue = componentSettings.ThumbUpperValueTwoWayStatePath }}
	}
	if componentSettings.TrackStartValue != "" {
		{{ trackStartValue = componentSettings.TrackStartValue }}
	}
	if componentSettings.TrackStartValueOneWayStatePath != "" {
		{{ trackStartValue = componentSettings.TrackStartValueOneWayStatePath }}
	}
	if componentSettings.TrackEndValue != "" {
		{{ trackEndValue = componentSettings.TrackEndValue }}
	}
	if componentSettings.TrackEndValueOneWayStatePath != "" {
		{{ trackEndValue = componentSettings.TrackEndValueOneWayStatePath }}
	}
	if componentSettings.TrackSteps != "" {
		{{ trackSteps = componentSettings.TrackSteps }}
	}
	{{ trackTickStep := trackSteps }}
	if componentSettings.Track.TickStep != "" {
		{{ trackTickStep = componentSettings.Track.TickStep }}
	}
	{{ alpineData := "{thumbValue: " + thumbValue + ", trackStartValue: " + trackStartValue + ", trackEndValue: " + trackEndValue + ", trackSteps: " + trackSteps + ", thumbHover: false, thumbFocused: false, clampPercent(percent) { return Math.min(Math.max(percent, 0), 100); }, get thumbValuePercent() { return this.clampPercent((this.thumbValue - this.trackStartValue) / (this.trackEndValue - this.trackStartValue) * 100); }" }}
	if componentSettings.ThumbDualValueModeEnabled {
		{{ alpineData += ", thumbUpperValue: " + thumbUpperValue + ", thumbUpperHover: false, thumbUpperFocused: false, get thumbUpperValuePercent() { return this.clampPercent((this.thumbUpperValue - this.trackStartValue) / (this.trackEndValue - this.trackStartValue) * 100); }, get thumbMidPercent() { return (this.thumbValuePercent + this.thumbUpperValuePercent) / 2; }" }}
	}
	if componentSettings.Track.TicksEnabled {
		{{ alpineData += ", trackTickStep: " + trackTickStep + ", get trackTickPercents() { const step = Number(this.trackTickStep); const start = Number(this.trackStartValue); const end = Number(this.trackEndValue); if (!(step > 0) || !(end > start)) return []; const tickCount = Math.floor((end - start) / step); if (!(tickCount > 0) || tickCount > 200) return []; const percents = []; for (let index = 0; index <= tickCount; index++) { percents.push(this.clampPercent((index * step) / (end - start) * 100)); } return percents; }" }}
	}
	if componentSettings.Track.TooltipEnabled {
		{{ alpineData += ", trackTooltipVisible: false, trackTooltipPercent: 0, trackTooltipValue: 0, resolveTrackTooltipDecimalPlaces(valueText) { const exponentIndex = valueText.search(/[eE]/); const exponent = exponentIndex === -1 ? 0 : Number(valueText.slice(exponentIndex + 1)); const mantissaText = exponentIndex === -1 ? valueText : valueText.slice(0, exponentIndex); const dotIndex = mantissaText.indexOf('.'); const mantissaDecimalPlaces = dotIndex === -1 ? 0 : mantissaText.length - dotIndex - 1; return Math.max(mantissaDecimalPlaces - exponent, 0); }, showTrackTooltip(event) { const trackRect = event.currentTarget.getBoundingClientRect(); const hoverPercent = this.clampPercent((event.clientX - trackRect.left) / trackRect.width * 100); const startValue = Number(this.trackStartValue); const endValue = Number(this.trackEndValue); const stepSize = Number(this.trackSteps) > 0 ? Number(this.trackSteps) : 1; const rawValue = startValue + hoverPercent / 100 * (endValue - startValue); const stepIndexTolerance = 1e-9; const maximumStepIndex = Math.floor((endValue - startValue) / stepSize + stepIndexTolerance); const stepIndex = Math.min(Math.max(Math.round((rawValue - startValue) / stepSize), 0), maximumStepIndex); const steppedValue = startValue + stepIndex * stepSize; const valuePrecision = Math.max(this.resolveTrackTooltipDecimalPlaces(String(this.trackStartValue)), this.resolveTrackTooltipDecimalPlaces(String(this.trackSteps))); const clampedValue = Math.min(Math.max(steppedValue, startValue), endValue); const roundedValue = Number(clampedValue.toFixed(valuePrecision)); this.trackTooltipPercent = hoverPercent; this.trackTooltipValue = Math.min(Math.max(roundedValue, startValue), endValue); this.trackTooltipVisible = true; }" }}
	}
	{{ alpineData += "}" }}
	{{ alpineWatch := resolveRangeSliderLowerWatch(componentSettings) + resolveRangeSliderUpperWatch(componentSettings) + resolveRangeSliderInitialStateNormalization(componentSettings) }}
	{{ mainDivMinHeight := 6 }}
	switch componentSettings.Size {
		case RangeSliderSizeXs:
			{{ mainDivMinHeight = 4 }}
		case RangeSliderSizeSm:
			{{ mainDivMinHeight = 5 }}
		case RangeSliderSizeMd:
			{{ mainDivMinHeight = 6 }}
		case RangeSliderSizeLg:
			{{ mainDivMinHeight = 7 }}
		case RangeSliderSizeXl:
			{{ mainDivMinHeight = 8 }}
	}
	if componentSettings.Thumb.ValueBubbleEnabled || componentSettings.ThumbUpper.ValueBubbleEnabled {
		{{ mainDivMinHeight = mainDivMinHeight * 3 }}
	}
	<div
		class={ "flex w-full flex-col items-center justify-center" + " min-h-" + strconv.Itoa(mainDivMinHeight) }
		x-data={ alpineData }
		x-init={ alpineWatch }
	>
		<div class="relative flex w-full flex-row items-center gap-2">
			{{ trackHeight := "h-1.5" }}
			switch componentSettings.Size {
				case RangeSliderSizeXs:
					{{ trackHeight = "h-1" }}
				case RangeSliderSizeSm:
					{{ trackHeight = "h-1.25" }}
				case RangeSliderSizeMd:
					{{ trackHeight = "h-1.5" }}
				case RangeSliderSizeLg:
					{{ trackHeight = "h-1.75" }}
				case RangeSliderSizeXl:
					{{ trackHeight = "h-2" }}
			}
			<!-- TrackStartValue -->
			if componentSettings.Track.StartValueLabelEnabled || componentSettings.Track.StartValueLabelIcon != "" {
				{{ startLabelPosition := "" }}
				switch componentSettings.Track.StartValueLabelPosition {
					case RangeSliderTrackValueLabelPositionTop:
						{{ startLabelPosition = "absolute left-0 bottom-full mb-1" }}
					case RangeSliderTrackValueLabelPositionBottom:
						{{ startLabelPosition = "absolute left-0 top-full mt-1" }}
				}
				{{ startLabelTextColor := "text-neutral-400" }}
				if componentSettings.Track.StartValueLabelTextColor != "" {
					{{ startLabelTextColor = "text-" + componentSettings.Track.StartValueLabelTextColor }}
				}
				<div class={ startLabelPosition + " flex items-center text-xs gap-1 " + startLabelTextColor }>
					{{ startLabelIconSize := "text-lg" }}
					switch componentSettings.Size {
						case RangeSliderSizeXs:
							{{ startLabelIconSize = "text-sm" }}
						case RangeSliderSizeSm:
							{{ startLabelIconSize = "text-base" }}
						case RangeSliderSizeMd:
							{{ startLabelIconSize = "text-lg" }}
						case RangeSliderSizeLg:
							{{ startLabelIconSize = "text-xl" }}
						case RangeSliderSizeXl:
							{{ startLabelIconSize = "text-2xl" }}
					}
					if componentSettings.Track.StartValueLabelIcon != "" {
						<i class={ "ph-bold " + componentSettings.Track.StartValueLabelIcon + " " + startLabelIconSize }></i>
					}
					if componentSettings.Track.StartValueLabelEnabled {
						<span x-text="trackStartValue"></span>
					}
				</div>
			}
			<!-- Track&Thumb -->
			<div class="relative flex w-full flex-row gap-2">
				<!-- Track -->
				{{ trackBackgroundColor := "bg-neutral-50/5" }}
				if componentSettings.Track.BackgroundColor != "" {
					{{ trackBackgroundColor = "bg-" + componentSettings.Track.BackgroundColor }}
				}
				if componentSettings.Track.BackgroundColorFrom != "" || componentSettings.Track.BackgroundColorVia != "" || componentSettings.Track.BackgroundColorTo != "" {
					{{ trackBackgroundColor = "bg-gradient-to-r" }}
					if componentSettings.Track.BackgroundColorFrom != "" {
						{{ trackBackgroundColor = trackBackgroundColor + " from-" + componentSettings.Track.BackgroundColorFrom }}
					}
					if componentSettings.Track.BackgroundColorVia != "" {
						{{ trackBackgroundColor = trackBackgroundColor + " via-" + componentSettings.Track.BackgroundColorVia }}
					}
					if componentSettings.Track.BackgroundColorTo != "" {
						{{ trackBackgroundColor = trackBackgroundColor + " to-" + componentSettings.Track.BackgroundColorTo }}
					}
				}
				<div
					class={ trackBackgroundColor + " flex items-center relative rounded-full w-full " + trackHeight }
					if componentSettings.Track.TooltipEnabled {
						@mousemove="showTrackTooltip($event)"
						@mouseleave="trackTooltipVisible = false"
					}
				>
					<!-- RangeInputs -->
					{{ rangeInputHeight := "h-" + resolveRangeSliderThumbSizeUnit(componentSettings) }}
					{{ rangeInputHoverHeight := 7 }}
					switch componentSettings.Size {
						case RangeSliderSizeXs:
							{{ rangeInputHoverHeight = 3 }}
						case RangeSliderSizeSm:
							{{ rangeInputHoverHeight = 5 }}
						case RangeSliderSizeMd:
							{{ rangeInputHoverHeight = 7 }}
						case RangeSliderSizeLg:
							{{ rangeInputHoverHeight = 9 }}
						case RangeSliderSizeXl:
							{{ rangeInputHoverHeight = 11 }}
					}
					if componentSettings.Thumb.ValueBubbleEnabled || componentSettings.ThumbUpper.ValueBubbleEnabled {
						{{ rangeInputHoverHeight = rangeInputHoverHeight * 2 }}
					}
					{{ rangeInputHoverHeightStr := strconv.Itoa(rangeInputHoverHeight) }}
					{{ rangeInputClasses := "absolute z-40 " + rangeInputHeight + " w-full cursor-pointer appearance-none opacity-0" }}
					{{ inputEvent := "if (thumbValue <= trackStartValue) thumbValue = trackStartValue; if (thumbValue >= trackEndValue) thumbValue = trackEndValue;" }}
					if componentSettings.ThumbDualValueModeEnabled {
						{{ inputEvent += "if (thumbUpperValue <= thumbValue) thumbUpperValue = Math.min(Number(thumbValue) + Number(trackSteps), trackEndValue);" }}
						if componentSettings.ThumbUpperValueTwoWayStatePath != "" {
							{{ inputEvent += componentSettings.ThumbUpperValueTwoWayStatePath + " = thumbUpperValue;" }}
						}
					}
					if componentSettings.ThumbValueTwoWayStatePath != "" {
						{{ inputEvent += componentSettings.ThumbValueTwoWayStatePath + " = thumbValue" }}
					}
					{{ lowerAriaLabelExpression := componentSettings.resolveThumbAriaLabelExpression(componentSettings.Thumb, false) }}
					<input
						type="range"
						class={ rangeInputClasses }
						aria-label={ componentSettings.resolveThumbAriaLabel(componentSettings.Thumb, false) }
						if lowerAriaLabelExpression != "" {
							:aria-label={ lowerAriaLabelExpression }
						}
						:min="trackStartValue"
						:max="trackEndValue"
						:step="trackSteps"
						x-model.number:value="thumbValue"
						@focus="thumbFocused = true"
						@blur="thumbFocused = false"
						@mouseenter="thumbHover = true"
						@mouseleave="thumbHover = false"
						@input.debounce.100ms={ inputEvent }
						if componentSettings.Thumb.ValueBubbleEnabled {
							:class={ "thumbHover && '!h-" + rangeInputHoverHeightStr + "'" }
						}
						if componentSettings.ThumbDualValueModeEnabled {
							:style="'clip-path: inset(0 ' + (100 - thumbMidPercent) + '% 0 0)'"
						}
					/>
					if componentSettings.ThumbDualValueModeEnabled {
						<!-- RangeInputUpper -->
						{{ inputEvent := "if (thumbUpperValue <= trackStartValue) thumbUpperValue = trackStartValue; if (thumbUpperValue >= trackEndValue) thumbUpperValue = trackEndValue; if (thumbUpperValue <= thumbValue) thumbUpperValue = Math.min(Number(thumbValue) + Number(trackSteps), trackEndValue);" }}
						if componentSettings.ThumbUpperValueTwoWayStatePath != "" {
							{{ inputEvent += componentSettings.ThumbUpperValueTwoWayStatePath + " = thumbUpperValue" }}
						}
						{{ upperAriaLabelExpression := componentSettings.resolveThumbAriaLabelExpression(componentSettings.ThumbUpper, true) }}
						<input
							type="range"
							class={ rangeInputClasses }
							aria-label={ componentSettings.resolveThumbAriaLabel(componentSettings.ThumbUpper, true) }
							if upperAriaLabelExpression != "" {
								:aria-label={ upperAriaLabelExpression }
							}
							:min="trackStartValue"
							:max="trackEndValue"
							:step="trackSteps"
							x-model.number:value="thumbUpperValue"
							@focus="thumbUpperFocused = true"
							@blur="thumbUpperFocused = false"
							@mouseenter="thumbUpperHover = true"
							@mouseleave="thumbUpperHover = false"
							@input.debounce.100ms={ inputEvent }
							:style="'clip-path: inset(0 0 0 ' + thumbMidPercent + '%)'"
							if componentSettings.ThumbUpper.ValueBubbleEnabled {
								:class={ "thumbUpperHover && '!h-" + rangeInputHoverHeightStr + "'" }
							}
						/>
					}
					<!-- TrackFill -->
					{{ trackFillColor := "bg-neutral-50/30" }}
					if componentSettings.Track.FillColor != "" {
						{{ trackFillColor = "bg-" + componentSettings.Track.FillColor }}
					}
					if componentSettings.Track.FillColorFrom != "" || componentSettings.Track.FillColorVia != "" || componentSettings.Track.FillColorTo != "" {
						{{ trackFillColor = "bg-gradient-to-r" }}
						if componentSettings.Track.FillColorFrom != "" {
							{{ trackFillColor += " from-" + componentSettings.Track.FillColorFrom }}
						}
						if componentSettings.Track.FillColorVia != "" {
							{{ trackFillColor += " via-" + componentSettings.Track.FillColorVia }}
						}
						if componentSettings.Track.FillColorTo != "" {
							{{ trackFillColor += " to-" + componentSettings.Track.FillColorTo }}
						}
					}
					{{ trackFillClass := "absolute inset-0 h-full rounded-full " + trackFillColor }}
					{{ trackFillStyle := "'width: ' + thumbValuePercent + '%'" }}
					if componentSettings.ThumbDualValueModeEnabled {
						{{ trackFillClass = "absolute inset-0 h-full rounded-full " + trackFillColor }}
						{{ trackFillStyle = "'left: ' + thumbValuePercent + '%; right: ' + (100 - thumbUpperValuePercent) + '%'" }}
					}
					<div class={ trackFillClass } x-bind:style={ trackFillStyle }></div>
					<!-- TrackTicks -->
					if componentSettings.Track.TicksEnabled {
						<div aria-hidden="true" class="absolute inset-0">
							<template x-for="percent in trackTickPercents" :key="percent">
								<span
									class="absolute top-1/2 h-2.5 w-0.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-neutral-50/50"
									:style="'left: ' + percent + '%'"
								></span>
							</template>
						</div>
					}
					<!-- TrackTooltip -->
					if componentSettings.Track.TooltipEnabled {
						{{ trackTooltipPositionClasses := "bottom-full mb-3" }}
						if componentSettings.Track.TooltipPosition == RangeSliderTrackTooltipPositionBottom {
							{{ trackTooltipPositionClasses = "top-full mt-3" }}
						}
						{{ trackTooltipBackgroundColor := "bg-neutral-800" }}
						if componentSettings.Track.TooltipBackgroundColor != "" {
							{{ trackTooltipBackgroundColor = "bg-" + componentSettings.Track.TooltipBackgroundColor }}
						}
						{{ trackTooltipTextColor := "text-neutral-50" }}
						if componentSettings.Track.TooltipTextColor != "" {
							{{ trackTooltipTextColor = "text-" + componentSettings.Track.TooltipTextColor }}
						}
						{{ trackTooltipRingClasses := "" }}
						if componentSettings.Track.TooltipRingColor != "" {
							{{ trackTooltipRingClasses = uiToolset.CompactRingClassResolver(componentSettings.Track.TooltipRingColor, componentSettings.Track.TooltipRingThickness) }}
						}
						<div
							data-ui-range-slider-track-tooltip
							class={ "absolute z-50 -translate-x-1/2 pointer-events-none select-none flex items-center justify-center min-w-8 p-1 text-base rounded-full " + trackTooltipPositionClasses + " " + trackTooltipBackgroundColor + " " + trackTooltipTextColor + " " + trackTooltipRingClasses }
							x-show="trackTooltipVisible"
							style="display: none"
							x-transition.opacity.duration.150ms
							:style="'left: ' + trackTooltipPercent + '%'"
							x-text="trackTooltipValue"
							aria-hidden="true"
						></div>
					}
					@Thumb(componentSettings, componentSettings.Thumb, false)
					if componentSettings.ThumbDualValueModeEnabled {
						<!-- ThumbUpper -->
						@Thumb(componentSettings, componentSettings.ThumbUpper, true)
					}
				</div>
			</div>
			<!-- TrackEndValue -->
			if componentSettings.Track.EndValueLabelEnabled || componentSettings.Track.EndValueLabelIcon != "" {
				{{ endLabelPosition := "" }}
				switch componentSettings.Track.EndValueLabelPosition {
					case RangeSliderTrackValueLabelPositionTop:
						{{ endLabelPosition = "absolute right-0 bottom-full mb-1" }}
					case RangeSliderTrackValueLabelPositionBottom:
						{{ endLabelPosition = "absolute right-0 top-full mt-1" }}
				}
				{{ endLabelTextColor := "text-neutral-400" }}
				if componentSettings.Track.EndValueLabelTextColor != "" {
					{{ endLabelTextColor = "text-" + componentSettings.Track.EndValueLabelTextColor }}
				}
				{{ endLabelIconSize := "text-lg" }}
				switch componentSettings.Size {
					case RangeSliderSizeXs:
						{{ endLabelIconSize = "text-sm" }}
					case RangeSliderSizeSm:
						{{ endLabelIconSize = "text-base" }}
					case RangeSliderSizeMd:
						{{ endLabelIconSize = "text-lg" }}
					case RangeSliderSizeLg:
						{{ endLabelIconSize = "text-xl" }}
					case RangeSliderSizeXl:
						{{ endLabelIconSize = "text-2xl" }}
				}
				<div class={ endLabelPosition + " flex items-center text-xs gap-1 " + endLabelTextColor }>
					if componentSettings.Track.EndValueLabelIcon != "" {
						<i class={ "ph-bold " + componentSettings.Track.EndValueLabelIcon + " " + endLabelIconSize }></i>
					}
					if componentSettings.Track.EndValueLabelEnabled {
						<span x-text="trackEndValue"></span>
					}
				</div>
			}
		</div>
	</div>
}
