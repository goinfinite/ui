package uiControl

import (
	_ "embed"
	"fmt"
	"strconv"
	"strings"
	"sync/atomic"

	uiToolset "github.com/goinfinite/ui/src/toolset"
)

//go:embed buttonState.js
var buttonAlpineState string

var buttonAlpineStateOnce = templ.NewOnceHandle(
	templ.WithComponent(uiToolset.MinifierTemplateJs(&buttonAlpineState)),
)

var buttonTooltipIdCounter atomic.Uint64

func generateButtonTooltipId() string {
	return fmt.Sprintf("button-tooltip-%d", buttonTooltipIdCounter.Add(1))
}

const (
	ButtonSizeXs string = "xs"
	ButtonSizeSm string = "sm"
	ButtonSizeMd string = "md"
	ButtonSizeLg string = "lg"
	ButtonSizeXl string = "xl"
)

type ButtonSettings struct {
	// OptionalFields
	Label                           string
	LabelOneWayStatePath            string
	AriaExpandedOneWayStatePath     string
	AriaLabel                       string
	AriaLabelOneWayStatePath        string
	BackgroundColor                 string
	BackgroundColorActive           string
	BackgroundColorHover            string
	CountdownSeconds                uint
	CountdownTriggerOneWayStatePath string
	FailedIcon                      string
	FailedLabel                     string
	FailedLabelOneWayStatePath      string
	FormId                          string
	IconLeft                        string
	IconLeftOneWayStatePath         string
	IconRight                       string
	IconRightOneWayStatePath        string
	IconSizeClass                   string
	IconTop                         string
	IconTopOneWayStatePath          string
	Id                              string
	IsDisabled                      bool
	IsDisabledOneWayStatePath       string
	IsPendingOneWayStatePath        string
	IsVisibleOneWayStatePath        string
	IsFullWidth                     bool
	IsSubmit                        bool
	MaxHeightClass                  string
	MaxWidthClass                   string
	MinHeightClass                  string
	MinWidthClass                   string
	OnClickFunc                     string
	OnClickPreventDefault           bool
	PaddingSize                     string
	PendingIcon                     string
	PendingIconAnimation            string
	PendingLabel                    string
	PendingLabelOneWayStatePath     string
	Shape                           string
	ShouldTrackAction               bool
	Size                            string
	SucceededIcon                   string
	SucceededLabel                  string
	SucceededLabelOneWayStatePath   string
	TextCase                        string
	TextColor                       string
	TextColorHover                  string
	TextSizeClass                   string
	TooltipContent                  string
	TooltipContentHtml              templ.Component
	TooltipContentOneWayStatePath   string
	TooltipBackgroundColor          string
	TooltipPosition                 string
	TooltipRingColor                string
	TooltipRingThickness            string
	TooltipTextColor                string
	TooltipMinWidthClass            string
	TooltipMaxWidthClass            string
	TooltipMinHeightClass           string
	TooltipMaxHeightClass           string
	RingColor                       string
	RingColorHover                  string
	RingThickness                   string
}

func (componentSettings ButtonSettings) hasActionDisplay() bool {
	return componentSettings.ShouldTrackAction ||
		componentSettings.IsPendingOneWayStatePath != ""
}

func (componentSettings ButtonSettings) hasCountdown() bool {
	return componentSettings.CountdownSeconds > 0
}

func (componentSettings ButtonSettings) hasVisibleLabel() bool {
	if componentSettings.Label != "" || componentSettings.LabelOneWayStatePath != "" {
		return true
	}
	if !componentSettings.hasActionDisplay() {
		return false
	}
	return componentSettings.PendingLabel != "" ||
		componentSettings.PendingLabelOneWayStatePath != "" ||
		componentSettings.SucceededLabel != "" ||
		componentSettings.SucceededLabelOneWayStatePath != "" ||
		componentSettings.FailedLabel != "" ||
		componentSettings.FailedLabelOneWayStatePath != ""
}

func (componentSettings ButtonSettings) labelExpressionResolver(
	staticLabel, labelStatePath string,
) string {
	if labelStatePath != "" {
		return labelStatePath
	}
	return strconv.Quote(staticLabel)
}

func (componentSettings ButtonSettings) fallbackLabelExpressionResolver(
	staticLabel, labelStatePath, fallbackExpression string,
) string {
	if labelStatePath != "" {
		return labelStatePath
	}
	if staticLabel != "" {
		return strconv.Quote(staticLabel)
	}
	return fallbackExpression
}

type buttonLabelExpressions struct {
	Idle      string
	Pending   string
	Succeeded string
	Failed    string
}

func (componentSettings ButtonSettings) labelExpressionsResolver() buttonLabelExpressions {
	idleExpression := componentSettings.labelExpressionResolver(
		componentSettings.Label, componentSettings.LabelOneWayStatePath,
	)
	return buttonLabelExpressions{
		Idle: idleExpression,
		Pending: componentSettings.fallbackLabelExpressionResolver(
			componentSettings.PendingLabel, componentSettings.PendingLabelOneWayStatePath,
			idleExpression,
		),
		Succeeded: componentSettings.fallbackLabelExpressionResolver(
			componentSettings.SucceededLabel, componentSettings.SucceededLabelOneWayStatePath,
			idleExpression,
		),
		Failed: componentSettings.fallbackLabelExpressionResolver(
			componentSettings.FailedLabel, componentSettings.FailedLabelOneWayStatePath,
			idleExpression,
		),
	}
}

func (componentSettings ButtonSettings) countdownLabelExpressionBuilder(
	labelExpression string,
	actionLabelExpression string,
) string {
	countdownLabelExpression := "isCounting ? (" + labelExpression +
		") + \" (\" + countdownSecondsRemaining + \"s)\" : "
	if actionLabelExpression != "" {
		return countdownLabelExpression + actionLabelExpression
	}
	return countdownLabelExpression + labelExpression
}

type buttonActionExpressions struct {
	IsDisplayed        bool
	PendingExpression  string
	IconExpression     string
	LabelExpression    string
	IconLeftVisibility string
}

func (componentSettings ButtonSettings) actionExpressionsResolver() buttonActionExpressions {
	if !componentSettings.hasActionDisplay() {
		return buttonActionExpressions{}
	}
	isPendingExternallyExpression := "false"
	if componentSettings.IsPendingOneWayStatePath != "" {
		isPendingExternallyExpression = "(" + componentSettings.IsPendingOneWayStatePath + ")"
	}
	iconExpression := "actionIconResolver(" + isPendingExternallyExpression + ")"
	labelExpressions := componentSettings.labelExpressionsResolver()
	labelArguments := strings.Join([]string{
		labelExpressions.Idle,
		labelExpressions.Pending,
		labelExpressions.Succeeded,
		labelExpressions.Failed,
		isPendingExternallyExpression,
	}, ", ")
	return buttonActionExpressions{
		IsDisplayed:        true,
		PendingExpression:  "isActionPending(" + isPendingExternallyExpression + ")",
		IconExpression:     iconExpression,
		LabelExpression:    "actionLabelResolver(" + labelArguments + ")",
		IconLeftVisibility: iconExpression + " === ''",
	}
}

func (componentSettings ButtonSettings) disabledExpressionResolver(
	actionPendingExpression string,
) string {
	disabledExpressions := []string{}
	if componentSettings.IsDisabledOneWayStatePath != "" {
		disabledExpressions = append(
			disabledExpressions,
			"("+componentSettings.IsDisabledOneWayStatePath+")",
		)
	}
	if actionPendingExpression != "" {
		disabledExpressions = append(disabledExpressions, actionPendingExpression)
	}
	if componentSettings.hasCountdown() {
		disabledExpressions = append(disabledExpressions, "isCounting")
	}
	return strings.Join(disabledExpressions, " || ")
}

func (componentSettings ButtonSettings) clickExpressionResolver() string {
	isPromiseAction := componentSettings.ShouldTrackAction && !componentSettings.IsSubmit
	if !isPromiseAction {
		return componentSettings.OnClickFunc
	}
	return "trackActionPromise(" + componentSettings.OnClickFunc + ")"
}

templ buttonContent(
	componentSettings ButtonSettings,
	actionExpressions buttonActionExpressions,
	countdownLabelExpression string,
	iconSize string,
) {
	if actionExpressions.IsDisplayed {
		<i
			class={ "ph-bold " + iconSize }
			:class={ actionExpressions.IconExpression }
			x-show={ actionExpressions.IconExpression + " !== ''" }
			style="display: none"
			aria-hidden="true"
		></i>
	}
	if componentSettings.IconLeft != "" {
		<i
			class={ "ph-bold " + componentSettings.IconLeft + " " + iconSize }
			if actionExpressions.IsDisplayed {
				x-show={ actionExpressions.IconLeftVisibility }
			}
		></i>
	}
	if componentSettings.IconLeftOneWayStatePath != "" {
		<i
			class={ "ph-bold " + iconSize }
			:class={ componentSettings.IconLeftOneWayStatePath }
			if actionExpressions.IsDisplayed {
				x-show={ actionExpressions.IconLeftVisibility }
			}
		></i>
	}
	if componentSettings.hasVisibleLabel() && countdownLabelExpression != "" {
		<span x-text={ countdownLabelExpression }>
			{ componentSettings.Label }
		</span>
	}
	if componentSettings.hasVisibleLabel() && countdownLabelExpression == "" && actionExpressions.IsDisplayed {
		<span x-text={ actionExpressions.LabelExpression }>
			{ componentSettings.Label }
		</span>
	}
	if componentSettings.hasVisibleLabel() && countdownLabelExpression == "" && !actionExpressions.IsDisplayed {
		if componentSettings.LabelOneWayStatePath != "" {
			<span x-text={ componentSettings.LabelOneWayStatePath }>
				{ componentSettings.Label }
			</span>
		}
		if componentSettings.LabelOneWayStatePath == "" {
			{ componentSettings.Label }
		}
	}
	if componentSettings.IconRight != "" {
		<i class={ "ph-bold " + componentSettings.IconRight + " " + iconSize }></i>
	}
	if componentSettings.IconRightOneWayStatePath != "" {
		<i class={ "ph-bold " + iconSize } :class={ componentSettings.IconRightOneWayStatePath }></i>
	}
}

templ buttonFrame(componentSettings ButtonSettings) {
	{{ buttonWidth := "w-fit" }}
	if componentSettings.IsFullWidth {
		{{ buttonWidth = "w-full" }}
	}
	{{ hasTooltip := componentSettings.TooltipContent != "" || componentSettings.TooltipContentHtml != nil || componentSettings.TooltipContentOneWayStatePath != "" }}
	{{ tooltipId := "" }}
	if hasTooltip {
		@uiToolset.TooltipAlpineStateOnce.Once()
		{{ tooltipId = generateButtonTooltipId() }}
	}
	{{ actionExpressions := componentSettings.actionExpressionsResolver() }}
	{{ labelExpressions := componentSettings.labelExpressionsResolver() }}
	{{ disabledExpression := componentSettings.disabledExpressionResolver(actionExpressions.PendingExpression) }}
	{{ countdownLabelExpression := "" }}
	if componentSettings.hasCountdown() && componentSettings.hasVisibleLabel() {
		{{ countdownLabelExpression = componentSettings.countdownLabelExpressionBuilder(labelExpressions.Idle, actionExpressions.LabelExpression) }}
	}
	<div
		class={ "relative " + buttonWidth }
		if hasTooltip {
			x-data={ templ.JSFuncCall("tooltip", componentSettings.TooltipPosition) }
			@mouseenter="showTooltip()"
			@mouseleave="hideTooltip()"
			@focusin="showTooltip()"
			@focusout="hideTooltip()"
		}
	>
		{{ backgroundColor := "bg-neutral-50/7.5" }}
		if componentSettings.BackgroundColor != "" {
			{{ backgroundColor = "bg-" + componentSettings.BackgroundColor }}
		}
		{{ backgroundHoverColor := "hover:bg-neutral-50/12.5" }}
		if componentSettings.BackgroundColorHover != "" {
			{{ backgroundHoverColor = "hover:bg-" + componentSettings.BackgroundColorHover }}
		}
		{{ backgroundActiveColor := "" }}
		if componentSettings.BackgroundColorActive != "" {
			{{ backgroundActiveColor = "active:bg-" + componentSettings.BackgroundColorActive }}
		}
		{{ sizeTokens := buttonSizeTokensResolver(componentSettings.Size) }}
		{{ buttonPadding := sizeTokens.Padding }}
		{{ buttonTextSize := sizeTokens.TextSize }}
		if componentSettings.TextSizeClass != "" {
			{{ buttonTextSize = componentSettings.TextSizeClass }}
		}
		{{ buttonGap := sizeTokens.Gap }}
		if componentSettings.hasVisibleLabel() {
			switch componentSettings.Size {
				case ButtonSizeXs:
					{{ buttonPadding += " py-1.5" }}
				case ButtonSizeSm:
					{{ buttonPadding += " py-2" }}
				case ButtonSizeMd:
					{{ buttonPadding += " py-2.5" }}
				case ButtonSizeLg:
					{{ buttonPadding += " py-3" }}
				case ButtonSizeXl:
					{{ buttonPadding += " py-3.5" }}
				default:
					{{ buttonPadding += " py-2.5" }}
			}
		}
		if componentSettings.PaddingSize != "" {
			{{ buttonPadding = uiToolset.CompactPaddingClassResolver(componentSettings.PaddingSize, buttonPadding) }}
		}
		{{ backgroundSize := buttonPadding + " " + buttonTextSize + " " + buttonGap }}
		{{ backgroundClasses := backgroundColor + " " + backgroundHoverColor + " " + backgroundActiveColor + " " + backgroundSize }}
		{{
			sizeConstraintClasses := uiToolset.NonEmptyClassJoiner([]string{
				componentSettings.MinWidthClass, componentSettings.MaxWidthClass,
				componentSettings.MinHeightClass, componentSettings.MaxHeightClass,
			})
		}}
		if sizeConstraintClasses != "" {
			{{ sizeConstraintClasses = " " + sizeConstraintClasses }}
		}
		{{ textColor := "text-neutral-50" }}
		if componentSettings.TextColor != "" {
			{{ textColor = "text-" + componentSettings.TextColor }}
		}
		{{ textColorHover := "hover:text-neutral-50" }}
		if componentSettings.TextColorHover != "" {
			{{ textColorHover = "hover:text-" + componentSettings.TextColorHover }}
		}
		{{ textCaseClass := uiToolset.TextCaseClassResolver(componentSettings.TextCase) }}
		{{ ringClasses := "" }}
		{{ ringThicknessClass := uiToolset.RingThicknessClassResolver(componentSettings.RingThickness, "ring-1.5") }}
		if componentSettings.RingColor != "" {
			{{ ringClasses = ringThicknessClass + " ring-" + componentSettings.RingColor }}
		}
		if componentSettings.RingColorHover != "" {
			{{ ringClasses += " hover:ring-" + componentSettings.RingColorHover }}
		}
		{{ radiusRoundness := uiToolset.ShapeClassResolver(componentSettings.Shape, "rounded-md") }}
		{{ iconSize := sizeTokens.IconSize }}
		if componentSettings.IconSizeClass != "" {
			{{ iconSize = componentSettings.IconSizeClass }}
		}
		{{
			hasTopIcon := componentSettings.IconTop != "" ||
				componentSettings.IconTopOneWayStatePath != ""
		}}
		{{ buttonLayout := "flex flex-row" }}
		if hasTopIcon {
			{{ buttonLayout = "flex flex-col" }}
		}
		{{
			hasStaticRowContent := componentSettings.IconLeft != "" ||
				componentSettings.IconLeftOneWayStatePath != "" ||
				componentSettings.hasVisibleLabel() ||
				componentSettings.IconRight != "" ||
				componentSettings.IconRightOneWayStatePath != ""
		}}
		{{ hasRowContent := hasStaticRowContent || actionExpressions.IsDisplayed }}
		{{ rowVisibilityExpression := "" }}
		if !hasStaticRowContent && actionExpressions.IsDisplayed {
			{{ rowVisibilityExpression = actionExpressions.IconExpression + " !== ''" }}
		}
		{{ buttonClasses := buttonWidth + " " + backgroundClasses + " " + textColor + " " + textColorHover + " " + radiusRoundness + " " + ringClasses + sizeConstraintClasses + " justify-center items-center text-center font-bold " + buttonLayout + " leading-none transition-all" }}
		if textCaseClass != "" {
			{{ buttonClasses += " " + textCaseClass }}
		}
		{{ disabledClasses := "opacity-50 cursor-not-allowed pointer-events-none" }}
		if componentSettings.IsDisabled {
			{{ buttonClasses += " " + disabledClasses }}
		}
		{{ buttonType := "button" }}
		if componentSettings.IsSubmit {
			{{ buttonType = "submit" }}
		}
		<button
			type={ buttonType }
			if componentSettings.FormId != "" {
				form={ componentSettings.FormId }
			}
			if hasTooltip {
				x-ref="trigger"
				aria-describedby={ tooltipId }
			}
			if componentSettings.Id != "" {
				id={ componentSettings.Id }
			}
			if componentSettings.AriaLabel != "" {
				aria-label={ componentSettings.AriaLabel }
			}
			if componentSettings.AriaLabelOneWayStatePath != "" {
				:aria-label={ componentSettings.AriaLabelOneWayStatePath }
			}
			if componentSettings.AriaExpandedOneWayStatePath != "" {
				:aria-expanded={ componentSettings.AriaExpandedOneWayStatePath }
			}
			if componentSettings.OnClickFunc != "" && !componentSettings.IsDisabled {
				if componentSettings.OnClickPreventDefault {
					@click.prevent={ componentSettings.clickExpressionResolver() }
				} else {
					@click={ componentSettings.clickExpressionResolver() }
				}
			}
			if componentSettings.IsDisabled {
				disabled
			}
			if disabledExpression != "" {
				:disabled={ disabledExpression }
			}
			if actionExpressions.IsDisplayed {
				:aria-busy={ actionExpressions.PendingExpression }
			}
			if componentSettings.IsVisibleOneWayStatePath != "" {
				x-show={ componentSettings.IsVisibleOneWayStatePath }
			}
			class={ buttonClasses }
			if disabledExpression != "" {
				:class={ "(" + disabledExpression + ") && '" + disabledClasses + "'" }
			}
		>
			if hasTopIcon {
				if componentSettings.IconTop != "" {
					<i class={ "ph-bold " + componentSettings.IconTop + " " + iconSize } aria-hidden="true"></i>
				}
				if componentSettings.IconTopOneWayStatePath != "" {
					<i
						class={ "ph-bold " + iconSize }
						:class={ componentSettings.IconTopOneWayStatePath }
						aria-hidden="true"
					></i>
				}
				if hasRowContent {
					<span
						class={ "flex flex-row items-center justify-center " + buttonGap }
						if rowVisibilityExpression != "" {
							x-show={ rowVisibilityExpression }
						}
					>
						@buttonContent(componentSettings, actionExpressions, countdownLabelExpression, iconSize)
					</span>
				}
			}
			if !hasTopIcon {
				@buttonContent(componentSettings, actionExpressions, countdownLabelExpression, iconSize)
			}
		</button>
		if hasTooltip {
			{{
				tooltipSurfaceClasses := uiToolset.TooltipSurfaceClassesResolver(
					uiToolset.TooltipSurfaceSettings{
						BackgroundColor: componentSettings.TooltipBackgroundColor,
						TextColor:       componentSettings.TooltipTextColor,
						RingColor:       componentSettings.TooltipRingColor,
						RingThickness:   componentSettings.TooltipRingThickness,
						MinWidthClass:   componentSettings.TooltipMinWidthClass,
						MaxWidthClass:   componentSettings.TooltipMaxWidthClass,
						MinHeightClass:  componentSettings.TooltipMinHeightClass,
						MaxHeightClass:  componentSettings.TooltipMaxHeightClass,
					},
				)
			}}
			<template x-teleport="body">
				<div
					x-ref="tooltip"
					id={ tooltipId }
					role="tooltip"
					:style="resolvedTooltipStyle"
					class={ tooltipSurfaceClasses }
					if componentSettings.TooltipContentOneWayStatePath != "" {
						x-text={ componentSettings.TooltipContentOneWayStatePath }
					}
				>
					if componentSettings.TooltipContent != "" {
						{ componentSettings.TooltipContent }
					}
					if componentSettings.TooltipContentHtml != nil {
						@componentSettings.TooltipContentHtml
					}
				</div>
			</template>
		}
	</div>
}

type buttonActionIcons struct {
	Idle      string `json:"idle"`
	Pending   string `json:"pending"`
	Succeeded string `json:"succeeded"`
	Failed    string `json:"failed"`
}

func (componentSettings ButtonSettings) actionIconsResolver() buttonActionIcons {
	actionIcons := buttonActionIcons{
		Idle:      "",
		Pending:   "ph-spinner",
		Succeeded: "ph-check-circle",
		Failed:    "ph-warning-circle",
	}
	if componentSettings.PendingIcon != "" {
		actionIcons.Pending = componentSettings.PendingIcon
	}
	if componentSettings.SucceededIcon != "" {
		actionIcons.Succeeded = componentSettings.SucceededIcon
	}
	if componentSettings.FailedIcon != "" {
		actionIcons.Failed = componentSettings.FailedIcon
	}
	pendingAnimation := uiToolset.AnimationClassResolver(
		componentSettings.PendingIconAnimation, "animate-spin",
	)
	if pendingAnimation != "" {
		actionIcons.Pending += " " + pendingAnimation
	}
	return actionIcons
}

func (componentSettings ButtonSettings) isFormAction() bool {
	return componentSettings.ShouldTrackAction && componentSettings.IsSubmit
}

templ Button(componentSettings ButtonSettings) {
	<!-- Button -->
	if componentSettings.hasActionDisplay() || componentSettings.hasCountdown() {
		@buttonAlpineStateOnce.Once()
		<div
			class="contents"
			x-data={ templ.JSFuncCall("buttonState", componentSettings.actionIconsResolver(), componentSettings.isFormAction(), componentSettings.CountdownSeconds) }
			if componentSettings.CountdownTriggerOneWayStatePath != "" {
				x-effect={ "restartCountdownOnTrigger(" + componentSettings.CountdownTriggerOneWayStatePath + ")" }
			}
			if componentSettings.hasCountdown() && componentSettings.CountdownTriggerOneWayStatePath == "" {
				x-init="startCountdown()"
			}
		>
			@buttonFrame(componentSettings)
		</div>
	} else {
		@buttonFrame(componentSettings)
	}
}
