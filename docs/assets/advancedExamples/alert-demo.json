{"close-timeout":"<div class=\"grid gap-x-10 gap-y-6 lg:grid-cols-2\"><div class=\"flex flex-col gap-4\"><div class=\"flex flex-col gap-1\"><h5 class=\"text-base font-bold\">Close &amp; Timeout</h5><p class=\"text-sm text-neutral-400\">IsCloseable adds the dismiss button and OnCloseFunc runs when it is pressed. DisplayTimeoutSeconds auto-dismisses the alert and runs OnTimeoutFunc.</p></div><div class=\"flex flex-col gap-2\"><a href=\"https://github.com/goinfinite/ui/blob/main/src/display/alert.templ\" rel=\"help noopener noreferrer\" target=\"_blank\" title=\"View Complete Component Settings\"><h4 class=\"text-lg font-bold text-neutral-50 transition-all hover:opacity-80\">Usage <i class=\"ph-bold ph-arrow-square-out text-sm text-neutral-400\"></i></h4></a><pre class=\"rounded-md bg-neutral-800 p-4 text-xs text-wrap break-words tab-2\"><code>@uiDisplay.Alert(uiDisplay.AlertSettings{\n\tTitle:       &#34;Alert Title&#34;,\n\tDescription: &#34;This is an alert message.&#34;,\n\n\t// OptionalFields\n\tIsCloseable:           true,\n\tOnCloseFunc:           &#34;alertClosed = true&#34;,\n\tDisplayTimeoutSeconds: 8,\n\tOnTimeoutFunc:         &#34;alertTimedOut = true&#34;,\n})</code></pre></div></div><div class=\"flex flex-col gap-3\"><p class=\"text-lg font-bold\">Live Example</p><div class=\"flex flex-col gap-3\" x-data=\"{alertClosed: false, alertTimedOut: false}\"><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-base  bg-blue-500/10 text-blue-50 ring-0 rounded\" x-data=\"{ alertVisible: true }\" x-show=\"alertVisible\" role=\"alert\"><!-- AlertVariationIcon --> <i class=\"ph-info ph-duotone text-xl flex-shrink-0 mt-0.5 text-blue-400\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-base\">Closable alert</div> <!-- AlertDescription -->  <div class=\" text-base\">Press the X to dismiss it.</div></div> <!-- AlertCloseButton --> <!-- Button --><div class=\"relative w-fit\"><button type=\"button\" @click=\"alertVisible = false; alertClosed = true\" class=\"w-fit bg-neutral-50/7.5 hover:bg-neutral-50/12.5  p-1.5 text-sm gap-0.75 text-neutral-50 hover:text-neutral-50 rounded-full  justify-center items-center text-center font-bold flex flex-row leading-none transition-all\"><i class=\"ph-bold ph-x text-base\"></i> </button> </div></div><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-base  bg-yellow-500/10 text-yellow-50 ring-0 rounded\" x-data=\"{ alertVisible: true }\" x-show=\"alertVisible\" x-init=\"setTimeout(() =&gt; { alertVisible = false; alertTimedOut = true }, 8000)\" role=\"alert\"><!-- AlertVariationIcon --> <i class=\"ph-warning ph-duotone text-xl flex-shrink-0 mt-0.5 text-yellow-400\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-base\">Self-dismissing alert</div> <!-- AlertDescription -->  <div class=\" text-base\">This alert dismisses itself after 8 seconds.</div></div></div><p class=\"mt-1.5 rounded-md border border-amber-400/30 bg-amber-400/10 p-3 font-mono text-xs text-amber-100 [text-box:trim-both_cap_alphabetic]\">Closed: <span x-text=\"alertClosed\"></span> · Timed out: <span x-text=\"alertTimedOut\"></span></p></div></div></div>","content-html-slot":"<div class=\"grid gap-x-10 gap-y-6 lg:grid-cols-2\"><div class=\"flex flex-col gap-4\"><div class=\"flex flex-col gap-1\"><h5 class=\"text-base font-bold\">Content Html Slot</h5><p class=\"text-sm text-neutral-400\">ContentHtml replaces the plain description with a templ component of your own.</p></div><div class=\"flex flex-col gap-2\"><a href=\"https://github.com/goinfinite/ui/blob/main/src/display/alert.templ\" rel=\"help noopener noreferrer\" target=\"_blank\" title=\"View Complete Component Settings\"><h4 class=\"text-lg font-bold text-neutral-50 transition-all hover:opacity-80\">Usage <i class=\"ph-bold ph-arrow-square-out text-sm text-neutral-400\"></i></h4></a><pre class=\"rounded-md bg-neutral-800 p-4 text-xs text-wrap break-words tab-2\"><code>@uiDisplay.Alert(uiDisplay.AlertSettings{\n\tTitle: &#34;Deploy finished&#34;,\n\n\t// OptionalFields\n\tContentHtml: AlertDemoCustomContent(),\n})</code></pre></div></div><div class=\"flex flex-col gap-3\"><p class=\"text-lg font-bold\">Live Example</p><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-base  bg-emerald-500/10 text-emerald-50 ring-0 rounded\" role=\"alert\"><!-- AlertVariationIcon --> <i class=\"ph-check-circle ph-duotone text-xl flex-shrink-0 mt-0.5 text-emerald-400\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><div class=\"flex flex-col gap-2\"><p class=\"text-sm\">Deploy finished on <span class=\"font-mono font-bold text-emerald-300\">edge-03</span>. Wire in any templ component here.</p></div></div></div></div></div>","custom-surface":"<div class=\"grid gap-x-10 gap-y-6 lg:grid-cols-2\"><div class=\"flex flex-col gap-4\"><div class=\"flex flex-col gap-1\"><h5 class=\"text-base font-bold\">Custom Surface</h5><p class=\"text-sm text-neutral-400\">Background, text, ring, radius, shadow, and close-icon colors accept Tailwind tokens. TextTitleColor and TextDescriptionColor style the title and description separately. Gradient backgrounds work too.</p></div><div class=\"flex flex-col gap-2\"><a href=\"https://github.com/goinfinite/ui/blob/main/src/display/alert.templ\" rel=\"help noopener noreferrer\" target=\"_blank\" title=\"View Complete Component Settings\"><h4 class=\"text-lg font-bold text-neutral-50 transition-all hover:opacity-80\">Usage <i class=\"ph-bold ph-arrow-square-out text-sm text-neutral-400\"></i></h4></a><pre class=\"rounded-md bg-neutral-800 p-4 text-xs text-wrap break-words tab-2\"><code>@uiDisplay.Alert(uiDisplay.AlertSettings{\n\tTitle:       &#34;Alert Title&#34;,\n\tDescription: &#34;This is an alert message.&#34;,\n\n\t// OptionalFields\n\tBackgroundColor:          &#34;cyan-500/20&#34;,\n\tTextColor:                &#34;cyan-100&#34;,\n\tTextTitleColor:           &#34;cyan-50&#34;,\n\tTextDescriptionColor:     &#34;cyan-200&#34;,\n\tRingThickness:            uiToolset.RingThicknessLg,\n\tRingColor:                &#34;cyan-400&#34;,\n\tShadowSize:               uiToolset.ShadowSizeXl,\n\tBorderRadius:             uiToolset.BorderRadiusLg,\n\tCloseIconBackgroundColor: &#34;cyan-500/30&#34;,\n\tCloseIconTextColor:       &#34;white&#34;,\n})</code></pre></div></div><div class=\"flex flex-col gap-3\"><p class=\"text-lg font-bold\">Live Example</p><div class=\"flex flex-col gap-3\"><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-sm  bg-cyan-500/20 text-cyan-100 ring-2.5 ring-cyan-400 rounded-lg shadow-xl\" x-data=\"{ alertVisible: true }\" x-show=\"alertVisible\" role=\"alert\"><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-sm text-cyan-50\">Neon Glow Alert</div> <!-- AlertDescription -->  <div class=\" text-sm text-cyan-200\">This alert glows with neon colors!</div></div> <!-- AlertCloseButton --> <!-- Button --><div class=\"relative w-fit\"><button type=\"button\" @click=\"alertVisible = false; \" class=\"w-fit bg-cyan-500/30 hover:bg-neutral-50/12.5  p-1 text-xs gap-0.5 text-white hover:text-neutral-50 rounded-full  justify-center items-center text-center font-bold flex flex-row leading-none transition-all\"><i class=\"ph-bold ph-x text-base\"></i> </button> </div></div><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-xs  bg-gradient-to-r from-purple-500/20 via-pink-500/20 to-red-500/20 text-white ring-0 rounded\" x-data=\"{ alertVisible: true }\" x-show=\"alertVisible\" role=\"alert\"><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-xs\">Gradient Alert</div> <!-- AlertDescription -->  <div class=\" text-xs\">This alert uses a gradient background!</div></div> <!-- AlertCloseButton --> <!-- Button --><div class=\"relative w-fit\"><button type=\"button\" @click=\"alertVisible = false; \" class=\"w-fit bg-red-500/20 hover:bg-neutral-50/12.5  p-1 text-xs gap-0.5 text-white hover:text-neutral-50 rounded-full  justify-center items-center text-center font-bold flex flex-row leading-none transition-all\"><i class=\"ph-bold ph-x text-base\"></i> </button> </div></div></div></div></div>","icons":"<div class=\"grid gap-x-10 gap-y-6 lg:grid-cols-2\"><div class=\"flex flex-col gap-4\"><div class=\"flex flex-col gap-1\"><h5 class=\"text-base font-bold\">Icons</h5><p class=\"text-sm text-neutral-400\">TitleLeftIcon replaces the variation icon on the left. TitleRightIcon adds an icon on the right. The TwoWayStatePath variants bind the icon classes to Alpine state.</p></div><div class=\"flex flex-col gap-2\"><a href=\"https://github.com/goinfinite/ui/blob/main/src/display/alert.templ\" rel=\"help noopener noreferrer\" target=\"_blank\" title=\"View Complete Component Settings\"><h4 class=\"text-lg font-bold text-neutral-50 transition-all hover:opacity-80\">Usage <i class=\"ph-bold ph-arrow-square-out text-sm text-neutral-400\"></i></h4></a><pre class=\"rounded-md bg-neutral-800 p-4 text-xs text-wrap break-words tab-2\"><code>@uiDisplay.Alert(uiDisplay.AlertSettings{\n\tTitle:          &#34;Rocket deploy&#34;,\n\tDescription:    &#34;TitleLeftIcon and TitleRightIcon frame the content.&#34;,\n\tTitleLeftIcon:  &#34;ph-rocket-launch&#34;,\n\tTitleRightIcon: &#34;ph-arrow-right&#34;,\n})</code></pre></div></div><div class=\"flex flex-col gap-3\"><p class=\"text-lg font-bold\">Live Example</p><div class=\"flex flex-col gap-3\" x-data=\"{alertLeftIcon: 'ph-rocket-launch', alertRightIcon: 'ph-arrow-right'}\"><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-base  bg-blue-500/10 text-blue-50 ring-0 rounded\" role=\"alert\"><!-- AlertLeftIcon --> <i class=\"ph-duotone ph-rocket-launch ph-duotone text-xl flex-shrink-0 mt-0.5 text-blue-400\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-base\">Static icons</div> <!-- AlertDescription -->  <div class=\" text-base\">The left and right icons frame the content.</div></div><!-- AlertRightIcon --> <i class=\"ph-duotone ph-arrow-right ph-duotone text-xl flex-shrink-0 mt-0.5 text-blue-400\"></i> </div><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-base  bg-emerald-500/10 text-emerald-50 ring-0 rounded\" role=\"alert\"><!-- AlertLeftIcon --> <i class=\"ph-duotone  ph-duotone text-xl flex-shrink-0 mt-0.5 text-emerald-400\" :class=\"alertLeftIcon\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-base\">State-bound icons</div> <!-- AlertDescription -->  <div class=\" text-base\">The icon classes come from Alpine state.</div></div><!-- AlertRightIcon --> <i class=\"ph-duotone  ph-duotone text-xl flex-shrink-0 mt-0.5 text-emerald-400\" :class=\"alertRightIcon\"></i> </div><!-- Button --><div class=\"relative w-fit\"><button type=\"button\" @click=\"alertLeftIcon = alertLeftIcon === &#39;ph-rocket-launch&#39; ? &#39;ph-bell&#39; : &#39;ph-rocket-launch&#39;; alertRightIcon = alertRightIcon === &#39;ph-arrow-right&#39; ? &#39;ph-arrow-left&#39; : &#39;ph-arrow-right&#39;\" class=\"w-fit bg-neutral-50/7.5 hover:bg-neutral-50/12.5  p-1.5 py-2 text-sm gap-0.75 text-neutral-50 hover:text-neutral-50 rounded-md  justify-center items-center text-center font-bold flex flex-row leading-none transition-all\"><i class=\"ph-bold ph-arrows-clockwise text-base\"></i> Switch Icons </button> </div></div></div></div>","sizes":"<div class=\"grid gap-x-10 gap-y-6 lg:grid-cols-2\"><div class=\"flex flex-col gap-4\"><div class=\"flex flex-col gap-1\"><h5 class=\"text-base font-bold\">Sizes</h5><p class=\"text-sm text-neutral-400\">Size scales the alert padding and type: xs, sm, md, lg, or xl. MaxWidth caps the width with a Tailwind size token.</p></div><div class=\"flex flex-col gap-2\"><a href=\"https://github.com/goinfinite/ui/blob/main/src/display/alert.templ\" rel=\"help noopener noreferrer\" target=\"_blank\" title=\"View Complete Component Settings\"><h4 class=\"text-lg font-bold text-neutral-50 transition-all hover:opacity-80\">Usage <i class=\"ph-bold ph-arrow-square-out text-sm text-neutral-400\"></i></h4></a><pre class=\"rounded-md bg-neutral-800 p-4 text-xs text-wrap break-words tab-2\"><code>@uiDisplay.Alert(uiDisplay.AlertSettings{\n\tTitle:       &#34;Alert Title&#34;,\n\tDescription: &#34;This is an alert message.&#34;,\n\tVariation:   uiDisplay.AlertVariationInfo,\n\tSize:        uiDisplay.AlertSizeMd,\n\tMaxWidth:    &#34;md&#34;,\n})</code></pre></div></div><div class=\"flex flex-col gap-3\"><p class=\"text-lg font-bold\">Live Example</p><div class=\"flex flex-col gap-3\"><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-xs max-w-md bg-blue-500/10 text-blue-50 ring-0 rounded\" role=\"alert\"><!-- AlertVariationIcon --> <i class=\"ph-info ph-duotone text-sm flex-shrink-0 mt-0.5 text-blue-400\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-xs\">xs</div> <!-- AlertDescription -->  <div class=\" text-xs\">This is an alert message.</div></div></div><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-sm max-w-md bg-blue-500/10 text-blue-50 ring-0 rounded\" role=\"alert\"><!-- AlertVariationIcon --> <i class=\"ph-info ph-duotone text-base flex-shrink-0 mt-0.5 text-blue-400\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-sm\">sm</div> <!-- AlertDescription -->  <div class=\" text-sm\">This is an alert message.</div></div></div><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-base max-w-md bg-blue-500/10 text-blue-50 ring-0 rounded\" role=\"alert\"><!-- AlertVariationIcon --> <i class=\"ph-info ph-duotone text-xl flex-shrink-0 mt-0.5 text-blue-400\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-base\">md</div> <!-- AlertDescription -->  <div class=\" text-base\">This is an alert message.</div></div></div><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-lg max-w-md bg-blue-500/10 text-blue-50 ring-0 rounded\" role=\"alert\"><!-- AlertVariationIcon --> <i class=\"ph-info ph-duotone text-2xl flex-shrink-0 mt-0.5 text-blue-400\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-lg\">lg</div> <!-- AlertDescription -->  <div class=\" text-lg\">This is an alert message.</div></div></div><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-xl max-w-md bg-blue-500/10 text-blue-50 ring-0 rounded\" role=\"alert\"><!-- AlertVariationIcon --> <i class=\"ph-info ph-duotone text-3xl flex-shrink-0 mt-0.5 text-blue-400\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-xl\">xl</div> <!-- AlertDescription -->  <div class=\" text-xl\">This is an alert message.</div></div></div></div></div></div>","state-bound-content":"<div class=\"grid gap-x-10 gap-y-6 lg:grid-cols-2\"><div class=\"flex flex-col gap-4\"><div class=\"flex flex-col gap-1\"><h5 class=\"text-base font-bold\">State-Bound Content</h5><p class=\"text-sm text-neutral-400\">TitleOneWayStatePath, DescriptionOneWayStatePath, and IsCloseableOneWayStatePath drive the alert from Alpine state.</p></div><div class=\"flex flex-col gap-2\"><a href=\"https://github.com/goinfinite/ui/blob/main/src/display/alert.templ\" rel=\"help noopener noreferrer\" target=\"_blank\" title=\"View Complete Component Settings\"><h4 class=\"text-lg font-bold text-neutral-50 transition-all hover:opacity-80\">Usage <i class=\"ph-bold ph-arrow-square-out text-sm text-neutral-400\"></i></h4></a><pre class=\"rounded-md bg-neutral-800 p-4 text-xs text-wrap break-words tab-2\"><code>@uiDisplay.Alert(uiDisplay.AlertSettings{\n\tTitle:                      &#34;Dynamic Content Alert&#34;,\n\tTitleOneWayStatePath:       &#34;alertTitle&#34;,\n\tDescriptionOneWayStatePath: &#34;alertMessage&#34;,\n\tVariation:                  uiDisplay.AlertVariationInfo,\n\n\t// OptionalFields\n\tIsCloseableOneWayStatePath: &#34;isAlertCloseable&#34;,\n})</code></pre></div></div><div class=\"flex flex-col gap-3\"><p class=\"text-lg font-bold\">Live Example</p><div class=\"grid gap-6 md:grid-cols-2\" x-data=\"{alertTitle: 'Dynamic Content Alert', alertMessage: 'Dynamic alert content!', isAlertCloseable: true}\"><div class=\"flex flex-col gap-3\"><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-base  bg-blue-500/10 text-blue-50 ring-0 rounded\" x-data=\"{ alertVisible: true }\" x-show=\"alertVisible\" role=\"alert\"><!-- AlertVariationIcon --> <i class=\"ph-info ph-duotone text-xl flex-shrink-0 mt-0.5 text-blue-400\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-base\" x-text=\"alertTitle\">Dynamic Content Alert</div> <!-- AlertDescription -->  <div class=\" text-base\" x-text=\"alertMessage\"></div></div> <!-- AlertCloseButton --> <!-- Button --><div class=\"relative w-fit\"><button type=\"button\" @click=\"alertVisible = false; \" class=\"w-fit bg-neutral-50/7.5 hover:bg-neutral-50/12.5  p-1.5 text-sm gap-0.75 text-neutral-50 hover:text-neutral-50 rounded-full  justify-center items-center text-center font-bold flex flex-row leading-none transition-all\"><i class=\"ph-bold ph-x text-base\"></i> </button> </div></div><div class=\"flex gap-2\"><!-- Button --><div class=\"relative w-fit\"><button type=\"button\" @click=\"alertTitle = &#39;Title updated at &#39; + new Date().toLocaleTimeString(); alertMessage = &#39;Message updated at &#39; + new Date().toLocaleTimeString()\" class=\"w-fit bg-neutral-50/7.5 hover:bg-neutral-50/12.5  p-1.5 py-2 text-sm gap-0.75 text-neutral-50 hover:text-neutral-50 rounded-md  justify-center items-center text-center font-bold flex flex-row leading-none transition-all\"><i class=\"ph-bold ph-pencil text-base\"></i> Change Content </button> </div></div></div><div class=\"flex flex-col gap-3\"><!-- Alert HTML --><div class=\"flex w-full items-start gap-3 p-4 text-base  bg-yellow-500/10 text-yellow-50 ring-0 rounded\" role=\"alert\"><!-- AlertVariationIcon --> <i class=\"ph-warning ph-duotone text-xl flex-shrink-0 mt-0.5 text-yellow-400\"></i><!-- AlertContent --><div class=\"flex-1 flex flex-col gap-0.5\"><!-- AlertTitle -->  <div class=\"font-semibold text-base\">Conditional Close Button</div> <!-- AlertDescription -->  <div class=\" text-base\">This alert's close button can be toggled!</div></div> <!-- AlertCloseButton --> <!-- Button --><div class=\"relative w-fit\"><button type=\"button\" @click=\"alertVisible = false; \" x-show=\"isAlertCloseable\" class=\"w-fit bg-yellow-500/20 hover:bg-neutral-50/12.5  p-1.5 text-sm gap-0.75 text-yellow-100 hover:text-neutral-50 rounded-full  justify-center items-center text-center font-bold flex flex-row leading-none transition-all\"><i class=\"ph-bold ph-x text-base\"></i> </button> </div></div><div class=\"flex gap-2\"><!-- Button --><div class=\"relative w-fit\"><button type=\"button\" @click=\"isAlertCloseable = !isAlertCloseable\" class=\"w-fit bg-neutral-50/7.5 hover:bg-neutral-50/12.5  p-1.5 py-2 text-sm gap-0.75 text-neutral-50 hover:text-neutral-50 rounded-md  justify-center items-center text-center font-bold flex flex-row leading-none transition-all\"><i class=\"ph-bold ph-toggle-left text-base\"></i> Toggle Close Button </button> </div></div></div></div></div></div>"}
