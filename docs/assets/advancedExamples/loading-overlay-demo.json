{"background-color":"<div class=\"grid gap-x-10 gap-y-6 lg:grid-cols-2\"><div class=\"flex flex-col gap-4\"><div class=\"flex flex-col gap-1\"><h5 class=\"text-base font-bold\">Background Color</h5><p class=\"text-sm text-neutral-400\">BackgroundColor paints the veil over the content.</p></div><div class=\"flex flex-col gap-2\"><a href=\"https://github.com/goinfinite/ui/blob/main/src/display/loadingOverlay.templ\" rel=\"help noopener noreferrer\" target=\"_blank\" title=\"View Complete Component Settings\"><h4 class=\"text-lg font-bold text-neutral-50 transition-all hover:opacity-80\">Usage <i class=\"ph-bold ph-arrow-square-out text-sm text-neutral-400\"></i></h4></a><pre class=\"rounded-md bg-neutral-800 p-4 text-xs text-wrap break-words tab-2\"><code>@uiDisplay.LoadingOverlay(uiDisplay.LoadingOverlaySettings{\n\tIsLoadingOneWayStatePath: &#34;isLoading&#34;,\n\n\t// OptionalFields\n\tBackgroundColor: &#34;neutral-900/80&#34;,\n})</code></pre></div></div><div class=\"flex flex-col gap-3\"><p class=\"text-lg font-bold\">Live Example</p><div class=\"relative h-64 overflow-hidden rounded-md border border-neutral-800 bg-neutral-50/5\" x-data=\"{isBackgroundLoading: false}\"><div class=\"flex h-full flex-col items-center justify-center gap-4 p-8\"><p class=\"text-center text-sm text-neutral-400\">The overlay covers this content while it loads.</p><!-- Button --><div class=\"relative w-fit\"><button type=\"button\" @click=\"isBackgroundLoading = true; setTimeout(() =&gt; isBackgroundLoading = false, 3000)\" class=\"w-fit bg-neutral-50/7.5 hover:bg-neutral-50/12.5  p-1.5 py-2 text-sm gap-0.75 text-neutral-50 hover:text-neutral-50 rounded-md  justify-center items-center text-center font-bold flex flex-row leading-none transition-all\"><i class=\"ph-bold ph-play text-base\"></i> Trigger Loading (3s) </button> </div></div><!-- LoadingOverlay CSS --><style type=\"text/css\">.htmx-request #loading-overlay-demo-background,.htmx-request#loading-overlay-demo-background{opacity:1 !important;visibility:visible !important}</style><!-- LoadingOverlay HTML --><div id=\"loading-overlay-demo-background\" class=\"z-100 fixed top-0 left-0 h-full w-full items-center justify-center flex transition-all duration-300 bg-neutral-900/80\" style=\"opacity: 0; visibility: hidden;\" :style=\"isBackgroundLoading ? &#39;opacity: 1; visibility: visible&#39; : &#39;opacity: 0; visibility: hidden&#39;\"><i class=\"ph-duotone ph-compass-rose text-5xl animate-spin animate-duration-[2s]\"></i></div></div></div></div>","icon-animation":"<div class=\"grid gap-x-10 gap-y-6 lg:grid-cols-2\"><div class=\"flex flex-col gap-4\"><div class=\"flex flex-col gap-1\"><h5 class=\"text-base font-bold\">Icon &amp; Animation</h5><p class=\"text-sm text-neutral-400\">Icon replaces the spinner. IconSize scales it. AnimationName spins or pulses it over AnimationDurationSeconds.</p></div><div class=\"flex flex-col gap-2\"><a href=\"https://github.com/goinfinite/ui/blob/main/src/display/loadingOverlay.templ\" rel=\"help noopener noreferrer\" target=\"_blank\" title=\"View Complete Component Settings\"><h4 class=\"text-lg font-bold text-neutral-50 transition-all hover:opacity-80\">Usage <i class=\"ph-bold ph-arrow-square-out text-sm text-neutral-400\"></i></h4></a><pre class=\"rounded-md bg-neutral-800 p-4 text-xs text-wrap break-words tab-2\"><code>@uiDisplay.LoadingOverlay(uiDisplay.LoadingOverlaySettings{\n\tIsLoadingOneWayStatePath: &#34;isLoading&#34;,\n\n\t// OptionalFields\n\tIcon:                     &#34;ph-compass-rose&#34;,\n\tIconSize:                 uiDisplay.LoadingOverlayIconSizeMd,\n\tAnimationName:            uiDisplay.LoadingOverlayAnimationNameSpin,\n\tAnimationDurationSeconds: &#34;2&#34;,\n})</code></pre></div></div><div class=\"flex flex-col gap-3\"><p class=\"text-lg font-bold\">Live Example</p><div class=\"relative h-64 overflow-hidden rounded-md border border-neutral-800 bg-neutral-50/5\" x-data=\"{isIconLoading: false}\"><div class=\"flex h-full flex-col items-center justify-center gap-4 p-8\"><p class=\"text-center text-sm text-neutral-400\">The overlay covers this content while it loads.</p><!-- Button --><div class=\"relative w-fit\"><button type=\"button\" @click=\"isIconLoading = true; setTimeout(() =&gt; isIconLoading = false, 3000)\" class=\"w-fit bg-neutral-50/7.5 hover:bg-neutral-50/12.5  p-1.5 py-2 text-sm gap-0.75 text-neutral-50 hover:text-neutral-50 rounded-md  justify-center items-center text-center font-bold flex flex-row leading-none transition-all\"><i class=\"ph-bold ph-play text-base\"></i> Trigger Loading (3s) </button> </div></div><!-- LoadingOverlay CSS --><style type=\"text/css\">.htmx-request #loading-overlay-demo-icon,.htmx-request#loading-overlay-demo-icon{opacity:1 !important;visibility:visible !important}</style><!-- LoadingOverlay HTML --><div id=\"loading-overlay-demo-icon\" class=\"z-100 fixed top-0 left-0 h-full w-full items-center justify-center flex transition-all duration-300 bg-primary-500/60\" style=\"opacity: 0; visibility: hidden;\" :style=\"isIconLoading ? &#39;opacity: 1; visibility: visible&#39; : &#39;opacity: 0; visibility: hidden&#39;\"><i class=\"ph-duotone ph-compass-rose text-5xl animate-spin animate-duration-[2s]\"></i></div></div></div></div>"}
