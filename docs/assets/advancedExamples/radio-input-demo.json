{"colors":"<div class=\"grid gap-x-10 gap-y-6 lg:grid-cols-2\"><div class=\"flex flex-col gap-4\"><div class=\"flex flex-col gap-1\"><h5 class=\"text-base font-bold\">Colors</h5><p class=\"text-sm text-neutral-400\">Style sets the idle text color, the checked and hover color, and the keyboard focus ring around the icon.</p></div><div class=\"flex flex-col gap-2\"><a href=\"https://github.com/goinfinite/ui/blob/main/src/form/radioInput.templ\" rel=\"help noopener noreferrer\" target=\"_blank\" title=\"View Complete Component Settings\"><h4 class=\"text-lg font-bold text-neutral-50 transition-all hover:opacity-80\">Usage <i class=\"ph-bold ph-arrow-square-out text-sm text-neutral-400\"></i></h4></a><pre class=\"rounded-md bg-neutral-800 p-4 text-xs text-wrap break-words tab-2\"><code>@uiForm.RadioInput(uiForm.RadioInputSettings{\n\tLabel:           &#34;Option 1&#34;,\n\tStateValue:      &#34;option1&#34;,\n\tTwoWayStatePath: &#34;selectedOption&#34;,\n\n\t// OptionalFields\n\tStyle: uiForm.RadioInputStyle{\n\t\tActiveColor:    &#34;violet-400&#34;,\n\t\tFocusRingColor: &#34;violet-400&#34;,\n\t\tTextColor:      &#34;violet-100&#34;,\n\t},\n})</code></pre></div></div><div class=\"flex flex-col gap-3\"><p class=\"text-lg font-bold\">Live Example</p><div class=\"flex flex-col gap-2\" x-data=\"{selectedOption: 'option1'}\"><!-- RadioInput --><div class=\"hover:text-violet-400 inline-flex items-center text-violet-100\" @click=\"selectedOption = &#34;option1&#34;\"><label class=\"flex flex-row select-none gap-1 cursor-pointer items-center text-sm \" :class=\"String(selectedOption) == &#34;option1&#34; &amp;&amp; &#34;text-violet-400 font-bold&#34;\"><input type=\"radio\" value=\"option1\" x-model=\"selectedOption\" class=\"peer sr-only\"><i class=\"ph-duotone rounded-full peer-focus-visible:ring-2 peer-focus-visible:ring-violet-400 text-xl\" :class=\"String(selectedOption) == &#34;option1&#34; ? &#34;ph-check-circle&#34; : &#34;ph-circle&#34;\"></i>Option 1</label></div><!-- RadioInput --><div class=\"hover:text-violet-400 inline-flex items-center text-violet-100\" @click=\"selectedOption = &#34;option2&#34;\"><label class=\"flex flex-row select-none gap-1 cursor-pointer items-center text-sm \" :class=\"String(selectedOption) == &#34;option2&#34; &amp;&amp; &#34;text-violet-400 font-bold&#34;\"><input type=\"radio\" value=\"option2\" x-model=\"selectedOption\" class=\"peer sr-only\"><i class=\"ph-duotone rounded-full peer-focus-visible:ring-2 peer-focus-visible:ring-violet-400 text-xl\" :class=\"String(selectedOption) == &#34;option2&#34; ? &#34;ph-check-circle&#34; : &#34;ph-circle&#34;\"></i>Option 2</label></div><p class=\"mt-1.5 rounded-md border border-amber-400/30 bg-amber-400/10 p-3 font-mono text-xs text-amber-100 [text-box:trim-both_cap_alphabetic]\">Value: <span x-text=\"selectedOption\"></span></p></div></div></div>","sizes":"<div class=\"grid gap-x-10 gap-y-6 lg:grid-cols-2\"><div class=\"flex flex-col gap-4\"><div class=\"flex flex-col gap-1\"><h5 class=\"text-base font-bold\">Sizes</h5><p class=\"text-sm text-neutral-400\">Size scales the radio and its label: xs, sm, md, lg, or xl. TextCase transforms the label, and InputName names the radio in the form.</p></div><div class=\"flex flex-col gap-2\"><a href=\"https://github.com/goinfinite/ui/blob/main/src/form/radioInput.templ\" rel=\"help noopener noreferrer\" target=\"_blank\" title=\"View Complete Component Settings\"><h4 class=\"text-lg font-bold text-neutral-50 transition-all hover:opacity-80\">Usage <i class=\"ph-bold ph-arrow-square-out text-sm text-neutral-400\"></i></h4></a><pre class=\"rounded-md bg-neutral-800 p-4 text-xs text-wrap break-words tab-2\"><code>@uiForm.RadioInput(uiForm.RadioInputSettings{\n\tLabel:           &#34;Option 1&#34;,\n\tStateValue:      &#34;option1&#34;,\n\tTwoWayStatePath: &#34;selectedOption&#34;,\n\n\t// OptionalFields\n\tInputName: &#34;options&#34;,\n\tSize:      uiForm.RadioInputSizeMd,\n\tTextCase:  uiToolset.TextCaseUpper,\n})</code></pre></div></div><div class=\"flex flex-col gap-3\"><p class=\"text-lg font-bold\">Live Example</p><div class=\"flex flex-col gap-3\" x-data=\"{selectedOption: 'option1'}\"><!-- RadioInput --><div class=\"hover:text-secondary-500 inline-flex items-center text-neutral-100\" @click=\"selectedOption = &#34;xs&#34;\"><label class=\"flex flex-row select-none gap-1 cursor-pointer items-center text-xs uppercase\" :class=\"String(selectedOption) == &#34;xs&#34; &amp;&amp; &#34;text-secondary-500 font-bold&#34;\"><input type=\"radio\" name=\"options\" value=\"xs\" x-model=\"selectedOption\" class=\"peer sr-only\"><i class=\"ph-duotone rounded-full peer-focus-visible:ring-2 peer-focus-visible:ring-secondary-500 text-lg\" :class=\"String(selectedOption) == &#34;xs&#34; ? &#34;ph-check-circle&#34; : &#34;ph-circle&#34;\"></i>xs</label></div><!-- RadioInput --><div class=\"hover:text-secondary-500 inline-flex items-center text-neutral-100\" @click=\"selectedOption = &#34;sm&#34;\"><label class=\"flex flex-row select-none gap-1 cursor-pointer items-center text-sm uppercase\" :class=\"String(selectedOption) == &#34;sm&#34; &amp;&amp; &#34;text-secondary-500 font-bold&#34;\"><input type=\"radio\" name=\"options\" value=\"sm\" x-model=\"selectedOption\" class=\"peer sr-only\"><i class=\"ph-duotone rounded-full peer-focus-visible:ring-2 peer-focus-visible:ring-secondary-500 text-xl\" :class=\"String(selectedOption) == &#34;sm&#34; ? &#34;ph-check-circle&#34; : &#34;ph-circle&#34;\"></i>sm</label></div><!-- RadioInput --><div class=\"hover:text-secondary-500 inline-flex items-center text-neutral-100\" @click=\"selectedOption = &#34;md&#34;\"><label class=\"flex flex-row select-none gap-1 cursor-pointer items-center text-base uppercase\" :class=\"String(selectedOption) == &#34;md&#34; &amp;&amp; &#34;text-secondary-500 font-bold&#34;\"><input type=\"radio\" name=\"options\" value=\"md\" x-model=\"selectedOption\" class=\"peer sr-only\"><i class=\"ph-duotone rounded-full peer-focus-visible:ring-2 peer-focus-visible:ring-secondary-500 text-2xl\" :class=\"String(selectedOption) == &#34;md&#34; ? &#34;ph-check-circle&#34; : &#34;ph-circle&#34;\"></i>md</label></div><!-- RadioInput --><div class=\"hover:text-secondary-500 inline-flex items-center text-neutral-100\" @click=\"selectedOption = &#34;lg&#34;\"><label class=\"flex flex-row select-none gap-1 cursor-pointer items-center text-lg uppercase\" :class=\"String(selectedOption) == &#34;lg&#34; &amp;&amp; &#34;text-secondary-500 font-bold&#34;\"><input type=\"radio\" name=\"options\" value=\"lg\" x-model=\"selectedOption\" class=\"peer sr-only\"><i class=\"ph-duotone rounded-full peer-focus-visible:ring-2 peer-focus-visible:ring-secondary-500 text-3xl\" :class=\"String(selectedOption) == &#34;lg&#34; ? &#34;ph-check-circle&#34; : &#34;ph-circle&#34;\"></i>lg</label></div><!-- RadioInput --><div class=\"hover:text-secondary-500 inline-flex items-center text-neutral-100\" @click=\"selectedOption = &#34;xl&#34;\"><label class=\"flex flex-row select-none gap-1 cursor-pointer items-center text-xl uppercase\" :class=\"String(selectedOption) == &#34;xl&#34; &amp;&amp; &#34;text-secondary-500 font-bold&#34;\"><input type=\"radio\" name=\"options\" value=\"xl\" x-model=\"selectedOption\" class=\"peer sr-only\"><i class=\"ph-duotone rounded-full peer-focus-visible:ring-2 peer-focus-visible:ring-secondary-500 text-4xl\" :class=\"String(selectedOption) == &#34;xl&#34; ? &#34;ph-check-circle&#34; : &#34;ph-circle&#34;\"></i>xl</label></div></div></div></div>"}
