package main

import (
	uiDisplay "github.com/goinfinite/ui/src/display"
	uiForm "github.com/goinfinite/ui/src/form"
	uiToolset "github.com/goinfinite/ui/src/toolset"
)

func multiColumnRepeatableFieldsetDemoColumns() []uiForm.MultiColumnRepeatableFieldsetColumn {
	return []uiForm.MultiColumnRepeatableFieldsetColumn{
		{
			Id: "name", Label: "Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText, IsRequired: true,
		},
		{
			Id: "role", Label: "Role", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
			Options: []uiForm.SelectLabelValueOption{
				{Label: "Owner", Value: "owner"},
				{Label: "Maintainer", Value: "maintainer"},
				{Label: "Member", Value: "member"},
			},
		},
		{
			Id: "age", Label: "Age", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeNumber,
			Min: "0", Max: "120", Step: "1",
		},
		{
			Id: "active", Label: "Active", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeCheckbox,
		},
	}
}

templ MultiColumnRepeatableFieldsetValidationExample() {
	{{
		validationUsage := `@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
	Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
		{Id: "name", Label: "Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText, IsRequired: true},
		{Id: "email", Label: "Email", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText, IsRequired: true},
	},
	TwoWayStatePath: "contactRows",
})`
	}}
	@DemoExampleCard(
		"Per-Row Validation",
		"Each row validates on its own. A required cell with an empty value paints a red border and sets aria-invalid until the user fills it.",
		"/form/multiColumnRepeatableFieldset.templ", validationUsage,
	) {
		<div x-data="{contactRows: [{name: '', email: ''}, {name: 'Ana Souza', email: 'ana@example.com'}]}">
			@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
				Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
					{
						Id: "name", Label: "Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText,
						IsRequired: true,
					},
					{
						Id: "email", Label: "Email", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText,
						IsRequired: true,
					},
				},
				TwoWayStatePath: "contactRows",
			})
		</div>
	}
}

templ MultiColumnRepeatableFieldsetEmptyStateExample() {
	{{
		emptyStateUsage := `@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
	Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
		{Id: "hostPort", Label: "Host port", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeNumber, Min: "1", Max: "65535"},
		{Id: "protocol", Label: "Protocol", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect, Options: protocolOptions},
	},
	TwoWayStatePath: "portRows",

	// OptionalFields
	AddRowLabel:     "Add port mapping",
	EmptyStateLabel: "No port mappings yet",
})`
	}}
	@DemoExampleCard(
		"Empty State",
		"With no rows the table shows the empty-state row. AddRowLabel and EmptyStateLabel replace the default Add row and No rows yet texts.",
		"/form/multiColumnRepeatableFieldset.templ", emptyStateUsage,
	) {
		<div x-data="{portRows: []}">
			@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
				Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
					{
						Id: "hostPort", Label: "Host port", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeNumber,
						Min: "1", Max: "65535", Step: "1",
					},
					{
						Id: "protocol", Label: "Protocol", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
						Options: []uiForm.SelectLabelValueOption{
							{Label: "TCP", Value: "tcp"},
							{Label: "UDP", Value: "udp"},
						},
					},
				},
				TwoWayStatePath: "portRows",
				AddRowLabel:     "Add port mapping",
				EmptyStateLabel: "No port mappings yet",
			})
		</div>
	}
}

templ multiColumnRepeatableFieldsetBulkEditEnvExample() {
	{{
		bulkEditUsage := `@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
	Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
		{Id: "name", Label: "Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText, IsRequired: true},
		{Id: "value", Label: "Value", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText},
	},
	TwoWayStatePath: "envVarRows",

	// OptionalFields
	BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
		IsEnabled:     true,
		TextAreaLabel: "Environment variables",
		HintValue:     "One variable per line, in NAME=value form. Blank lines are ignored.",
	},
})`
	}}
	@DemoExampleCard(
		"Environment Variables",
		"Bulk edit turns the rows into one textarea line per row, so a whole block can be pasted at once. For two columns the default delimiter is =, and blank lines are ignored. A text-only row with every cell empty is skipped.",
		"/form/multiColumnRepeatableFieldset.templ", bulkEditUsage,
	) {
		<div
			class="flex flex-col gap-3"
			x-data="{envVarRows: [{name: 'APP_ENV', value: 'production'}, {name: 'LOG_LEVEL', value: 'info'}]}"
		>
			@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
				Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
					{
						Id: "name", Label: "Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText,
						IsRequired: true,
					},
					{
						Id: "value", Label: "Value", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText,
					},
				},
				TwoWayStatePath: "envVarRows",
				BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
					IsEnabled:     true,
					TextAreaLabel: "Environment variables",
					HintValue:     "One variable per line, in NAME=value form. Blank lines are ignored.",
				},
			})
			<p class={ DemoLiveStateClasses }>
				envVarRows: <span x-text="JSON.stringify(envVarRows)"></span>
			</p>
		</div>
	}
}

templ multiColumnRepeatableFieldsetBulkEditTypedExample() {
	{{
		typedBulkEditUsage := `@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
	Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
		{Id: "name", Label: "Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText},
		{Id: "role", Label: "Role", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
			Options: []uiForm.SelectLabelValueOption{{Label: "Owner", Value: "owner"}, {Label: "Member", Value: "member"}}},
		{Id: "enabled", Label: "Enabled", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeCheckbox},
	},
	TwoWayStatePath: "typedBulkRows",
	InputName:       "typedBulkRows",

	// OptionalFields
	BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
		IsEnabled:     true,
		TextAreaLabel: "Typed rows",
		HintValue:     "One row per line, in name|role|enabled form.",
	},
})`
	}}
	@DemoExampleCard(
		"Typed Columns",
		"The default | delimiter and the checkbox and select cells round-trip through the same textarea. The hidden input carries the parsed rows as JSON.",
		"/form/multiColumnRepeatableFieldset.templ", typedBulkEditUsage,
	) {
		<div
			class="flex flex-col gap-3"
			x-data="{typedBulkRows: [{name: 'Ana', role: 'owner', enabled: true}]}"
		>
			@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
				Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
					{Id: "name", Label: "Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText},
					{
						Id: "role", Label: "Role", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
						Options: []uiForm.SelectLabelValueOption{
							{Label: "Owner", Value: "owner"},
							{Label: "Member", Value: "member"},
						},
					},
					{Id: "enabled", Label: "Enabled", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeCheckbox},
				},
				TwoWayStatePath: "typedBulkRows",
				InputName:       "typedBulkRows",
				BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
					IsEnabled:     true,
					TextAreaLabel: "Typed rows",
					HintValue:     "One row per line, in name|role|enabled form.",
				},
			})
			<p class={ DemoLiveStateClasses }>
				typedBulkRows: <span x-text="JSON.stringify(typedBulkRows)"></span>
			</p>
		</div>
	}
}

templ multiColumnRepeatableFieldsetBulkEditPortBindingExample() {
	{{
		portBindingBulkEditUsage := `@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
	Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
		{Id: "serviceName", Label: "Service Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
			Options: []uiForm.SelectLabelValueOption{{Label: "Web", Value: "web"}, {Label: "Custom", Value: "custom"}}},
		{Id: "publicPort", Label: "Public Port", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText},
		{Id: "containerPort", Label: "Container Port", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText},
		{Id: "protocol", Label: "Protocol", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
			Options: []uiForm.SelectLabelValueOption{{Label: "TCP", Value: "tcp"}, {Label: "UDP", Value: "udp"}}},
	},
	TwoWayStatePath: "portBindingRows",
	InputName:       "portBindingRows",

	// OptionalFields
	BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
		IsEnabled:     true,
		TextAreaLabel: "Port bindings",
	},
})`
	}}
	@DemoExampleCard(
		"Port Bindings",
		"Four columns default to the | delimiter, so a block of service|publicPort|containerPort|protocol lines can be pasted at once. The hidden input carries the parsed rows as JSON.",
		"/form/multiColumnRepeatableFieldset.templ", portBindingBulkEditUsage,
	) {
		<div
			class="flex flex-col gap-3"
			x-data="{portBindingRows: [{serviceName: 'web', publicPort: '8080', containerPort: '80', protocol: 'tcp'}]}"
		>
			@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
				Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
					{
						Id: "serviceName", Label: "Service Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
						Options: []uiForm.SelectLabelValueOption{
							{Label: "Web", Value: "web"},
							{Label: "Custom", Value: "custom"},
						},
					},
					{Id: "publicPort", Label: "Public Port", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText},
					{Id: "containerPort", Label: "Container Port", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText},
					{
						Id: "protocol", Label: "Protocol", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
						Options: []uiForm.SelectLabelValueOption{
							{Label: "TCP", Value: "tcp"},
							{Label: "UDP", Value: "udp"},
						},
					},
				},
				TwoWayStatePath: "portBindingRows",
				InputName:       "portBindingRows",
				BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
					IsEnabled:     true,
					TextAreaLabel: "Port bindings",
				},
			})
			<p class={ DemoLiveStateClasses + " break-all" }>
				portBindingRows: <span x-text="JSON.stringify(portBindingRows)"></span>
			</p>
		</div>
	}
}

templ multiColumnRepeatableFieldsetBulkEditCustomDelimiterExample() {
	{{
		customDelimiterUsage := `@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
	Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
		{Id: "name", Label: "Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText},
		{Id: "role", Label: "Role", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
			Options: []uiForm.SelectLabelValueOption{{Label: "Owner", Value: "owner"}, {Label: "Member", Value: "member"}}},
		{Id: "enabled", Label: "Enabled", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeCheckbox},
	},
	TwoWayStatePath: "customDelimiterRows",
	InputName:       "customDelimiterRows",

	// OptionalFields
	BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
		IsEnabled:     true,
		Delimiter:     ";",
		TextAreaLabel: "Contact rows",
	},
})`
	}}
	@DemoExampleCard(
		"Custom Delimiter",
		"Set Delimiter to override the default. This three-column example uses ; and still parses checkbox and select cells. The hidden input carries the parsed rows as JSON.",
		"/form/multiColumnRepeatableFieldset.templ", customDelimiterUsage,
	) {
		<div
			class="flex flex-col gap-3"
			x-data="{customDelimiterRows: [{name: 'Ana', role: 'owner', enabled: true}]}"
		>
			@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
				Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
					{Id: "name", Label: "Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText},
					{
						Id: "role", Label: "Role", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
						Options: []uiForm.SelectLabelValueOption{
							{Label: "Owner", Value: "owner"},
							{Label: "Member", Value: "member"},
						},
					},
					{Id: "enabled", Label: "Enabled", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeCheckbox},
				},
				TwoWayStatePath: "customDelimiterRows",
				InputName:       "customDelimiterRows",
				BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
					IsEnabled:     true,
					Delimiter:     ";",
					TextAreaLabel: "Contact rows",
				},
			})
			<p class={ DemoLiveStateClasses }>
				customDelimiterRows: <span x-text="JSON.stringify(customDelimiterRows)"></span>
			</p>
		</div>
	}
}

templ MultiColumnRepeatableFieldsetDelimiterExample() {
	<div class="flex flex-col gap-6">
		@multiColumnRepeatableFieldsetBulkEditEnvExample()
		@multiColumnRepeatableFieldsetBulkEditTypedExample()
		@multiColumnRepeatableFieldsetBulkEditPortBindingExample()
		@multiColumnRepeatableFieldsetBulkEditCustomDelimiterExample()
	</div>
}

templ MultiColumnRepeatableFieldsetSizesExample() {
	{{
		sizesUsage := `@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
	Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
		{Id: "hostPort", Label: "Host port", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeNumber, Min: "1", Max: "65535"},
		{Id: "protocol", Label: "Protocol", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect, Options: protocolOptions},
	},
	TwoWayStatePath: "portRows",

	// OptionalFields
	Size: uiForm.InputFieldSizeXs,
})`
	}}
	@DemoExampleCard(
		"Sizes",
		"Size takes an InputFieldSize* constant and applies it to every cell: the text and number fields, the select, and the checkbox. The select dropdown surface follows the Dropdown style group.",
		"/form/multiColumnRepeatableFieldset.templ", sizesUsage,
	) {
		<div x-data="{portRows: [{hostPort: '8080', protocol: 'tcp'}]}">
			@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
				Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
					{
						Id: "hostPort", Label: "Host port", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeNumber,
						Min: "1", Max: "65535", Step: "1",
					},
					{
						Id: "protocol", Label: "Protocol", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
						Options: []uiForm.SelectLabelValueOption{
							{Label: "TCP", Value: "tcp"},
							{Label: "UDP", Value: "udp"},
						},
					},
				},
				TwoWayStatePath: "portRows",
				Size:            uiForm.InputFieldSizeXs,
			})
		</div>
	}
}

templ MultiColumnRepeatableFieldsetAppearanceExample() {
	{{
		appearanceUsage := `@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
	Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
		{Id: "host", Label: "Host", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText},
		{Id: "protocol", Label: "Protocol", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect, Options: protocolOptions},
		{Id: "enabled", Label: "Enabled", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeCheckbox},
	},
	TwoWayStatePath: "endpointRows",

	// OptionalFields
	AddRowButton: uiForm.MultiColumnRepeatableFieldsetAddRowButtonStyle{
		BackgroundColor:      "emerald-500",
		BackgroundColorHover: "emerald-400",
		IconLeft:             "ph-plus-circle",
		Shape:                uiToolset.ShapeCircular,
		TextColor:            "neutral-950",
		TextColorHover:       "neutral-950",
	},
	AddRowLabel: "Add endpoint",
	BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
		IsEnabled:       true,
		ButtonIcon:      "ph-clipboard-text",
		ButtonLabel:     "Paste endpoints",
		TableButtonIcon: "ph-table",
		TableButtonLabel: "Show endpoints",
	},
	BulkEditButton: uiForm.MultiColumnRepeatableFieldsetBulkEditButtonStyle{
		BackgroundColor:      "neutral-50/5",
		BackgroundColorHover: "neutral-50/10",
		Shape:                uiToolset.ShapeSquare,
		TextColor:            "emerald-400",
		TextColorHover:       "emerald-300",
	},
	Checkbox: uiForm.MultiColumnRepeatableFieldsetCheckboxStyle{
		CheckedColor: "emerald-500",
		Shape:        uiToolset.ShapeCircular,
	},
	Dropdown: uiForm.MultiColumnRepeatableFieldsetDropdownStyle{
		BackgroundColor: "neutral-900",
		BorderColor:     "neutral-50/20",
	},
	Select: uiForm.MultiColumnRepeatableFieldsetSelectStyle{
		SelectedIconColor: "emerald-400",
		Trigger: uiForm.SelectInputTriggerStyle{
			BackgroundColor: "neutral-50/5",
			BorderColor:     "neutral-50/10",
		},
	},
})`
	}}
	@DemoExampleCard(
		"Appearance",
		"Each cell type carries its own style group. Checkbox sets the checked and unchecked colors, the focus ring, and the shape. Select sets the trigger surface and the checked-option icon color, and Dropdown paints the option list. AddRowButton and BulkEditButton set the action button label, icon, color, and shape.",
		"/form/multiColumnRepeatableFieldset.templ", appearanceUsage,
	) {
		<div x-data="{endpointRows: [{host: 'api.internal', protocol: 'https', enabled: true}]}">
			@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
				Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
					{
						Id: "host", Label: "Host", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText,
					},
					{
						Id: "protocol", Label: "Protocol", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect,
						Options: []uiForm.SelectLabelValueOption{
							{Label: "HTTPS", Value: "https"},
							{Label: "HTTP", Value: "http"},
						},
					},
					{
						Id: "enabled", Label: "Enabled", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeCheckbox,
					},
				},
				TwoWayStatePath: "endpointRows",
				AddRowButton: uiForm.MultiColumnRepeatableFieldsetAddRowButtonStyle{
					BackgroundColor:      "emerald-500",
					BackgroundColorHover: "emerald-400",
					IconLeft:             "ph-plus-circle",
					Shape:                uiToolset.ShapeCircular,
					TextColor:            "neutral-950",
					TextColorHover:       "neutral-950",
				},
				AddRowLabel: "Add endpoint",
				BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
					IsEnabled:        true,
					ButtonIcon:       "ph-clipboard-text",
					ButtonLabel:      "Paste endpoints",
					TableButtonIcon:  "ph-table",
					TableButtonLabel: "Show endpoints",
				},
				BulkEditButton: uiForm.MultiColumnRepeatableFieldsetBulkEditButtonStyle{
					BackgroundColor:      "neutral-50/5",
					BackgroundColorHover: "neutral-50/10",
					Shape:                uiToolset.ShapeSquare,
					TextColor:            "emerald-400",
					TextColorHover:       "emerald-300",
				},
				Checkbox: uiForm.MultiColumnRepeatableFieldsetCheckboxStyle{
					CheckedColor: "emerald-500",
					Shape:        uiToolset.ShapeCircular,
				},
				Dropdown: uiForm.MultiColumnRepeatableFieldsetDropdownStyle{
					BackgroundColor: "neutral-900",
					BorderColor:     "neutral-50/20",
				},
				Select: uiForm.MultiColumnRepeatableFieldsetSelectStyle{
					SelectedIconColor: "emerald-400",
					Trigger: uiForm.SelectInputTriggerStyle{
						BackgroundColor: "neutral-50/5",
						BorderColor:     "neutral-50/10",
					},
				},
			})
		</div>
	}
}

templ MultiColumnRepeatableFieldsetDemo() {
	{{
		demoUsage := `@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
	Columns: []uiForm.MultiColumnRepeatableFieldsetColumn{
		{Id: "name", Label: "Name", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeText, IsRequired: true},
		{Id: "role", Label: "Role", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeSelect, Options: roleOptions},
		{Id: "age", Label: "Age", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeNumber, Min: "0", Max: "120"},
		{Id: "active", Label: "Active", InputType: uiForm.MultiColumnRepeatableFieldsetColumnTypeCheckbox},
	},
	TwoWayStatePath: "teamMemberRows",

	// OptionalFields
	BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
		IsEnabled: true,
	},
	InputName:  "teamMembers",
	NewRowFunc: "multiColumnRepeatableFieldsetDemoRandomRow()",
})`
	}}
	<div class="flex flex-col gap-4" id="multi-column-repeatable-fieldset-demo">
		@DemoComponentSection(DemoComponentSectionSettings{
			ComponentPath:          "/form/multiColumnRepeatableFieldset.templ",
			Description:            "A repeatable fieldset renders one editable row per item, each cell rendered through the matching input component: InputField, SelectInput, or CheckboxInput. Rows live in an Alpine array path: add, duplicate, move, and remove actions operate on that path. NewRowFunc names the expression that fills a new row, so different rows stay tellable apart.",
			LiveExampleDescription: "A team member table bound to teamMemberRows. Add row appends a random member, so moving a row up or down is visible. Bulk edit is enabled, so the same rows can be pasted as one line per member. The bound array is shown live.",
			Title:                  ".MultiColumnRepeatableFieldset",
			UsageCode:              demoUsage,
		}) {
			@uiToolset.MinifierTemplateJs(&multiColumnRepeatableFieldsetDemoAlpineState)
			<div x-data="{teamMemberRows: [{name: 'Ana Souza', role: 'owner', age: '38', active: true}]}" class="flex flex-col gap-3">
				@uiForm.MultiColumnRepeatableFieldset(uiForm.MultiColumnRepeatableFieldsetSettings{
					Columns:         multiColumnRepeatableFieldsetDemoColumns(),
					TwoWayStatePath: "teamMemberRows",
					BulkEdit: uiForm.MultiColumnRepeatableFieldsetBulkEditSettings{
						IsEnabled: true,
					},
					InputName:  "teamMembers",
					NewRowFunc: "multiColumnRepeatableFieldsetDemoRandomRow()",
				})
				<p class={ DemoLiveStateClasses }>
					teamMemberRows: <span x-text="JSON.stringify(teamMemberRows)"></span>
				</p>
			</div>
		}
		@DemoAdvancedExamples("multi-column-repeatable-fieldset-demo", []uiDisplay.AccordionItemSettings{
			{Title: "Per-Row Validation", Icon: "ph-warning-circle", Content: MultiColumnRepeatableFieldsetValidationExample()},
			{Title: "Empty State", Icon: "ph-empty", Content: MultiColumnRepeatableFieldsetEmptyStateExample()},
			{Title: "Delimiters", Icon: "ph-text-align-left", Content: MultiColumnRepeatableFieldsetDelimiterExample()},
			{Title: "Sizes", Icon: "ph-ruler", Content: MultiColumnRepeatableFieldsetSizesExample()},
			{Title: "Appearance", Icon: "ph-palette", Content: MultiColumnRepeatableFieldsetAppearanceExample()},
		})
	</div>
}
