package main

import (
	uiControl "github.com/goinfinite/ui/src/control"
	uiDisplay "github.com/goinfinite/ui/src/display"
	uiForm "github.com/goinfinite/ui/src/form"
	uiImport "github.com/goinfinite/ui/src/import"
	uiStructural "github.com/goinfinite/ui/src/structural"
	uiToolset "github.com/goinfinite/ui/src/toolset"
)

const (
	DemoPreCodeClasses   string = "rounded-md bg-neutral-800 p-4 text-xs text-wrap tab-2"
	DemoLiveStateClasses string = "rounded-md border border-amber-400/30 bg-amber-400/10 px-3 py-2 font-mono text-xs text-amber-100"
	UiVersion            string = "0.2.1"
)

templ DemoIndex() {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<title>Infinite UI Demo</title>
			<meta charset="utf-8"/>
			<script type="text/javascript">window.__unocss={theme:{colors:{primary:{50:'#edfcff',100:'#d7f6ff',200:'#b8f0ff',300:'#86eaff',400:'#4edbff',500:'#25c2ff',600:'#0da6ff',700:'#0993f8',800:'#0d6fc0',900:'#115e97',950:'#10395b'},secondary:{50:"#dea893",100:"#d89a81",200:"#d38b6f",300:"#cd7d5d",400:"#ca7654",500:"#c97350",600:"#c46f4d",700:"#ba6949",800:"#a55e41",900:"#905239",950:"#7c4631"}}}};</script>
			@uiImport.HeadTagsFull()
		</head>
		<body class="bg-neutral-900 text-neutral-50 flex">
			<!-- Navigation Sidebar -->
			<div x-data="{isDemoSidebarCollapsed: $persist(false).as('uiDemo.isSidebarCollapsed')}">
				@DemoNavigationSidebar()
			</div>
			<main class="container mx-auto flex flex-col gap-20">
				<!-- Demo Header -->
				<section class="flex flex-col items-center justify-between gap-4 overflow-y-auto mt-20" id="demo-header">
					<h1 class="text-center text-5xl font-bold">Infinite UI Demo</h1>
					<p class="text-center text-sm text-neutral-400">
						<i><a href="https://goinfinite.net" target="_blank" rel="noopener noreferrer" title="goinfinite.net">Infinite</a></i> UI is a collection of reusable components for building elegant user interfaces in Go.
						<br/>
						It is built with <i>a-h/templ</i>, <i>Alpine.js</i>, <i>Tailwind CSS</i>, <i>Phosphor Icons</i> and the occasional additional JavaScript libraries when necessary.
					</p>
					<div class="flex flex-row items-center gap-2">
						<a href="https://github.com/goinfinite/ui" target="_blank" rel="noopener noreferrer" title="GitHub Repository">
							<img src="https://img.shields.io/badge/repository-262626?logo=github" alt="GitHub Repository"/>
						</a>
						<a href="https://github.com/orgs/goinfinite/discussions" target="_blank" rel="noopener noreferrer" title="GitHub Discussions">
							<img src="https://img.shields.io/badge/discussions-751A3D?logo=github" alt="GitHub Discussions"/>
						</a>
						<a href="https://www.reddit.com/r/goinfinite/" target="_blank" rel="noopener noreferrer" title="Reddit Subreddit">
							<img src="https://img.shields.io/badge/%2Fr%2Fgoinfinite-FF4500?logo=reddit&logoColor=ffffff" alt="Reddit Subreddit"/>
						</a>
						<a href="https://sonarcloud.io/project/overview?id=goinfinite_ui" target="_blank" rel="noopener noreferrer" title="Quality Gate Status">
							<img src="https://sonarcloud.io/api/project_badges/measure?project=goinfinite_ui&metric=alert_status" alt="Quality Gate Status"/>
						</a>
						<a href="https://github.com/goinfinite/ui/blob/main/LICENSE.md" target="_blank" rel="noopener noreferrer" title="License">
							<img src="https://img.shields.io/badge/license-MIT-teal.svg" alt="License"/>
						</a>
					</div>
				</section>
				<!-- Main Content -->
				<section class="flex flex-col gap-30 p-4" id="main-content">
					<div class="flex flex-col gap-10">
						<!-- uiForm -->
						<div id="ui-form-section" class="flex flex-col gap-2">
							<h2 class="text-3xl font-bold">
								{ `@uiForm` }
							</h2>
							<p class="text-sm text-neutral-400">
								uiForm is a collection of components that make it easy to create forms.
							</p>
						</div>
						<div class="*:border-t *:border-neutral-800 *:py-20 flex flex-col">
							@CheckboxInputDemo()
							@InlineRadioGroupDemo()
							@InputFieldDemo()
							@MultiSelectInputDemo()
							@RadioInputDemo()
							@SelectInputDemo()
							@TextAreaDemo()
							@ToggleSwitchDemo()
						</div>
					</div>
					<!-- uiDisplay -->
					<div class="flex flex-col gap-10">
						<div id="ui-display-section" class="flex flex-col gap-2">
							<h2 class="text-3xl font-bold">
								{ `@uiDisplay` }
							</h2>
							<p class="text-sm text-neutral-400">
								uiDisplay is a collection of components for displaying content.
							</p>
						</div>
						<div class="*:border-t *:border-neutral-800 *:py-20 flex flex-col">
							@AccordionDemo()
							@AlertDemo()
							@CloakLoadingDemo()
							@LoadingOverlayDemo()
							@ModalDemo()
							@SidebarDemo()
							@TagDemo()
							@ToastDemo()
						</div>
					</div>
					<!-- uiControl -->
					<div class="flex flex-col gap-10">
						<div id="ui-control-section" class="flex flex-col gap-2">
							<h2 class="text-3xl font-bold">
								{ `@uiControl` }
							</h2>
							<p class="text-sm text-neutral-400">
								uiControl is a collection of components for controlling content.
							</p>
						</div>
						<div class="*:border-t *:border-neutral-800 *:py-20 flex flex-col">
							@ButtonDemo()
							@RangeSliderDemo()
						</div>
					</div>
					<!-- uiStructural -->
					<div class="flex flex-col gap-10">
						<div id="ui-structural-section" class="flex flex-col gap-2">
							<h2 class="text-3xl font-bold">
								{ `@uiStructural` }
							</h2>
							<p class="text-sm text-neutral-400">
								uiStructural is a collection of components for navigating and displaying structured data.
							</p>
						</div>
						<div class="*:border-t *:border-neutral-800 *:py-20 flex flex-col">
							@DataTableDemo()
							@FilterBarDemo()
							@PaginationDemo()
						</div>
					</div>
				</section>
			</main>
			@uiDisplay.CloakLoading(uiDisplay.CloakLoadingSettings{BackgroundColor: "rgb(38, 38, 38)"})
		</body>
	</html>
}

templ DemoNavigationSidebar() {
	@uiStructural.Sidebar(uiStructural.SidebarSettings{
		MiddleContent:              DemoNavigationContent(),
		HeaderContent:              DemoNavigationHeader(),
		BackgroundColor:            "bg-neutral-800/50",
		IsCollapsedTwoWayStatePath: "isDemoSidebarCollapsed",
		Width:                      "w-46",
		AttachmentMode:             uiStructural.SidebarAttachmentModeFixed,
	})
}

templ DemoNavigationHeader() {
	<div class="mx-auto flex flex-col items-center justify-center gap-4 py-4">
		<!-- UI Logo -->
		<div class="flex flex-col items-center justify-center gap-1">
			<a
				href="#"
				@click="document.documentElement.scrollTop = 0"
				title="Infinite UI"
				:class="isDemoSidebarCollapsed ? 'w-12' : 'w-24'"
			>
				<img src="https://ui.demo.goinfinite.net/assets/ui-logo.svg" alt="Infinite UI" class="fill-white"/>
			</a>
			<p class="text-center text-[0.5rem]">v{ UiVersion }</p>
		</div>
	</div>
}

templ DemoNavItem(label, targetId, icon string) {
	<li>
		<a
			href={ templ.SafeURL("#" + targetId) }
			class="group relative flex cursor-pointer items-center gap-2 rounded"
			:class="{'px-3 hover:bg-neutral-50/5 py-2':!isDemoSidebarCollapsed}"
			title={ label }
		>
			<div
				class="group-hover:text-secondary-500 flex items-center justify-center rounded bg-neutral-50/5 transition-colors group-hover:bg-neutral-50/10"
				:class="isDemoSidebarCollapsed ? 'p-2' : 'p-1.5'"
			>
				<i
					class={ "ph-duotone " + icon + " block text-2xl" }
					:class="{'text-xl': !isDemoSidebarCollapsed}"
				></i>
			</div>
			<span
				class="group-hover:text-secondary-500 select-none text-sm"
				:class="{'hidden' : isDemoSidebarCollapsed}"
			>
				{ label }
			</span>
		</a>
	</li>
}

templ DemoNavSection(label string) {
	<li
		class="select-none px-3 pb-1 pt-4 text-xs font-bold text-neutral-400"
		:class="{'hidden': isDemoSidebarCollapsed}"
	>
		{ label }
	</li>
}

templ DemoNavigationContent() {
	<ul
		class="flex flex-col gap-0.5 py-4"
		:class="isDemoSidebarCollapsed && 'gap-2 items-center'"
	>
		@DemoNavSection("@uiForm")
		@DemoNavItem("CheckboxInput", "checkbox-input-demo", "ph-check-square")
		@DemoNavItem("InlineRadioGroup", "inline-radio-group-demo", "ph-selection")
		@DemoNavItem("InputField", "input-field-demo", "ph-text-aa")
		@DemoNavItem("MultiSelectInput", "multi-select-input-demo", "ph-list-checks")
		@DemoNavItem("RadioInput", "radio-input-demo", "ph-radio-button")
		@DemoNavItem("SelectInput", "select-input-demo", "ph-caret-down")
		@DemoNavItem("TextArea", "text-area-demo", "ph-text-align-left")
		@DemoNavItem("ToggleSwitch", "toggle-switch-demo", "ph-toggle-right")
		@DemoNavSection("@uiDisplay")
		@DemoNavItem("Accordion", "accordion-demo", "ph-list")
		@DemoNavItem("Alert", "alert-demo", "ph-warning")
		@DemoNavItem("CloakLoading", "cloak-loading-demo", "ph-eye-slash")
		@DemoNavItem("LoadingOverlay", "loading-overlay-demo", "ph-spinner")
		@DemoNavItem("Modal", "modal-demo", "ph-square")
		@DemoNavItem("Sidebar", "sidebar-demo", "ph-sidebar")
		@DemoNavItem("Tag", "tag-demo", "ph-tag")
		@DemoNavItem("Toast", "toast-demo", "ph-bell")
		@DemoNavSection("@uiControl")
		@DemoNavItem("Button", "button-demo", "ph-cursor")
		@DemoNavItem("RangeSlider", "range-slider-demo", "ph-sliders")
		@DemoNavSection("@uiStructural")
		@DemoNavItem("DataTable", "data-table-demo", "ph-table")
		@DemoNavItem("FilterBar", "filter-bar-demo", "ph-funnel")
		@DemoNavItem("Pagination", "pagination-demo", "ph-caret-double-right")
	</ul>
}

templ UsageTitle(componentPath string) {
	<a
		href={ "https://github.com/goinfinite/ui/blob/main/src" + templ.SafeURL(componentPath) }
		rel="help noopener noreferrer"
		target="_blank"
		title="View Complete Component Settings"
	>
		<h4 class="text-lg font-bold text-neutral-50 transition-all hover:opacity-80">
			Usage
			<i class="ph-bold ph-arrow-square-out text-sm text-neutral-400"></i>
		</h4>
	</a>
}

templ CheckboxInputDemo() {
	<div class="flex flex-col gap-4" id="checkbox-input-demo">
		<div class="flex flex-col gap-2">
			<h3 class="text-xl font-bold">.CheckboxInput</h3>
			<p class="text-sm text-neutral-400">
				A checkbox selects one value, bound to a boolean or an array state path.
			</p>
		</div>
		<div class="grid gap-10 md:grid-cols-2">
			<div class="flex flex-col gap-4">
				<div class="flex flex-col gap-2">
					@UsageTitle("/form/checkboxInput.templ")
					<pre class={ DemoPreCodeClasses }>
						<code>
							{ `@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
	Label:           "Accept the terms",
	TwoWayStatePath: "hasAcceptedTerms",

	// OptionalFields
	InputName: "hasAcceptedTerms",
	Shape:     uiForm.CheckboxInputShapeRounded,
})` }
						</code>
					</pre>
				</div>
				<div class="flex flex-col gap-2">
					<h5 class="text-sm font-bold">Alpine.js Parent State <i>(x-data)</i></h5>
					<pre class={ DemoPreCodeClasses }>
						<code>
							{ `<div x-data="{hasAcceptedTerms: false}"></div>
<div x-data="{selectedFruits: ['apple']}"></div>` }
						</code>
					</pre>
				</div>
			</div>
			<div class="flex flex-col gap-6">
				<h4 class="text-lg font-bold">Live Examples</h4>
				<div
					x-data="{hasAcceptedTerms: false}"
					class="flex flex-col gap-3"
				>
					<h5 class="text-sm font-bold">Boolean state</h5>
					@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
						Label:           "Accept the terms",
						InputName:       "hasAcceptedTerms",
						TwoWayStatePath: "hasAcceptedTerms",
					})
					<p class={ DemoLiveStateClasses }>
						Value: <span x-text="hasAcceptedTerms"></span>
					</p>
				</div>
				<div
					x-data="{selectedFruits: ['apple'], fruitOptions: ['apple', 'banana', 'orange']}"
					class="flex flex-col gap-3"
				>
					<h5 class="text-sm font-bold">Indeterminate state</h5>
					@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
						Label:                        "Select all",
						IndeterminateOneWayStatePath: "selectedFruits.length > 0 && selectedFruits.length < fruitOptions.length",
						IsCheckedOneWayStatePath:     "selectedFruits.length === fruitOptions.length",
						OnChangeFunc:                 "selectedFruits = selectedFruits.length === fruitOptions.length ? [] : [...fruitOptions]",
					})
					for _, fruitOption := range []string{"apple", "banana", "orange"} {
						@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
							Label:           fruitOption,
							TwoWayStatePath: "selectedFruits",
							Value:           fruitOption,
						})
					}
					<p class={ DemoLiveStateClasses }>
						Values: <span x-text="selectedFruits"></span>
					</p>
				</div>
			</div>
		</div>
		<div
			x-data="{isCheckboxExampleEnabled: false}"
			class="grid gap-10 md:grid-cols-2"
		>
			<div class="flex flex-col gap-3">
				<p class="text-sm text-neutral-400">Shapes</p>
				for _, checkboxShape := range []string{uiForm.CheckboxInputShapeSquare, uiForm.CheckboxInputShapeRounded, uiForm.CheckboxInputShapeCircular} {
					@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
						Label:           checkboxShape,
						TwoWayStatePath: "isCheckboxExampleEnabled",
						Shape:           checkboxShape,
					})
				}
				<p class="mt-3 text-sm text-neutral-400">Sizes</p>
				for _, checkboxSize := range []string{uiForm.CheckboxInputSizeXs, uiForm.CheckboxInputSizeSm, uiForm.CheckboxInputSizeMd, uiForm.CheckboxInputSizeLg, uiForm.CheckboxInputSizeXl} {
					@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
						Label:           checkboxSize,
						TwoWayStatePath: "isCheckboxExampleEnabled",
						Size:            checkboxSize,
					})
				}
			</div>
			<div class="flex flex-col gap-3">
				<p class="text-sm text-neutral-400">Label position</p>
				@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
					Label:           "Label on the left",
					LabelPosition:   uiForm.CheckboxInputLabelPositionLeft,
					TwoWayStatePath: "isCheckboxExampleEnabled",
				})
				<p class="mt-3 text-sm text-neutral-400">States</p>
				@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
					Label:     "Checked",
					IsChecked: true,
				})
				@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
					Label:      "Disabled",
					IsDisabled: true,
				})
				@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
					Label:      "Checked and disabled",
					IsChecked:  true,
					IsDisabled: true,
				})
				@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
					Label:      "Required",
					IsRequired: true,
				})
				<p class="mt-3 text-sm text-neutral-400">Checked colors</p>
				@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
					CheckedColor: "primary-500",
					Label:        "Primary",
					IsChecked:    true,
				})
				@uiForm.CheckboxInput(uiForm.CheckboxInputSettings{
					CheckedColor: "emerald-500",
					Label:        "Emerald",
					IsChecked:    true,
				})
			</div>
		</div>
	</div>
}

templ InputFieldDemo() {
	<div class="flex flex-col gap-4" id="input-field-demo">
		<div class="flex flex-row flex-wrap items-center gap-x-20 gap-y-10">
			<div class="flex flex-col gap-2">
				<h3 class="text-xl font-bold">.InputField</h3>
				<p class="text-sm text-neutral-400">
					An input field is a basic form element that allows users to enter text.
				</p>
			</div>
			<div class="flex flex-col gap-2">
				@UsageTitle("/form/inputField.templ")
				<pre class={ DemoPreCodeClasses }>
					<code>
						{ `@uiForm.InputField(uiForm.InputFieldSettings{
	InputType: uiForm.InputTypeText,
	InputName: "name",
	Label:     "Name",

	// OptionalFields
	TwoWayStatePath: "name",
})` }
					</code>
				</pre>
			</div>
			<div class="flex flex-col gap-2">
				<h5 class="text-sm font-bold">Alpine.js Parent State <i>(x-data)</i></h5>
				<pre class={ DemoPreCodeClasses }>
					<code>{ `<div x-data="{name: ''}"></div>` }</code>
				</pre>
			</div>
		</div>
		<div class="flex flex-col gap-4" x-data="{name: ''}">
			<h4 class="mb-2 text-lg font-bold">Live Example</h4>
			<div class="lg:*:max-w-50 flex flex-row flex-wrap items-start justify-between gap-10">
				<div class="flex flex-col gap-2">
					<p class="text-sm text-neutral-400">Basic Input</p>
					@uiForm.InputField(uiForm.InputFieldSettings{
						InputType:       uiForm.InputTypeText,
						InputName:       "name",
						Label:           "Name",
						TwoWayStatePath: "name",
					})
				</div>
				<div class="flex flex-col gap-2">
					<p class="text-sm text-neutral-400">Value & IsReadOnly</p>
					@uiForm.InputField(uiForm.InputFieldSettings{
						InputType:  uiForm.InputTypeText,
						InputName:  "name",
						Label:      "Name",
						Value:      "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
						IsReadOnly: true,
					})
				</div>
				<div class="flex flex-col gap-2">
					<p class="text-sm text-neutral-400">InputTypeNumberMin, Max & Step</p>
					@uiForm.InputField(uiForm.InputFieldSettings{
						InputType:       uiForm.InputTypeNumber,
						InputName:       "name",
						Label:           "Name",
						TwoWayStatePath: "name",
						InputNumberMin:  "0",
						InputNumberMax:  "100",
						InputNumberStep: ".1",
					})
				</div>
				<div class="flex flex-col gap-2">
					<p class="text-sm text-neutral-400">AffixLeftValue & AffixRightValue</p>
					@uiForm.InputField(uiForm.InputFieldSettings{
						InputType:       uiForm.InputTypeText,
						InputName:       "name",
						Label:           "Name",
						TwoWayStatePath: "name",
						AffixLeftValue:  "goinfinite.dev/",
					})
					@uiForm.InputField(uiForm.InputFieldSettings{
						InputType:       uiForm.InputTypeText,
						InputName:       "name",
						Label:           "Name",
						TwoWayStatePath: "name",
						AffixRightValue: ".jpg",
					})
				</div>
				<div class="flex flex-col gap-2">
					<p class="text-sm text-neutral-400">HintValue & HintDisplay</p>
					@uiForm.InputField(uiForm.InputFieldSettings{
						InputType:       uiForm.InputTypeText,
						InputName:       "name",
						Label:           "Name",
						TwoWayStatePath: "name",
						HintValue:       "This is a helpful hint displayed as a description below the input.",
						HintDisplay:     uiForm.InputHintDisplayDescription,
					})
					@uiForm.InputField(uiForm.InputFieldSettings{
						InputType:       uiForm.InputTypeText,
						InputName:       "name",
						Label:           "Name",
						TwoWayStatePath: "name",
						HintValue:       "This is a helpful hint displayed as a tooltip.",
						HintDisplay:     uiForm.InputHintDisplayTooltip,
					})
				</div>
				<div class="flex flex-col gap-2">
					<p class="text-sm text-neutral-400">HintIconStyle</p>
					@uiForm.InputField(uiForm.InputFieldSettings{
						InputType:       uiForm.InputTypeText,
						InputName:       "name",
						Label:           "Name",
						TwoWayStatePath: "name",
						HintValue:       "This is a helpful hint displayed as a boxed tooltip.",
						HintDisplay:     uiForm.InputHintDisplayTooltip,
						HintIconStyle:   uiForm.InputHintIconStyleBoxed,
					})
				</div>
			</div>
		</div>
	</div>
}

templ TextAreaDemo() {
	<div class="flex flex-col gap-4" id="text-area-demo">
		<div class="flex flex-col gap-2">
			<h3 class="text-xl font-bold">.TextArea</h3>
			<p class="text-sm text-neutral-400">
				A textarea is a form element that allows users to enter multiple lines of text.
			</p>
		</div>
		<div class="grid gap-10 md:grid-cols-2">
			<div class="flex flex-col gap-4">
				<div class="flex flex-col gap-2">
					@UsageTitle("/form/textArea.templ")
					<pre class={ DemoPreCodeClasses }>
						<code>
							{ `@uiForm.TextArea(uiForm.TextAreaSettings{
	InputName: "description",
	Label:     "Description",

	// OptionalFields
	TwoWayStatePath: "description",
	IsRequired:      false,
	IsReadOnly:      false,
})` }
						</code>
					</pre>
				</div>
				<div class="flex flex-col gap-2">
					<h5 class="text-sm font-bold">Alpine.js Parent State <i>(x-data)</i></h5>
					<pre class={ DemoPreCodeClasses }>
						<code>{ `<div x-data="{description: ''}"></div>` }</code>
					</pre>
				</div>
			</div>
			<div x-data="{description: '', hintText: 'First hint text.'}" class="flex flex-col gap-4">
				<h4 class="text-lg font-bold">Live Example</h4>
				@uiForm.TextArea(uiForm.TextAreaSettings{
					InputName:       "description",
					Label:           "Description",
					TwoWayStatePath: "description",
				})
				<div class="mt-4 flex flex-col gap-2">
					<p class="text-sm text-neutral-400">Value & IsReadOnly</p>
					@uiForm.TextArea(uiForm.TextAreaSettings{
						InputName:  "description",
						Label:      "Description",
						Value:      "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.",
						IsReadOnly: true,
					})
				</div>
				<div class="mt-4 flex flex-col gap-2">
					<p class="text-sm text-neutral-400">HintValue & HintDisplay</p>
					@uiForm.TextArea(uiForm.TextAreaSettings{
						InputName:       "description",
						Label:           "Description",
						TwoWayStatePath: "description",
						HintValue:       "This is a helpful hint displayed as a description below the textarea.",
						HintDisplay:     uiForm.InputHintDisplayDescription,
					})
					@uiForm.TextArea(uiForm.TextAreaSettings{
						InputName:       "description",
						Label:           "Description",
						TwoWayStatePath: "description",
						HintValue:       "This is a helpful hint displayed as a tooltip.",
						HintDisplay:     uiForm.InputHintDisplayTooltip,
					})
				</div>
				<div class="mt-4 flex flex-col gap-2">
					<p class="text-sm text-neutral-400">HintStatePath</p>
					@uiForm.TextArea(uiForm.TextAreaSettings{
						InputName:       "description",
						Label:           "Description",
						TwoWayStatePath: "description",
						HintStatePath:   "hintText",
						HintDisplay:     uiForm.InputHintDisplayTooltip,
					})
					@uiControl.Button(uiControl.ButtonSettings{
						Label:           "Change Hint Text",
						IconLeft:        "ph-pencil-simple",
						OnClickFunc:     "hintText = hintText === 'First hint text.' ? 'Second hint text.' : 'First hint text.'",
						Size:            uiControl.ButtonSizeSm,
						BackgroundColor: "neutral-700",
					})
				</div>
			</div>
		</div>
	</div>
}

templ RadioInputDemo() {
	<div class="flex flex-col gap-4" id="radio-input-demo">
		<div class="flex flex-col gap-2">
			<h3 class="text-xl font-bold">.RadioInput</h3>
			<p class="text-sm text-neutral-400">
				A radio input allows users to select one option from a set of options.
			</p>
		</div>
		<div class="grid gap-10 md:grid-cols-2">
			<div class="flex flex-col gap-4">
				<div class="flex flex-col gap-2">
					@UsageTitle("/form/radioInput.templ")
					<pre class={ DemoPreCodeClasses }>
						<code>
							{ `@uiForm.RadioInput(uiForm.RadioInputSettings{
	Label:           "Option 1",
	StateValue:      "option1",
	TwoWayStatePath: "selectedOption",
})
@uiForm.RadioInput(uiForm.RadioInputSettings{
	Label:           "Option 2",
	StateValue:      "option2",
	TwoWayStatePath: "selectedOption",
})` }
						</code>
					</pre>
				</div>
				<div class="flex flex-col gap-2">
					<h5 class="text-sm font-bold">Alpine.js Parent State <i>(x-data)</i></h5>
					<pre class={ DemoPreCodeClasses }>
						<code>{ `<div x-data="{selectedOption: 'option2'}"></div>` }</code>
					</pre>
				</div>
			</div>
			<div x-data="{selectedOption: 'option2'}" class="flex flex-col gap-4">
				<h4 class="text-lg font-bold">Live Example</h4>
				<div class="flex flex-col gap-2">
					@uiForm.RadioInput(uiForm.RadioInputSettings{
						Label:           "Option 1",
						StateValue:      "option1",
						TwoWayStatePath: "selectedOption",
						InputName:       "options",
					})
					@uiForm.RadioInput(uiForm.RadioInputSettings{
						Label:           "Option 2",
						StateValue:      "option2",
						TwoWayStatePath: "selectedOption",
						InputName:       "options",
					})
				</div>
			</div>
		</div>
	</div>
}

templ ToggleSwitchDemo() {
	<div class="flex flex-col gap-4" id="toggle-switch-demo">
		<div class="flex flex-col gap-2">
			<h3 class="text-xl font-bold">.ToggleSwitch</h3>
			<p class="text-sm text-neutral-400">
				A switch toggles a boolean state or adds and removes a custom value from an array.
			</p>
		</div>
		<div class="grid gap-10 md:grid-cols-2">
			<div class="flex flex-col gap-4">
				<div class="flex flex-col gap-2">
					@UsageTitle("/form/toggleSwitch.templ")
					<pre class={ DemoPreCodeClasses }>
						<code>
							{ `@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
	Label:           "Enable notifications",
	TwoWayStatePath: "isNotificationsEnabled",

	// OptionalFields
	InputName: "notificationsEnabled",
})
@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
	Label:           "Email notifications",
	TwoWayStatePath: "selectedChannels",
	CustomValue:     "email",
	InputName:       "channels",
})` }
						</code>
					</pre>
				</div>
				<div class="flex flex-col gap-2">
					<h5 class="text-sm font-bold">Alpine.js Parent State <i>(x-data)</i></h5>
					<pre class={ DemoPreCodeClasses }>
						<code>
							{ `<div x-data="{isNotificationsEnabled: false}"></div>
<div x-data="{selectedChannels: ['email']}"></div>` }
						</code>
					</pre>
				</div>
			</div>
			<div class="flex flex-col gap-6">
				<h4 class="text-lg font-bold">Live Examples</h4>
				<div
					x-data="{isNotificationsEnabled: false}"
					class="flex flex-col gap-3"
				>
					<h5 class="text-sm font-bold">Boolean state</h5>
					@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
						Label:           "Enable notifications",
						TwoWayStatePath: "isNotificationsEnabled",
						InputName:       "notificationsEnabled",
					})
					<p class={ DemoLiveStateClasses }>
						Value: <span x-text="isNotificationsEnabled"></span>
					</p>
				</div>
				<div
					x-data="{selectedChannels: ['email']}"
					class="flex flex-col gap-3"
				>
					<h5 class="text-sm font-bold">Array state</h5>
					@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
						Label:           "Email notifications",
						TwoWayStatePath: "selectedChannels",
						CustomValue:     "email",
						InputId:         "channel-email",
						InputName:       "channels",
					})
					@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
						Label:           "SMS notifications",
						TwoWayStatePath: "selectedChannels",
						CustomValue:     "sms",
						InputId:         "channel-sms",
						InputName:       "channels",
					})
					<p class={ DemoLiveStateClasses }>
						Values: <span x-text="selectedChannels"></span>
					</p>
				</div>
			</div>
		</div>
		<div
			x-data="{isSizeExampleEnabled: false, isRequiredExampleEnabled: false, emeraldEnabled: true, violetEnabled: false, amberEnabled: true}"
			class="grid gap-10 md:grid-cols-2"
		>
			<div class="flex flex-col gap-3">
				<p class="text-sm text-neutral-400">Sizes</p>
				for _, toggleSwitchSize := range []string{uiForm.ToggleSwitchSizeXs, uiForm.ToggleSwitchSizeSm, uiForm.ToggleSwitchSizeMd, uiForm.ToggleSwitchSizeLg, uiForm.ToggleSwitchSizeXl} {
					@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
						Label:           toggleSwitchSize,
						TwoWayStatePath: "isSizeExampleEnabled",
						Size:            toggleSwitchSize,
					})
				}
				<p class="mt-3 text-sm text-neutral-400">Label position</p>
				@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
					Label:           "Label on left",
					TwoWayStatePath: "isSizeExampleEnabled",
					LabelPosition:   uiForm.ToggleSwitchLabelPositionLeft,
				})
				@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
					Label:           "Label on right",
					TwoWayStatePath: "isSizeExampleEnabled",
					LabelPosition:   uiForm.ToggleSwitchLabelPositionRight,
				})
			</div>
			<div class="flex flex-col gap-3">
				<p class="text-sm text-neutral-400">Color variants</p>
				@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
					Label:                       "Emerald accent",
					TwoWayStatePath:             "emeraldEnabled",
					TrackBackgroundColor:        "emerald-900/40",
					TrackCheckedBackgroundColor: "emerald-500",
					FocusRingColor:              "emerald-500/50",
				})
				@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
					Label:                       "Violet accent",
					TwoWayStatePath:             "violetEnabled",
					TrackBackgroundColor:        "violet-900/40",
					TrackCheckedBackgroundColor: "violet-500",
					FocusRingColor:              "violet-500/50",
				})
				@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
					Label:                       "Amber thumb",
					TwoWayStatePath:             "amberEnabled",
					TrackBackgroundColor:        "red-500/20",
					TrackCheckedBackgroundColor: "amber-500",
					ThumbBackgroundColor:        "amber-300",
					ThumbBorderColor:            "amber-500",
					TextColor:                   "amber-100",
					FocusRingColor:              "amber-500/50",
				})
				<p class="mt-3 text-sm text-neutral-400">Required state</p>
				@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
					Label:           "Required notifications",
					TwoWayStatePath: "isRequiredExampleEnabled",
					IsRequired:      true,
				})
				<p class="mt-3 text-sm text-neutral-400">Disabled state</p>
				@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
					Label:           "Disabled",
					TwoWayStatePath: "isSizeExampleEnabled",
					IsDisabled:      true,
				})
			</div>
		</div>
	</div>
}

templ InlineRadioGroupDemo() {
	<div class="flex flex-col gap-4" id="inline-radio-group-demo">
		<div class="flex flex-col gap-2">
			<h3 class="text-xl font-bold">.InlineRadioGroup</h3>
			<p class="text-sm text-neutral-400">
				An inline radio group displays a set of radio options in a horizontal layout.
			</p>
		</div>
		<div class="grid gap-10 md:grid-cols-2">
			<div class="flex flex-col gap-4">
				<div class="flex flex-col gap-2">
					@UsageTitle("/form/inlineRadioGroup.templ")
					<pre class={ DemoPreCodeClasses }>
						<code>
							{ `@uiForm.InlineRadioGroup(uiForm.InlineRadioGroupSettings{
	Label: "Select an option",
	InputSettings: []uiForm.RadioInputSettings{
		{
			Label:           "Option 1",
			StateValue:      "option1",
			TwoWayStatePath: "groupSelection",
		},
		{
			Label:           "Option 2",
			StateValue:      "option2",
			TwoWayStatePath: "groupSelection",
		},
	},

	// OptionalFields
	TwoWayStatePath: "groupSelection",
	InputName:       "group1",
})` }
						</code>
					</pre>
				</div>
				<div class="flex flex-col gap-2">
					<h5 class="text-sm font-bold">Alpine.js Parent State <i>(x-data)</i></h5>
					<pre class={ DemoPreCodeClasses }>
						<code>{ `<div x-data="{groupSelection: 'option2'}"></div>` }</code>
					</pre>
				</div>
			</div>
			<div x-data="{groupSelection: 'option2'}" class="flex flex-col">
				<h4 class="mb-2 text-lg font-bold">Live Example</h4>
				@uiForm.InlineRadioGroup(uiForm.InlineRadioGroupSettings{
					Label: "Select an option",
					InputSettings: []uiForm.RadioInputSettings{
						{
							Label:           "Option 1",
							StateValue:      "option1",
							TwoWayStatePath: "groupSelection",
						},
						{
							Label:           "Option 2",
							StateValue:      "option2",
							TwoWayStatePath: "groupSelection",
						},
					},
					TwoWayStatePath: "groupSelection",
					InputName:       "group1",
				})
			</div>
		</div>
	</div>
}

