package main

import (
	uiDisplay "github.com/goinfinite/ui/src/display"
	uiForm "github.com/goinfinite/ui/src/form"
	uiToolset "github.com/goinfinite/ui/src/toolset"
)

templ MultiSelectInputDemoOption1() {
	<div class="flex flex-col">
		<h4 class="text-base font-bold">🇦🇷 Argentina</h4>
		<p class="text-sm text-neutral-400">Known for its dance and wine.</p>
	</div>
}

templ MultiSelectInputDemoOption2() {
	<div class="flex flex-col">
		<h4 class="text-base font-bold">🇧🇷 Brazil</h4>
		<p class="text-sm text-neutral-400">Known for its music and natural beauty.</p>
	</div>
}

templ MultiSelectInputDemoOption3() {
	<div class="flex flex-col">
		<h4 class="text-base font-bold">🇨🇱 Chile</h4>
		<p class="text-sm text-neutral-400">Known for its deserts and mysterious islands.</p>
	</div>
}

templ MultiSelectInputLabelValueExample() {
	{{
		labelValueUsage := `@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
	InputName: "countries",
	Label:     "Countries",

	// OptionalFields
	LabelValueOptions: []uiForm.SelectLabelValueOption{
		{Label: "Argentina", Value: "AR"},
		{Label: "Brazil", Value: "BR"},
		{Label: "Chile", Value: "CL"},
	},
	TwoWayStatePath: "countries",
})`
	}}
	@DemoExampleCard(
		"LabelValueOptions",
		"LabelValueOptions send a stored Value while showing a human Label. The bound state holds the selected Values.",
		"/form/multiSelectInput.templ", labelValueUsage,
	) {
		@DemoAlpineStateBlock(`<div x-data="{countries: ['BR']}"></div>`)
		<div x-data="{countries: ['BR']}">
			@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
				InputName: "countriesLabelValue",
				Label:     "Countries",
				LabelValueOptions: []uiForm.SelectLabelValueOption{
					{
						Label: "Argentina",
						Value: "AR",
					},
					{
						Label: "Brazil",
						Value: "BR",
					},
					{
						Label: "Chile",
						Value: "CL",
					},
				},
				TwoWayStatePath: "countries",
			})
		</div>
	}
}

templ MultiSelectInputHtmlOptionsExample() {
	{{
		htmlOptionsUsage := `@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
	InputName: "countriesWithHtml",
	Label:     "Countries",

	// OptionalFields
	LabelValueOptions: []uiForm.SelectLabelValueOption{
		{Label: "Argentina", LabelHtml: MultiSelectInputDemoOption1(), Value: "AR"},
		{Label: "Brazil", LabelHtml: MultiSelectInputDemoOption2(), Value: "BR"},
		{Label: "Chile", LabelHtml: MultiSelectInputDemoOption3(), Value: "CL"},
	},
	TwoWayStatePath: "countries",
})`
	}}
	@DemoExampleCard(
		"HTML Option Labels",
		"LabelHtml replaces the plain option label with custom markup in the dropdown.",
		"/form/multiSelectInput.templ", htmlOptionsUsage,
	) {
		@DemoAlpineStateBlock(`<div x-data="{countries: ['BR']}"></div>`)
		<div class="flex flex-col gap-3" x-data="{countries: ['BR']}">
			<p class="text-sm text-neutral-400">Click the dropdown to see the HTML labels.</p>
			@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
				InputName: "countriesWithHtml",
				Label:     "Countries",
				LabelValueOptions: []uiForm.SelectLabelValueOption{
					{
						Label:     "Argentina",
						LabelHtml: MultiSelectInputDemoOption1(),
						Value:     "AR",
					},
					{
						Label:     "Brazil",
						LabelHtml: MultiSelectInputDemoOption2(),
						Value:     "BR",
					},
					{
						Label:     "Chile",
						LabelHtml: MultiSelectInputDemoOption3(),
						Value:     "CL",
					},
				},
				TwoWayStatePath: "countries",
			})
		</div>
	}
}

templ MultiSelectInputHintsExample() {
	{{
		hintsUsage := `@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
	InputName: "countriesHint",
	Label:     "Countries",

	// OptionalFields
	FlatOptions:                       []string{"Argentina", "Brazil", "Chile"},
	TwoWayStatePath:                   "countries",
	HintValue:                         "This is a helpful hint.",
	HintStatePath:                     "hintText",
	HintDisplay:                       uiForm.InputHintDisplayTooltip,
	HintDisplayTooltipBackgroundColor: "violet-950/95",
	HintDisplayTooltipMinWidthClass:   "min-w-40",
	HintDisplayTooltipMaxWidthClass:   "max-w-64",
	HintDisplayTooltipMinHeightClass:  "min-h-10",
	HintDisplayTooltipMaxHeightClass:  "max-h-24",
})`
	}}
	@DemoExampleCard(
		"Hints",
		"HintValue explains the field. HintDisplay shows it as a description below the field or as a tooltip. HintStatePath reads the hint text from Alpine state. The HintDisplayTooltip fields shape the tooltip surface.",
		"/form/multiSelectInput.templ", hintsUsage,
	) {
		<div class="flex flex-col gap-6" x-data="{countries: ['Brazil'], hintText: 'This hint comes from Alpine state.'}">
			@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
				InputName:       "countriesHintDescription",
				Label:           "Countries",
				FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
				TwoWayStatePath: "countries",
				HintValue:       "This is a helpful hint displayed as a description below the multi-select.",
				HintDisplay:     uiForm.InputHintDisplayDescription,
			})
			@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
				InputName:       "countriesHintTooltip",
				Label:           "Countries",
				FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
				TwoWayStatePath: "countries",
				HintValue:       "This is a helpful hint displayed as a tooltip.",
				HintDisplay:     uiForm.InputHintDisplayTooltip,
			})
			@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
				InputName:                         "countriesHintState",
				Label:                             "Countries",
				FlatOptions:                       []string{"Argentina", "Brazil", "Chile"},
				TwoWayStatePath:                   "countries",
				HintStatePath:                     "hintText",
				HintDisplay:                       uiForm.InputHintDisplayTooltip,
				HintDisplayTooltipBackgroundColor: "violet-950/95",
				HintDisplayTooltipMinWidthClass:   "min-w-40",
				HintDisplayTooltipMaxWidthClass:   "max-w-64",
				HintDisplayTooltipMinHeightClass:  "min-h-10",
				HintDisplayTooltipMaxHeightClass:  "max-h-24",
			})
		</div>
	}
}

templ MultiSelectInputHintIconStyleExample() {
	{{
		hintIconUsage := `@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
	InputName: "countriesHintBoxed",
	Label:     "Countries",

	// OptionalFields
	FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
	TwoWayStatePath: "countries",
	HintValue:        "This is a helpful hint.",
	HintDisplay:      uiForm.InputHintDisplayTooltip,
	HintIconStyle:    uiForm.InputHintIconStyleBoxed,
})`
	}}
	@DemoExampleCard(
		"Hint Icon Styles",
		"HintIconStyle renders the hint trigger as an icon or as a boxed tooltip.",
		"/form/multiSelectInput.templ", hintIconUsage,
	) {
		<div x-data="{countries: ['Brazil']}">
			@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
				InputName:       "countriesHintBoxed",
				Label:           "Countries",
				FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
				TwoWayStatePath: "countries",
				HintValue:       "This is a helpful hint displayed as a boxed tooltip.",
				HintDisplay:     uiForm.InputHintDisplayTooltip,
				HintIconStyle:   uiForm.InputHintIconStyleBoxed,
			})
		</div>
	}
}

templ MultiSelectInputRequiredExample() {
	{{
		requiredUsage := `@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
	InputName: "countriesRequired",
	Label:     "Countries",

	// OptionalFields
	FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
	TwoWayStatePath: "countries",
	IsRequired:      true,
})`
	}}
	@DemoExampleCard(
		"Required", "IsRequired marks the field as required.",
		"/form/multiSelectInput.templ", requiredUsage,
	) {
		<div x-data="{countries: ['Brazil']}">
			@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
				InputName:       "countriesRequired",
				Label:           "Countries",
				FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
				TwoWayStatePath: "countries",
				IsRequired:      true,
			})
		</div>
	}
}

templ MultiSelectInputOnChangeExample() {
	{{
		onChangeUsage := `@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
	InputName: "countriesChange",
	Label:     "Countries",

	// OptionalFields
	FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
	TwoWayStatePath: "countries",
	OnChangeFunc:    "onCountryChange()",
})`
	}}
	@DemoExampleCard(
		"OnChangeFunc",
		"OnChangeFunc runs when a selection changes and when the field is cleared.",
		"/form/multiSelectInput.templ", onChangeUsage,
	) {
		@DemoAlpineStateBlock(`<div x-data="{countries: ['BR'], changeCount: 0, onCountryChange() { this.changeCount++ }}"></div>`)
		<div
			class="grid gap-6"
			x-data="{countries: ['BR'], changeCount: 0, onCountryChange() { this.changeCount++ }}"
		>
			<p class="text-sm text-neutral-400">Toggle an option or clear the field to see the function run.</p>
			@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
				InputName:       "countriesChange",
				Label:           "Countries",
				FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
				TwoWayStatePath: "countries",
				OnChangeFunc:    "onCountryChange()",
			})
			<p class={ DemoLiveStateClasses }>
				Change count: <span x-text="changeCount"></span>
			</p>
		</div>
	}
}

templ MultiSelectInputDropdownBackgroundExample() {
	{{
		dropdownBackgroundUsage := `@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
	InputName: "countriesDropdown",
	Label:     "Countries",

	// OptionalFields
	FlatOptions:             []string{"Argentina", "Brazil", "Chile"},
	TwoWayStatePath:         "countries",
	DropdownBackgroundColor: "emerald-900",
})`
	}}
	@DemoExampleCard(
		"Dropdown Background",
		"DropdownBackgroundColor sets the dropdown surface color. It accepts a Tailwind token.",
		"/form/multiSelectInput.templ", dropdownBackgroundUsage,
	) {
		<div class="flex flex-col gap-3" x-data="{countries: ['BR']}">
			<p class="text-sm text-neutral-400">Open the dropdown to see the background color.</p>
			@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
				InputName:               "countriesDropdown",
				Label:                   "Countries",
				FlatOptions:             []string{"Argentina", "Brazil", "Chile"},
				TwoWayStatePath:         "countries",
				DropdownBackgroundColor: "emerald-900",
			})
		</div>
	}
}

templ MultiSelectInputDropdownHeightExample() {
	{{
		dropdownHeightUsage := `@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
	InputName: "countriesDropdownHeight",
	Label:     "Countries",

	// OptionalFields
	FlatOptions:            []string{"Argentina", "Australia", "Brazil", "Canada", "Chile", "China", "France", "Germany", "India", "Japan", "Mexico", "Portugal"},
	TwoWayStatePath:        "countries",
	DropdownMinHeightClass: "min-h-24",
	DropdownMaxHeightClass: "max-h-40",
	MaxVisibleOptions:      3,
})`
	}}
	@DemoExampleCard(
		"Dropdown Height",
		"DropdownMinHeightClass and DropdownMaxHeightClass cap the option list. MaxVisibleOptions caps it to a row count and wins over both.",
		"/form/multiSelectInput.templ", dropdownHeightUsage,
	) {
		<div class="flex flex-col gap-3" x-data="{countries: ['BR']}">
			<p class="text-sm text-neutral-400">Open the dropdown to see the capped list scroll.</p>
			@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
				InputName: "countriesDropdownHeight",
				Label:     "Countries",
				FlatOptions: []string{
					"Argentina", "Australia", "Brazil", "Canada",
					"Chile", "China", "France", "Germany", "India",
					"Japan", "Mexico", "Portugal",
				},
				TwoWayStatePath:        "countries",
				DropdownMinHeightClass: "min-h-24",
				DropdownMaxHeightClass: "max-h-40",
				MaxVisibleOptions:      3,
			})
		</div>
	}
}

templ MultiSelectInputTextCaseExample() {
	{{
		textCaseUsage := `@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
	InputName: "countriesTextCase",
	Label:     "Countries",

	// OptionalFields
	FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
	TwoWayStatePath: "countries",
	TextCase:        uiToolset.TextCaseUpper,
})`
	}}
	@DemoExampleCard(
		"Text Case",
		"TextCase transforms the field label. It accepts uiToolset.TextCaseNone (the default, as typed), TextCaseLower, TextCaseUpper, or TextCaseCapitalize.",
		"/form/multiSelectInput.templ", textCaseUsage,
	) {
		<div
			class="flex flex-col gap-3"
			x-data="{none: [], lower: [], upper: [], capitalize: []}"
		>
			for _, textCase := range []string{
				uiToolset.TextCaseNone,
				uiToolset.TextCaseLower,
				uiToolset.TextCaseUpper,
				uiToolset.TextCaseCapitalize,
			} {
				@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
					InputName:       "countries",
					Label:           "Countries (" + textCase + ")",
					FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
					TwoWayStatePath: textCase,
					TextCase:        textCase,
				})
			}
		</div>
	}
}

templ MultiSelectInputDemo() {
	{{
		demoUsage := `@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
	InputName: "countries",
	Label:     "Countries",

	// OptionalFields
	FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
	TwoWayStatePath: "countries",
})`
	}}
	<div class="flex flex-col gap-4" id="multi-select-input-demo">
		@DemoComponentSection(DemoComponentSectionSettings{
			ComponentPath:          "/form/multiSelectInput.templ",
			Description:            "A multi-select input allows users to select multiple options from a dropdown list.",
			LiveExampleDescription: "A multi-select bound to an Alpine array, with flat option labels.",
			Title:                  ".MultiSelectInput",
			UsageCode:              demoUsage,
			AlpineStateCode:        `<div x-data="{countries: ['Brazil']}"></div>`,
		}) {
			<div x-data="{countries: ['Brazil']}">
				@uiForm.MultiSelectInput(uiForm.MultiSelectInputSettings{
					InputName:       "countries",
					Label:           "Countries",
					FlatOptions:     []string{"Argentina", "Brazil", "Chile"},
					TwoWayStatePath: "countries",
				})
				<p class={ DemoLiveStateClasses }>
					Values: <span x-text="JSON.stringify(countries)"></span>
				</p>
			</div>
		}
		@DemoAdvancedExamples([]uiDisplay.AccordionItemSettings{
			{Title: "LabelValueOptions", Icon: "ph-tag", Content: MultiSelectInputLabelValueExample()},
			{Title: "HTML Option Labels", Icon: "ph-code", Content: MultiSelectInputHtmlOptionsExample()},
			{Title: "Hints", Icon: "ph-info", Content: MultiSelectInputHintsExample()},
			{Title: "Hint Icon Styles", Icon: "ph-question", Content: MultiSelectInputHintIconStyleExample()},
			{Title: "Required", Icon: "ph-asterisk", Content: MultiSelectInputRequiredExample()},
			{Title: "OnChangeFunc", Icon: "ph-arrows-clockwise", Content: MultiSelectInputOnChangeExample()},
			{Title: "Dropdown Background", Icon: "ph-paint-brush", Content: MultiSelectInputDropdownBackgroundExample()},
			{Title: "Dropdown Height", Icon: "ph-arrows-out-line-vertical", Content: MultiSelectInputDropdownHeightExample()},
			{Title: "Text Case", Icon: "ph-text-t", Content: MultiSelectInputTextCaseExample()},
		})
	</div>
}
