	}
}

templ ChartGaugeTextExample() {
	{{
		gaugeTextUsage := `@uiDisplay.Chart(uiDisplay.ChartSettings{
	Type: uiDisplay.ChartTypeGauge,
	AriaLabel: "Disk usage",

	// OptionalFields
	Gauge: uiDisplay.ChartGaugeSettings{
		Value:          72,
		IsSemicircle:   true,
		Label:          "Disk usage",
		LabelTextSize:  16,
		NeedleColor:    "sky-400",
		TextOffset:     20,
		ValueTextSize:  36,
	},
})`
	}}
	@DemoExampleCard(
		"Gauge Text Size and Offset",
		"Gauge.ValueTextSize and Gauge.LabelTextSize set the two center font sizes; the defaults are 24 and 12. Gauge.TextOffset moves the pair down, away from the pivot; the default is 0. The viewBox grows with the offset and the larger of the two text sizes, and widens for a long value or label, so the text never clips.",
		"/display/chart.templ", gaugeTextUsage,
	) {
		@uiDisplay.Chart(uiDisplay.ChartSettings{
			Type:      uiDisplay.ChartTypeGauge,
			AriaLabel: "Disk usage",
			Gauge: uiDisplay.ChartGaugeSettings{
				Value:         72,
				IsSemicircle:  true,
				Label:         "Disk usage",
				LabelTextSize: 16,
				NeedleColor:   "sky-400",
				TextOffset:    20,
				ValueTextSize: 36,
			},
		})
	}
}

templ ChartDemo() {
	{{
		demoUsage := `@uiDisplay.Chart(uiDisplay.ChartSettings{
	Type: uiDisplay.ChartTypeArea,
	XAxis: uiDisplay.ChartXAxisSettings{
		RowKey:          "time",
		ScaleType:       uiDisplay.ChartScaleTypeTime,
		TickLabelFormat: "%H:%M:%S",
	},
	Series: []uiDisplay.ChartSeriesSettings{
		{RowKey: "cpu", Label: "CPU"},
		{RowKey: "memory", Label: "Memory"},
	},

	// OptionalFields
	Cartesian: uiDisplay.ChartCartesianSettings{
		YAxis: uiDisplay.ChartYAxisSettings{
			TickLabelFormat: ".0%",
			MinValue:        "0",
			MaxValue:        "1",
		},
	},
	Tooltip:             uiDisplay.ChartTooltipSettings{TitleFormat: "%H:%M:%S"},
	RowsOneWayStatePath: "resourceUsageRows",
	MaxRows:             20,
})`
	}}
	<div class="flex flex-col gap-4" id="chart-demo">
		@DemoComponentSection(DemoComponentSectionSettings{
			ComponentPath:          "/display/chart.templ",
			Description:            "A chart renders line, area, bar, horizontal bar, pie, donut, radial bar, sunburst, parliament, and waffle charts with Vega, and a progress bar and a gauge without it. A line, area, or bar reads the Cartesian group; a donut, pie, or radial bar reads Slices; sunburst, parliament, and waffle read Slices plus their own group; progress and gauge read only their own group. Vega charts draw an HTML legend, a hover tooltip, and a screen-reader table, and they redraw when the rows at RowsOneWayStatePath change. The page must load Vega once, usually with @uiImport.HeadTagsVega() in the layout head.",
			LiveExampleDescription: "CPU and memory usage. The parent state appends a row every two seconds and drops the oldest.",
			Title:                  ".Chart",
			UsageCode:              demoUsage,
			AlpineStateCode:        `<div x-data="{resourceUsageRows: [{time: 1760360000000, cpu: 0.42, memory: 0.61}]}"></div>`,
		}) {
			@uiToolset.MinifierTemplateJs(&chartDemoAlpineState)
			<div x-data="chartDemoResourceUsage">
				@uiDisplay.Chart(uiDisplay.ChartSettings{
					Type: uiDisplay.ChartTypeArea,
					XAxis: uiDisplay.ChartXAxisSettings{
						RowKey:          "time",
						ScaleType:       uiDisplay.ChartScaleTypeTime,
						TickLabelFormat: "%H:%M:%S",
					},
					Series: []uiDisplay.ChartSeriesSettings{
						{RowKey: "cpu", Label: "CPU"},
						{RowKey: "memory", Label: "Memory"},
					},
					Cartesian: uiDisplay.ChartCartesianSettings{
						YAxis: uiDisplay.ChartYAxisSettings{
							TickLabelFormat: ".0%",
							MinValue:        "0",
							MaxValue:        "1",
						},
					},
					Tooltip:             uiDisplay.ChartTooltipSettings{TitleFormat: "%H:%M:%S"},
					RowsOneWayStatePath: "resourceUsageRows",
					MaxRows:             20,
					AriaLabel:           "CPU and memory usage",
				})
			</div>
		}
		@DemoAdvancedExamples("chart-demo", []uiDisplay.AccordionItemSettings{
			{Title: "Line", Icon: "ph-chart-line", Content: ChartLineExample()},
			{Title: "Bar", Icon: "ph-chart-bar", Content: ChartBarExample()},
			{Title: "Horizontal Bar", Icon: "ph-chart-bar-horizontal", Content: ChartHorizontalBarExample()},
			{Title: "Stacked", Icon: "ph-stack", Content: ChartStackedExample()},
			{Title: "Donut", Icon: "ph-chart-donut", Content: ChartDonutExample()},
			{Title: "Pie", Icon: "ph-chart-pie", Content: ChartPieExample()},
			{Title: "Radial Bar", Icon: "ph-chart-polar", Content: ChartRadialBarExample()},
			{Title: "Sunburst", Icon: "ph-sun", Content: ChartSunburstExample()},
			{Title: "Parliament", Icon: "ph-bank", Content: ChartParliamentExample()},
			{Title: "Parliament Dot Shape", Icon: "ph-shapes", Content: ChartParliamentDotShapeExample()},
			{Title: "Waffle", Icon: "ph-squares-four", Content: ChartWaffleExample()},
			{Title: "Waffle Shape and Gap", Icon: "ph-circles-three", Content: ChartWaffleCellShapeExample()},
			{Title: "Progress", Icon: "ph-spinner-gap", Content: ChartProgressExample()},
			{Title: "Progress Thresholds", Icon: "ph-traffic-sign", Content: ChartProgressThresholdsExample()},
			{Title: "Progress Bound Value", Icon: "ph-link", Content: ChartProgressBoundExample()},
