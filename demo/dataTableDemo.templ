package main

import (
	uiControl "github.com/goinfinite/ui/src/control"
	uiDisplay "github.com/goinfinite/ui/src/display"
	uiForm "github.com/goinfinite/ui/src/form"
	uiStructural "github.com/goinfinite/ui/src/structural"
	uiToolset "github.com/goinfinite/ui/src/toolset"
)

templ DemoServerTextCell(value string) {
	<span class="text-neutral-300">{ value }</span>
}

templ DemoServerStatusCell(status string) {
	{{ variationClasses := "bg-emerald-500/20 text-emerald-100" }}
	if status != "running" {
		{{ variationClasses = "bg-neutral-500/20 text-neutral-300" }}
	}
	<span class={ "rounded-full px-2 py-0.5 text-xs font-bold " + variationClasses }>{ status }</span>
}

templ DemoServerPlainTextCell(value string) {
	{ value }
}

templ DemoTooltipActionCell(record DemoServerRecord) {
	<div class="flex justify-end">
		@uiControl.Button(uiControl.ButtonSettings{
			IconLeft:       "ph-info",
			Shape:          uiToolset.ShapeCircular,
			Size:           uiControl.ButtonSizeSm,
			AriaLabel:      "Show details for " + record.Name,
			TooltipContent: "Details for " + record.Name,
		})
	</div>
}

templ DataTableColumnConfigExample() {
	{{
		columnSettings := buildDemoStaticTableSettings(
			"data-table-demo-columns", "Column configuration table pagination",
			buildDemoColumnShowcaseColumns(),
			dataTableDemoRecords[:4],
		)
	}}
	{{
		columnSettings.InitialSortKey = "name"
		columnSettings.InitialSortDirection = uiStructural.DataTableSortDirectionAsc
	}}
	{{
		columnUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns: []uiStructural.DataTableColumnSettings[Record]{
		{Label: "Name", SortKey: "name", WidthPercent: 20, CellRenderer: nameCell},
		{Label: "Description", MaxWidthClass: "max-w-72 truncate", CellRenderer: descriptionCell},
		{Label: "Status", Alignment: uiStructural.TextAlignmentCenter, WidthPercent: 15, CellRenderer: statusCell},
		{Label: "CPU cores", SortKey: "cpuCores", Alignment: uiStructural.TextAlignmentRight, WidthPercent: 12, CellRenderer: cpuCell},
		{Label: "Created at", MinWidthClass: "min-w-28", CellRenderer: createdAtCell},
	},
	Rows: records,

	// OptionalFields
	InitialSortKey:       "name",
	InitialSortDirection: uiStructural.DataTableSortDirectionAsc,
})`
	}}
	@DemoExampleCardStacked(
		"Column Configuration",
		"A column sets its alignment, width, and sortability. WidthPercent shares the row width, MaxWidthClass caps a long cell, and MinWidthClass holds a floor. A column with a SortKey renders a sort button; InitialSortKey and InitialSortDirection seed the active sort indicator.",
		"/structural/dataTable.templ", columnUsage,
	) {
		@uiStructural.DataTable(columnSettings)
	}
}

templ DataTableRowsConfigExample() {
	{{
		rowsSettings := buildDemoStaticTableSettings(
			"data-table-demo-rows", "Rows configuration table pagination",
			buildDemoPlainTableColumns(),
			dataTableDemoRecords[:4],
		)
	}}
	{{
		rowsSettings.RowIdResolver = func(record DemoServerRecord) string { return record.Id }
		rowsSettings.RowLabelResolver = func(record DemoServerRecord) string { return record.Name }
		rowsSettings.CheckboxShape = uiToolset.ShapeRounded
		rowsSettings.CheckboxSize = uiForm.CheckboxInputSizeSm
		rowsSettings.CheckboxCheckedColor = "emerald-500"
		rowsSettings.CheckboxUncheckedColor = "sky-500"
	}}
	{{
		rowsUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns:              columns,
	Rows:                 records,
	RowIdResolver:        func(record Record) string { return record.Id },
	RowLabelResolver:     func(record Record) string { return record.Name },
	CheckboxShape:        uiToolset.ShapeRounded,
	CheckboxSize:         uiForm.CheckboxInputSizeSm,
	CheckboxCheckedColor: "emerald-500",
	CheckboxUncheckedColor: "sky-500",
})`
	}}
	@DemoExampleCardStacked(
		"Rows Configuration",
		"RowIdResolver adds the selection column and identifies each row. RowLabelResolver names the row checkbox for screen readers. CheckboxShape, CheckboxSize, CheckboxCheckedColor, and CheckboxUncheckedColor change the selection checkbox. Select a row to see the colors change.",
		"/structural/dataTable.templ", rowsUsage,
	) {
		@uiStructural.DataTable(rowsSettings)
	}
}

templ DataTableFiltersExample() {
	{{
		filterSettings := buildDemoStaticTableSettings(
			"data-table-demo-filters", "Filters table pagination",
			buildDemoPlainTableColumns(),
			dataTableDemoRecords[:5],
		)
	}}
	{{
		filterSettings.Filters = buildDemoRecordFilters()
		filterSettings.FilterDropdownBackgroundColor = "neutral-800"
		filterSettings.InitialFilterValues = map[string]any{"status": "running"}
	}}
	{{
		filtersUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns:                       columns,
	Rows:                          records,
	Filters:                       filters,
	FilterDropdownBackgroundColor: "neutral-800",
	InitialFilterValues:           map[string]any{"status": "running"},
})`
	}}
	@DemoExampleCardStacked(
		"Filters",
		"Each filter renders an editor and an active chip. InitialFilterValues seeds the starting values. FilterDropdownBackgroundColor paints the dropdown panel. A filter change updates the chips and the filter values.",
		"/structural/dataTable.templ", filtersUsage,
	) {
		@uiStructural.DataTable(filterSettings)
	}
}

templ DataTableCustomSearchBox() {
	@uiForm.InputField(uiForm.InputFieldSettings{
		InputType:       uiForm.InputTypeText,
		InputName:       "customSearch",
		Label:           "Custom search",
		IconLeft:        "ph-funnel",
		TwoWayStatePath: "searchQuery",
	})
}

templ DataTableSearchBoxExample() {
	{{
		searchSettings := buildDemoStaticTableSettings(
			"data-table-demo-search", "Search box table pagination",
			buildDemoPlainTableColumns(),
			dataTableDemoRecords[:5],
		)
	}}
	{{
		customSearchSettings := buildDemoStaticTableSettings(
			"data-table-demo-search-custom", "Custom search box table pagination",
			buildDemoPlainTableColumns(),
			dataTableDemoRecords[:5],
		)
	}}
	{{
		searchSettings.QueryUrlTemplate = "assets/dataTableDemoRefreshFragments.json?search=" +
			uiStructural.DataTableUrlPlaceholderSearch
		searchSettings.InitialSearchQuery = "alpha"
		searchSettings.IsSearchBoxCompact = true
		searchSettings.SearchBoxAlignment = uiStructural.HorizontalAlignmentCenter
		customSearchSettings.SearchBox = DataTableCustomSearchBox()
	}}
	{{
		searchUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns:          columns,
	Rows:             records,
	QueryUrlTemplate: "/records?search={search}",

	// OptionalFields
	InitialSearchQuery: "alpha",
	IsSearchBoxCompact: true,
	SearchBoxAlignment: uiStructural.HorizontalAlignmentCenter,

	// Or replace the default box
	SearchBox: CustomSearchBox(),
})`
	}}
	@DemoExampleCardStacked(
		"Search Box",
		"The table renders a default search box when the query template carries the search placeholder. The box stretches to the available space by default; IsSearchBoxCompact fixes it to a narrow width so SearchBoxAlignment can place it left, center, or right. InitialSearchQuery seeds the starting text. Pass SearchBox to replace the default box with any component that binds to searchQuery.",
		"/structural/dataTable.templ", searchUsage,
	) {
		<div class="grid gap-6 lg:grid-cols-2">
			<div class="flex flex-col gap-2">
				<p class="text-sm text-neutral-400">Default box, compact and centered</p>
				@uiStructural.DataTable(searchSettings)
			</div>
			<div class="flex flex-col gap-2">
				<p class="text-sm text-neutral-400">Custom SearchBox, full width</p>
				@uiStructural.DataTable(customSearchSettings)
			</div>
		</div>
	}
}

templ DataTableHeaderActionsExample() {
	{{
		headerSettings := buildDemoStaticTableSettings(
			"data-table-demo-header-actions", "Header actions table pagination",
			buildDemoPlainTableColumns(),
			dataTableDemoRecords[:4],
		)
	}}
	{{
		headerSettings.HeaderActions = uiControl.Button(uiControl.ButtonSettings{
			Label:       "Sync",
			IconLeft:    "ph-arrows-clockwise",
			OnClickFunc: "$dispatch('demo:header-action')",
			Size:        uiControl.ButtonSizeSm,
		})
	}}
	{{
		headerUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns: columns,
	Rows:    records,
	HeaderActions: uiControl.Button(uiControl.ButtonSettings{
		Label:       "Sync",
		IconLeft:    "ph-arrows-clockwise",
		OnClickFunc: "$dispatch('demo:header-action')",
		Size:        uiControl.ButtonSizeSm,
	}),
})`
	}}
	<div class="flex flex-col gap-4" x-data="{headerActionCount: 0}">
		@DemoExampleHeader(
			"Header Actions",
			"HeaderActions renders in the toolbar. The button here dispatches an event the panel counts.",
			"/structural/dataTable.templ", headerUsage,
		)
		<div @demo:header-action.window="headerActionCount++">
			@uiStructural.DataTable(headerSettings)
		</div>
		<p class={ DemoLiveStateClasses }>
			Header action clicks: <span x-text="headerActionCount"></span>
		</p>
	</div>
}

templ DataTableBulkActionsExample() {
	{{
		bulkSettings := buildDemoStaticTableSettings(
			"data-table-demo-bulk-actions", "Bulk actions table pagination",
			buildDemoPlainTableColumns(),
			dataTableDemoRecords[:4],
		)
	}}
	{{
		bulkSettings.RowIdResolver = func(record DemoServerRecord) string { return record.Id }
		bulkSettings.RowLabelResolver = func(record DemoServerRecord) string { return record.Name }
		bulkSettings.BulkActions = uiControl.Button(uiControl.ButtonSettings{
			Label:           "Archive",
			IconLeft:        "ph-archive",
			OnClickFunc:     "selectedRowIds = []",
			Size:            uiControl.ButtonSizeSm,
			BackgroundColor: "red-500/20",
			TextColor:       "red-200",
		})
	}}
	{{
		bulkUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns: columns,
	Rows:    records,
	RowIdResolver: func(record Record) string { return record.Id },
	BulkActions: uiControl.Button(uiControl.ButtonSettings{
		Label:           "Archive",
		IconLeft:        "ph-archive",
		OnClickFunc:     "selectedRowIds = []",
		Size:            uiControl.ButtonSizeSm,
		BackgroundColor: "red-500/20",
		TextColor:       "red-200",
	}),
})`
	}}
	@DemoExampleCardStacked(
		"Bulk Actions",
		"BulkActions renders in the toolbar only while at least one row is selected. Select a row to reveal the action.",
		"/structural/dataTable.templ", bulkUsage,
	) {
		@uiStructural.DataTable(bulkSettings)
	}
}

templ DataTableStylingExample() {
	{{
		stylingSettings := buildDemoStaticTableSettings(
			"data-table-demo-styling", "Styling table pagination",
			buildDemoStylingColumns(),
			dataTableDemoRecords[:4],
		)
	}}
	{{
		stylingSettings.StickyHeaderBackgroundColor = "neutral-50/5"
		stylingSettings.ItemsPerPageDropdownBackgroundColor = "emerald-900"
		stylingSettings.IsStriped = true
		stylingSettings.RowClassResolver = func(record DemoServerRecord) string {
			if record.Status != "running" {
				return "text-neutral-400"
			}
			return ""
		}
	}}
	{{
		stylingUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns: []uiStructural.DataTableColumnSettings[Record]{
		{Label: "Name", CellClass: "font-bold", CellRenderer: nameCell},
		{Label: "Status", CellRenderer: statusCell},
		{Label: "CPU cores", Alignment: uiStructural.TextAlignmentRight, CellRenderer: cpuCell},
	},
	Rows: records,

	// OptionalFields
	StickyHeaderBackgroundColor:         "neutral-50/5",
	ItemsPerPageDropdownBackgroundColor: "emerald-900",
	IsStriped:                           true,
	RowClassResolver: func(record Record) string {
		if record.Status != "running" {
			return "text-neutral-400"
		}
		return ""
	},
})`
	}}
	@DemoExampleCardStacked(
		"Row and Column Styling",
		"StickyHeaderBackgroundColor paints the pinned header row. ItemsPerPageDropdownBackgroundColor paints the items-per-page menu. IsStriped adds a zebra stripe. CellClass styles one column, and RowClassResolver styles each row from its data. A cell component that sets its own color overrides the row color.",
		"/structural/dataTable.templ", stylingUsage,
	) {
		@uiStructural.DataTable(stylingSettings)
	}
}

templ DataTableAppearanceExample() {
	{{
		comfortableSettings := buildDemoStaticTableSettings(
			"data-table-demo-comfortable", "Comfortable table pagination",
			buildDemoTooltipActionColumns(),
			dataTableDemoRecords[:3],
		)
	}}
	{{
		denseSettings := buildDemoStaticTableSettings(
			"data-table-demo-dense", "Dense table pagination",
			buildDemoTooltipActionColumns(),
			dataTableDemoRecords[:3],
		)
	}}
	{{
		denseSettings.Density = uiStructural.DataTableDensityDense
		denseSettings.TextCase = uiToolset.TextCaseUpper
	}}
	{{
		appearanceUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns:  columns,
	Rows:     records,
	Density:  uiStructural.DataTableDensityDense,
	TextCase: uiToolset.TextCaseUpper,
})`
	}}
	<div class="flex flex-col gap-4">
		@DemoExampleHeader(
			"Density and Header Text Case",
			"Density changes the cell padding. TextCase changes the header capitalization. Both tables use the same columns and rows. The last column holds an icon button with a tooltip.",
			"/structural/dataTable.templ", appearanceUsage,
		)
		<div class="grid gap-6 lg:grid-cols-2">
			<div class="flex flex-col gap-2">
				<p class="text-sm text-neutral-400">Comfortable (default), headers as typed</p>
				@uiStructural.DataTable(comfortableSettings)
			</div>
			<div class="flex flex-col gap-2">
				<p class="text-sm text-neutral-400">Dense with uppercase headers</p>
				@uiStructural.DataTable(denseSettings)
			</div>
		</div>
	</div>
}

templ DataTableStaticHeaderExample() {
	{{
		staticSettings := buildDemoStaticTableSettings(
			"data-table-demo-static", "Static header table pagination",
			buildDemoPlainTableColumns(),
			dataTableDemoRecords,
		)
	}}
	{{
		staticSettings.IsHeaderStatic = true
		staticSettings.MinWidthClass = "min-w-96"
		staticSettings.MaxWidthClass = "max-w-2xl"
		staticSettings.MinHeightClass = "min-h-24"
		staticSettings.MaxHeightClass = "max-h-40"
	}}
	{{
		staticUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns:        columns,
	Rows:           records,
	IsHeaderStatic: true,
	MinWidthClass:  "min-w-96",
	MaxWidthClass:  "max-w-2xl",
	MinHeightClass: "min-h-24",
	MaxHeightClass: "max-h-40",
})`
	}}
	@DemoExampleCardStacked(
		"Static Header",
		"The header pins to the top of the scroll viewport by default; IsHeaderStatic lets it scroll away with the body. MinWidthClass and MaxWidthClass size the table surface. MinHeightClass and MaxHeightClass size the scroll viewport. MaxVisibleRows measures the header and the tallest row and caps the viewport to that row count instead; the live table above uses it.",
		"/structural/dataTable.templ", staticUsage,
	) {
		@uiStructural.DataTable(staticSettings)
	}
}

templ DataTablePaginationDisplayExample() {
	{{
		oneBasedSettings := buildDemoStaticTableSettings(
			"data-table-demo-pagination-one-based", "One-based pagination table pagination",
			buildDemoPlainTableColumns(),
			dataTableDemoRecords[:4],
		)
	}}
	{{
		hiddenSettings := buildDemoStaticTableSettings(
			"data-table-demo-pagination-hidden", "Hidden pagination table pagination",
			buildDemoPlainTableColumns(),
			dataTableDemoRecords[:4],
		)
	}}
	{{
		oneBasedSettings.ShouldUseOneBasedPageDisplay = true
		oneBasedSettings.PaginationAriaLabel = "Servers, one-based labels"
		hiddenSettings.IsPaginationHiddenWhenSinglePage = true
		hiddenSettings.PaginationAriaLabel = "Servers, hidden on a single page"
	}}
	{{
		paginationUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns: columns,
	Rows:    records,

	// OptionalFields
	ShouldUseOneBasedPageDisplay:   true,
	IsPaginationHiddenWhenSinglePage: true,
	PaginationAriaLabel:            "Servers",
})`
	}}
	@DemoExampleCardStacked(
		"Pagination Display",
		"Page numbers are zero-based by default; ShouldUseOneBasedPageDisplay shifts the labels to start at 1. IsPaginationHiddenWhenSinglePage hides the page controls when a single page holds every row. PaginationAriaLabel names the footer navigation for screen readers.",
		"/structural/dataTable.templ", paginationUsage,
	) {
		<div class="grid gap-6 lg:grid-cols-2">
			<div class="flex flex-col gap-2">
				<p class="text-sm text-neutral-400">One-based labels</p>
				@uiStructural.DataTable(oneBasedSettings)
			</div>
			<div class="flex flex-col gap-2">
				<p class="text-sm text-neutral-400">Hidden on a single page</p>
				@uiStructural.DataTable(hiddenSettings)
			</div>
		</div>
	}
}

templ DataTableDemoEmptyState() {
	<div class="flex flex-col items-center gap-2 py-2 text-center">
		<i class="ph-duotone ph-tray text-3xl text-neutral-400"></i>
		<p class="text-sm font-bold text-neutral-50">No servers yet</p>
		<p class="text-sm text-neutral-400">Create a server to see it listed here.</p>
	</div>
}

templ DataTableEmptyStateExample() {
	{{
		customEmptySettings := buildDemoStaticTableSettings(
			"data-table-demo-empty-custom", "Custom empty state table pagination",
			buildDemoPlainTableColumns(),
			nil,
		)
	}}
	{{ customEmptySettings.EmptyState = DataTableDemoEmptyState() }}
	{{
		defaultEmptySettings := buildDemoStaticTableSettings(
			"data-table-demo-empty-default", "Default empty state table pagination",
			buildDemoPlainTableColumns(),
			nil,
		)
	}}
	{{
		emptyUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns:    columns,
	Rows:       nil,
	EmptyState: DataTableDemoEmptyState(),
})`
	}}
	<div class="flex flex-col gap-4">
		@DemoExampleHeader(
			"Empty States",
			"With no rows the table renders the EmptyState slot. Without the slot it renders the default message.",
			"/structural/dataTable.templ", emptyUsage,
		)
		<div class="grid gap-6 lg:grid-cols-2">
			<div class="flex flex-col gap-2">
				<p class="text-sm text-neutral-400">Custom EmptyState</p>
				@uiStructural.DataTable(customEmptySettings)
			</div>
			<div class="flex flex-col gap-2">
				<p class="text-sm text-neutral-400">Default empty state</p>
				@uiStructural.DataTable(defaultEmptySettings)
			</div>
		</div>
	</div>
}

templ DataTableDemo() {
	{{ demoTableSettings := buildDemoDataTableSettings(dataTableDemoRecords, 0, dataTableDemoItemsPerPage) }}
	{{
		demoTableSettings.BulkActions = uiControl.Button(uiControl.ButtonSettings{
			Label:           "Clear selection",
			IconLeft:        "ph-trash",
			OnClickFunc:     "selectedRowIds = []",
			Size:            uiControl.ButtonSizeSm,
			BackgroundColor: "red-500/20",
			TextColor:       "red-200",
		})
	}}
	{{
		demoTableSettings.HeaderActions = uiControl.Button(uiControl.ButtonSettings{
			Label:       "Refresh",
			IconLeft:    "ph-arrow-clockwise",
			OnClickFunc: "$dispatch('refresh:data-table-demo')",
			Size:        uiControl.ButtonSizeSm,
		})
	}}
	{{ demoTableSettings.RefreshOnEvents = []string{"refresh:data-table-demo"} }}
	{{ demoTableSettings.MaxVisibleRows = 4 }}
	{{ demoTableSettings.RefreshDebounceMs = 300 }}
	{{
		overviewUsage := `@uiStructural.DataTable(uiStructural.DataTableSettings[Record]{
	Columns:          columns,
	Rows:             records,
	QueryUrlTemplate: "/records?page={pageNumber}&sort={sortKey}&direction={sortDirection}&search={search}",

	// OptionalFields
	Filters:              filters,
	RowIdResolver:        func(record Record) string { return record.Id },
	RefreshOnEvents:      []string{"refresh:records-table"},
	RefreshDebounceMs:    300,
	MaxVisibleRows:       4,
	InitialSortKey:       "name",
	InitialSortDirection: uiStructural.DataTableSortDirectionAsc,
})`
	}}
	<div class="flex flex-col gap-6" id="data-table-demo">
		@DemoComponentSection(DemoComponentSectionSettings{
			ComponentPath:          "/structural/dataTable.templ",
			Description:            "A data table renders rows from column definitions with sorting, selection, filters, search, and pagination. Every change refreshes the table from the server through the URL template. The examples below cover the full settings surface.",
			LiveExampleDescription: "The complete server-driven table: filters, search, sorting, selection, bulk and header actions, and pagination.",
			Title:                  ".DataTable",
			UsageCode:              overviewUsage,
		}) {
			<div class="flex flex-col gap-4" x-data="{ isFileUrl: window.location.protocol === 'file:' }">
				<div x-show="!isFileUrl">
					@uiDisplay.Alert(uiDisplay.AlertSettings{
						Title:       "This table needs a server response",
						Description: "Every sort, filter, search, or page change sends a request. A real application returns the requested rows. This static demo returns fixed pages from one docs/assets file: paging works, and sorting, filtering, and search do not change the rows.",
						Variation:   uiDisplay.AlertVariationInfo,
						Size:        uiDisplay.AlertSizeMd,
					})
				</div>
				<div x-show="isFileUrl" style="display: none">
					@uiDisplay.Alert(uiDisplay.AlertSettings{
						Title:       "Open this page through a web server",
						Description: "Browsers block refresh requests from file:// pages, so the table cannot page or refresh here. Serve the docs folder over HTTP and open the served URL.",
						Variation:   uiDisplay.AlertVariationWarning,
						Size:        uiDisplay.AlertSizeMd,
					})
				</div>
				@uiToolset.MinifierTemplateJs(&dataTableDemoRoutingScript)
				@uiStructural.DataTable(demoTableSettings)
			</div>
		}
		<div class="flex flex-col gap-4">
			<div class="flex flex-col gap-1">
				<p class="text-lg font-bold">Advanced Examples</p>
				<p class="text-sm text-neutral-400">
					The panels below hold static tables. They send no requests, so you can inspect the layout and the configuration without a server. Open a panel to see the settings and the rendered result.
				</p>
			</div>
			@uiDisplay.Accordion(uiDisplay.AccordionSettings{
				Items: []uiDisplay.AccordionItemSettings{
					{Title: "Column Configuration", Icon: "ph-columns", Content: DataTableColumnConfigExample()},
					{Title: "Rows Configuration", Icon: "ph-list-numbers", Content: DataTableRowsConfigExample()},
					{Title: "Filters", Icon: "ph-funnel", Content: DataTableFiltersExample()},
					{Title: "Search Box", Icon: "ph-magnifying-glass", Content: DataTableSearchBoxExample()},
					{Title: "Header Actions", Icon: "ph-wrench", Content: DataTableHeaderActionsExample()},
					{Title: "Bulk Actions", Icon: "ph-checks", Content: DataTableBulkActionsExample()},
					{Title: "Row and Column Styling", Icon: "ph-paint-brush", Content: DataTableStylingExample()},
					{Title: "Density and Header Text Case", Icon: "ph-text-aa", Content: DataTableAppearanceExample()},
					{Title: "Static Header", Icon: "ph-arrow-line-down", Content: DataTableStaticHeaderExample()},
					{Title: "Pagination Display", Icon: "ph-number-circle-one", Content: DataTablePaginationDisplayExample()},
					{Title: "Empty States", Icon: "ph-tray", Content: DataTableEmptyStateExample()},
				},
			})
		</div>
	</div>
}

templ DataTableRefreshFragment(pageNumber uint, itemsPerPage uiStructural.ItemsPerPage) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>DataTable Refresh Fragment</title>
		</head>
		<body>
			@uiStructural.DataTable(buildDemoDataTableSettings(dataTableDemoRecords, pageNumber, itemsPerPage))
		</body>
	</html>
}
