package main

import (
	uiControl "github.com/goinfinite/ui/src/control"
	uiDisplay "github.com/goinfinite/ui/src/display"
	uiToolset "github.com/goinfinite/ui/src/toolset"
)

templ RangeSliderSizesExample() {
	{{
		sizesUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbValueTwoWayStatePath: "sliderValue",

	// OptionalFields
	Size: uiControl.RangeSliderSizeMd,
})`
	}}
	@DemoExampleCard(
		"Sizes", "Size scales the track, thumb, and labels: xs, sm, md, lg, or xl.",
		"/control/rangeSlider.templ", sizesUsage,
	) {
		<div class="flex flex-col gap-3" x-data="{sliderValue: 50}">
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Size:                      uiControl.RangeSliderSizeXs,
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Size:                      uiControl.RangeSliderSizeSm,
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Size:                      uiControl.RangeSliderSizeMd,
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Size:                      uiControl.RangeSliderSizeLg,
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Size:                      uiControl.RangeSliderSizeXl,
			})
		</div>
	}
}

templ RangeSliderThumbShapesExample() {
	{{
		shapesUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbValueTwoWayStatePath: "sliderValue",

	// OptionalFields
	Thumb: uiControl.RangeSliderThumbSettings{Shape: uiToolset.ShapeCircular},
})`
	}}
	@DemoExampleCard(
		"Thumb Shapes",
		"Thumb.Shape draws the thumb as circular, rounded, square, or pipe.",
		"/control/rangeSlider.templ", shapesUsage,
	) {
		<div class="flex flex-col gap-3" x-data="{sliderValue: 50}">
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					Shape: uiToolset.ShapeCircular,
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					Shape: uiToolset.ShapeRounded,
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					Shape: uiToolset.ShapeSquare,
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					Shape: uiControl.RangeSliderThumbShapePipe,
				},
			})
		</div>
	}
}

templ RangeSliderThumbColorsExample() {
	{{
		colorsUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbValueTwoWayStatePath: "sliderValue",

	// OptionalFields
	Thumb: uiControl.RangeSliderThumbSettings{
		BackgroundColor:      "emerald-500",
		TextColor:            "neutral-50",
		Label:                "A",
		LabelIcon:            "ph-check",
		LabelOneWayStatePath: "sliderValue",
	},
})`
	}}
	@DemoExampleCard(
		"Thumb Colors & Icons",
		"Thumb background and text colors accept Tailwind tokens. Thumb.Label prints static text on the thumb, Thumb.LabelIcon stamps an icon on it, and Thumb.LabelOneWayStatePath prints live state on it.",
		"/control/rangeSlider.templ", colorsUsage,
	) {
		<div class="flex flex-col gap-3" x-data="{sliderValue: 50}">
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					BackgroundColor: "red-500",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					BackgroundColor: "emerald-500",
					LabelIcon:       "ph-check",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					BackgroundColor: "secondary-500",
					TextColor:       "neutral-800",
					LabelIcon:       "ph-star",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					BackgroundColor:      "secondary-500",
					TextColor:            "neutral-50",
					LabelOneWayStatePath: "sliderValue",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					BackgroundColor: "primary-500",
					TextColor:       "neutral-50",
					Label:           "A",
				},
			})
		</div>
	}
}

templ RangeSliderValueBubbleExample() {
	{{
		bubbleUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbValueTwoWayStatePath: "sliderValue",

	// OptionalFields
	Thumb: uiControl.RangeSliderThumbSettings{
		ValueBubbleEnabled:         true,
		ValueBubbleDisplayMode:     uiControl.RangeSliderThumbValueBubbleDisplayModeHover,
		ValueBubblePosition:        uiControl.RangeSliderThumbValueBubblePositionTop,
		ValueBubbleBackgroundColor: "red-500",
		ValueBubbleTextColor:       "neutral-50",
		ValueBubbleSize:            uiControl.RangeSliderThumbValueBubbleSizeLg,
		ValueBubbleShape:           uiToolset.ShapeRounded,
		ValueBubbleRingColor:       "violet-500",
		ValueBubbleRingThickness:   uiToolset.RingThicknessXl,
	},
})`
	}}
	@DemoExampleCard(
		"Value Bubble",
		"Thumb.ValueBubbleEnabled shows the live value above or below the thumb. The default display mode always shows it; ValueBubbleDisplayModeHover shows it only while the slider is hovered or dragged. Bubble colors, size, shape, ring, and position style it.",
		"/control/rangeSlider.templ", bubbleUsage,
	) {
		<div class="flex flex-col gap-3" x-data="{sliderValue: 50}">
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					ValueBubbleEnabled:         true,
					ValueBubblePosition:        uiControl.RangeSliderThumbValueBubblePositionTop,
					ValueBubbleBackgroundColor: "red-500",
					ValueBubbleTextColor:       "neutral-50",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					ValueBubbleEnabled:         true,
					ValueBubblePosition:        uiControl.RangeSliderThumbValueBubblePositionBottom,
					ValueBubbleBackgroundColor: "emerald-500",
					ValueBubbleTextColor:       "neutral-50",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					ValueBubbleEnabled:         true,
					ValueBubblePosition:        uiControl.RangeSliderThumbValueBubblePositionTop,
					ValueBubbleBackgroundColor: "transparent",
					ValueBubbleTextColor:       "neutral-50",
					ValueBubbleSize:            uiControl.RangeSliderThumbValueBubbleSizeLg,
					ValueBubbleShape:           uiToolset.ShapeRounded,
					ValueBubbleRingColor:       "violet-500",
					ValueBubbleRingThickness:   uiToolset.RingThicknessXl,
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					ValueBubbleEnabled:     true,
					ValueBubbleDisplayMode: uiControl.RangeSliderThumbValueBubbleDisplayModeHover,
					ValueBubblePosition:    uiControl.RangeSliderThumbValueBubblePositionTop,
					AriaLabel:              "Hover bubble",
				},
			})
		</div>
	}
}

templ RangeSliderTrackLabelsExample() {
	{{
		labelsUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbValueTwoWayStatePath:      "sliderValue",
	TrackStartValueOneWayStatePath: "rangeStart",
	TrackEndValueOneWayStatePath:   "rangeEnd",

	// OptionalFields
	Track: uiControl.RangeSliderTrackSettings{
		StartValueLabelEnabled:  true,
		StartValueLabelPosition: uiControl.RangeSliderTrackValueLabelPositionTop,
		StartValueLabelIcon:     "ph-arrow-left",
		EndValueLabelEnabled:    true,
		EndValueLabelPosition:   uiControl.RangeSliderTrackValueLabelPositionTop,
		EndValueLabelIcon:       "ph-arrow-right",
	},
})`
	}}
	@DemoExampleCard(
		"Track Labels",
		"Track start and end labels print the range bounds from static values or Alpine state. Their position moves the labels above or below the track, and their icons mark each bound.",
		"/control/rangeSlider.templ", labelsUsage,
	) {
		<div class="flex flex-col gap-3" x-data="{sliderValue: 50, rangeStart: 0, rangeEnd: 100}">
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				TrackStartValue:           "0",
				TrackEndValue:             "100",
				Track: uiControl.RangeSliderTrackSettings{
					StartValueLabelEnabled: true,
					EndValueLabelEnabled:   true,
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				TrackStartValue:           "0",
				TrackEndValue:             "100",
				Track: uiControl.RangeSliderTrackSettings{
					StartValueLabelEnabled:  true,
					StartValueLabelPosition: uiControl.RangeSliderTrackValueLabelPositionTop,
					EndValueLabelEnabled:    true,
					EndValueLabelPosition:   uiControl.RangeSliderTrackValueLabelPositionTop,
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				TrackStartValue:           "0",
				TrackEndValue:             "100",
				Track: uiControl.RangeSliderTrackSettings{
					StartValueLabelEnabled:  true,
					StartValueLabelPosition: uiControl.RangeSliderTrackValueLabelPositionBottom,
					EndValueLabelEnabled:    true,
					EndValueLabelPosition:   uiControl.RangeSliderTrackValueLabelPositionBottom,
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath:      "sliderValue",
				TrackStartValueOneWayStatePath: "rangeStart",
				TrackEndValueOneWayStatePath:   "rangeEnd",
				Track: uiControl.RangeSliderTrackSettings{
					StartValueLabelEnabled:  true,
					StartValueLabelPosition: uiControl.RangeSliderTrackValueLabelPositionTop,
					StartValueLabelIcon:     "ph-arrow-left",
					EndValueLabelEnabled:    true,
					EndValueLabelPosition:   uiControl.RangeSliderTrackValueLabelPositionTop,
					EndValueLabelIcon:       "ph-arrow-right",
				},
			})
		</div>
	}
}

templ RangeSliderTrackColorsExample() {
	{{
		trackUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbValueTwoWayStatePath: "sliderValue",
	TrackStartValue:           "0",
	TrackEndValue:             "100",

	// OptionalFields
	Track: uiControl.RangeSliderTrackSettings{
		BackgroundColor:          "neutral-50/15",
		BackgroundColorFrom:      "red-500",
		BackgroundColorVia:       "emerald-500",
		BackgroundColorTo:        "cyan-500",
		FillColor:                "sky-500",
		FillColorVia:             "yellow-500",
		StartValueLabelTextColor: "red-500",
		EndValueLabelTextColor:   "cyan-500",
	},
})`
	}}
	@DemoExampleCard(
		"Track Colors & Icons",
		"Track background colors paint a solid or gradient track, and Track.FillColor paints the filled span. Label text colors and icons mark the bounds.",
		"/control/rangeSlider.templ", trackUsage,
	) {
		<div class="flex flex-col gap-3" x-data="{sliderValue: 50}">
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				TrackStartValue:           "0",
				TrackEndValue:             "100",
				Track: uiControl.RangeSliderTrackSettings{
					BackgroundColor:          "neutral-50/15",
					FillColor:                "sky-500",
					StartValueLabelEnabled:   true,
					StartValueLabelTextColor: "red-500",
					EndValueLabelEnabled:     true,
					EndValueLabelTextColor:   "cyan-500",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				TrackStartValue:           "0",
				TrackEndValue:             "100",
				Track: uiControl.RangeSliderTrackSettings{
					BackgroundColorFrom:      "red-500",
					BackgroundColorVia:       "emerald-500",
					BackgroundColorTo:        "cyan-500",
					FillColorFrom:            "red-500",
					FillColorVia:             "yellow-500",
					FillColorTo:              "emerald-500",
					StartValueLabelEnabled:   true,
					StartValueLabelTextColor: "red-500",
					EndValueLabelEnabled:     true,
					EndValueLabelTextColor:   "cyan-500",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				Size:                      uiControl.RangeSliderSizeLg,
				ThumbValueTwoWayStatePath: "sliderValue",
				TrackStartValue:           "0",
				TrackEndValue:             "100",
				Track: uiControl.RangeSliderTrackSettings{
					BackgroundColorFrom:      "amber-500",
					BackgroundColorTo:        "sky-700",
					StartValueLabelEnabled:   false,
					StartValueLabelIcon:      "ph-sun",
					StartValueLabelTextColor: "amber-500",
					EndValueLabelEnabled:     false,
					EndValueLabelIcon:        "ph-moon-stars",
					EndValueLabelTextColor:   "sky-700",
				},
			})
		</div>
	}
}

templ RangeSliderStepsTicksExample() {
	{{
		stepsUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbValueTwoWayStatePath: "sliderValue",

	// OptionalFields
	TrackSteps: "20",
	Track: uiControl.RangeSliderTrackSettings{
		TicksEnabled: true,
		TickStep:     "25",
	},
})`
	}}
	@DemoExampleCard(
		"Steps & Ticks",
		"TrackSteps snaps the thumb to increments. Track.TicksEnabled draws tick marks every Track.TickStep.",
		"/control/rangeSlider.templ", stepsUsage,
	) {
		<div class="flex flex-col gap-3" x-data="{sliderValue: 50}">
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Ticks every 25",
				},
				Track: uiControl.RangeSliderTrackSettings{
					TicksEnabled: true,
					TickStep:     "25",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				TrackSteps:                "20",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Ticks every step",
				},
				Track: uiControl.RangeSliderTrackSettings{
					TicksEnabled: true,
				},
			})
		</div>
	}
}

templ RangeSliderTrackTooltipExample() {
	{{
		tooltipUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbValueTwoWayStatePath: "sliderValue",

	// OptionalFields
	Track: uiControl.RangeSliderTrackSettings{
		TooltipEnabled:         true,
		TooltipPosition:        uiControl.RangeSliderTrackTooltipPositionTop,
		TooltipBackgroundColor: "primary-500",
		TooltipTextColor:       "neutral-50",
		TooltipRingColor:       "primary-200",
		TooltipRingThickness:   uiToolset.RingThicknessMd,
	},
})`
	}}
	@DemoExampleCard(
		"Track Tooltip",
		"Track.TooltipEnabled previews the value under the pointer as it moves along the track. The preview snaps to TrackSteps and clamps to the track bounds. Track.TooltipRingColor and Track.TooltipRingThickness outline it.",
		"/control/rangeSlider.templ", tooltipUsage,
	) {
		<div
			class="flex flex-col gap-3"
			x-data="{sliderValue: 50, fractionValue: 0.3, tinyValue: 0.0000003, unalignedValue: 60, alignedValue: 0.3}"
		>
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "sliderValue",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Tooltip top",
				},
				Track: uiControl.RangeSliderTrackSettings{
					TooltipEnabled:         true,
					TooltipPosition:        uiControl.RangeSliderTrackTooltipPositionTop,
					TooltipBackgroundColor: "primary-500",
					TooltipTextColor:       "neutral-50",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "fractionValue",
				TrackStartValue:           "0",
				TrackEndValue:             "1",
				TrackSteps:                "0.1",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Tooltip bottom",
				},
				Track: uiControl.RangeSliderTrackSettings{
					TooltipEnabled:         true,
					TooltipPosition:        uiControl.RangeSliderTrackTooltipPositionBottom,
					TooltipBackgroundColor: "emerald-500",
					TooltipTextColor:       "neutral-50",
					TooltipRingColor:       "emerald-200",
					TooltipRingThickness:   uiToolset.RingThicknessMd,
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "tinyValue",
				TrackStartValue:           "0",
				TrackEndValue:             "0.000001",
				TrackSteps:                "0.0000001",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Tooltip tiny step",
				},
				Track: uiControl.RangeSliderTrackSettings{
					TooltipEnabled:         true,
					TooltipPosition:        uiControl.RangeSliderTrackTooltipPositionTop,
					TooltipBackgroundColor: "amber-500",
					TooltipTextColor:       "neutral-50",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "unalignedValue",
				TrackStartValue:           "0",
				TrackEndValue:             "100",
				TrackSteps:                "60",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Tooltip unaligned",
				},
				Track: uiControl.RangeSliderTrackSettings{
					TooltipEnabled:         true,
					TooltipPosition:        uiControl.RangeSliderTrackTooltipPositionTop,
					TooltipBackgroundColor: "secondary-500",
					TooltipTextColor:       "neutral-50",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath: "alignedValue",
				TrackStartValue:           "0",
				TrackEndValue:             "0.3",
				TrackSteps:                "0.1",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Tooltip aligned decimal",
				},
				Track: uiControl.RangeSliderTrackSettings{
					TooltipEnabled:         true,
					TooltipPosition:        uiControl.RangeSliderTrackTooltipPositionTop,
					TooltipBackgroundColor: "primary-500",
					TooltipTextColor:       "neutral-50",
				},
			})
		</div>
	}
}

templ RangeSliderDualModeExample() {
	{{
		dualUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbDualValueModeEnabled:      true,
	ThumbValueTwoWayStatePath:      "lowerValue",
	ThumbUpperValueTwoWayStatePath: "upperValue",
	TrackStartValue:                "0",
	TrackEndValue:                  "100",

	// OptionalFields
	Thumb: uiControl.RangeSliderThumbSettings{
		AriaLabel:            "Minimum price",
		ValueBubbleEnabled:   true,
		ValueBubbleRingColor: "emerald-200",
	},
	ThumbUpper: uiControl.RangeSliderThumbSettings{
		AriaLabel:                  "Maximum price",
		TextColor:                  "neutral-50",
		Label:                      "Max",
		LabelIcon:                  "ph-arrow-up",
		LabelOneWayStatePath:       "upperValue",
		ValueBubbleEnabled:         true,
		ValueBubbleDisplayMode:     uiControl.RangeSliderThumbValueBubbleDisplayModeHover,
		ValueBubbleTextColor:       "neutral-50",
		ValueBubbleRingColor:       "red-700",
		ValueBubbleRingThickness:   uiToolset.RingThicknessLg,
		ValueBubbleSize:            uiControl.RangeSliderThumbValueBubbleSizeLg,
	},
})`
	}}
	@DemoExampleCard(
		"Dual-Thumb Mode",
		"ThumbDualValueModeEnabled turns the slider into a range picker. Each thumb binds its own state path and aria label. ThumbUpper takes its own colors, labels, icons, and bubble styling.",
		"/control/rangeSlider.templ", dualUsage,
	) {
		<div x-data="{lowerValue: 25, upperValue: 75}" class="flex flex-col gap-3">
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbDualValueModeEnabled:      true,
				ThumbValueTwoWayStatePath:      "lowerValue",
				ThumbUpperValueTwoWayStatePath: "upperValue",
				TrackStartValue:                "0",
				TrackEndValue:                  "100",
				TrackSteps:                     "1",
				Thumb: uiControl.RangeSliderThumbSettings{
					BackgroundColor:      "emerald-500",
					AriaLabel:            "Minimum price",
					ValueBubbleEnabled:   true,
					ValueBubbleRingColor: "emerald-200",
					ValueBubbleRingThickness: uiToolset.RingThicknessSm,
				},
				ThumbUpper: uiControl.RangeSliderThumbSettings{
					AriaLabel:                "Maximum price",
					TextColor:                "neutral-50",
					ValueBubbleEnabled:       true,
					ValueBubbleDisplayMode:   uiControl.RangeSliderThumbValueBubbleDisplayModeHover,
					ValueBubbleTextColor:     "neutral-50",
					ValueBubbleRingColor:     "red-700",
					ValueBubbleRingThickness: uiToolset.RingThicknessLg,
					ValueBubbleSize:          uiControl.RangeSliderThumbValueBubbleSizeLg,
				},
				Track: uiControl.RangeSliderTrackSettings{
					StartValueLabelEnabled: true,
					EndValueLabelEnabled:   true,
				},
			})
			<p class={ DemoLiveStateClasses }>Price Range: $<span x-text="lowerValue"></span> - $<span x-text="upperValue"></span></p>
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbDualValueModeEnabled:      true,
				ThumbValueTwoWayStatePath:      "lowerValue",
				ThumbUpperValueTwoWayStatePath: "upperValue",
				TrackSteps:                     "1",
				TrackStartValue:                "0",
				TrackEndValue:                  "100",
				Thumb: uiControl.RangeSliderThumbSettings{
					Shape:                      uiControl.RangeSliderThumbShapePipe,
					BackgroundColor:            "emerald-500",
					ValueBubbleBackgroundColor: "emerald-500",
					ValueBubblePosition:        uiControl.RangeSliderThumbValueBubblePositionBottom,
					ValueBubbleShape:           uiToolset.ShapeSquare,
					ValueBubbleEnabled:         true,
				},
				ThumbUpper: uiControl.RangeSliderThumbSettings{
					BackgroundColor:            "red-500",
					ValueBubbleBackgroundColor: "red-500",
					ValueBubblePosition:        uiControl.RangeSliderThumbValueBubblePositionTop,
					ValueBubbleShape:           uiToolset.ShapeCircular,
					ValueBubbleEnabled:         true,
				},
				Track: uiControl.RangeSliderTrackSettings{
					FillColorFrom:          "emerald-500",
					FillColorTo:            "red-500",
					StartValueLabelEnabled: true,
					EndValueLabelEnabled:   true,
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbDualValueModeEnabled:      true,
				ThumbValueTwoWayStatePath:      "lowerValue",
				ThumbUpperValueTwoWayStatePath: "upperValue",
				TrackStartValue:                "0",
				TrackEndValue:                  "100",
				TrackSteps:                     "1",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Upper label minimum",
				},
				ThumbUpper: uiControl.RangeSliderThumbSettings{
					AriaLabel:            "Upper label maximum",
					Label:                "Max",
					LabelIcon:            "ph-arrow-up",
					LabelOneWayStatePath: "upperValue",
				},
			})
		</div>
	}
}

templ RangeSliderStaticValuesExample() {
	{{
		staticValuesUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbDualValueModeEnabled: true,
	ThumbValue:                "25",
	ThumbUpperValue:           "75",

	// OptionalFields
	TrackStartValue: "0",
	TrackEndValue:   "100",
})`
	}}
	@DemoExampleCard(
		"Static Thumb Values",
		"ThumbValue places one thumb without binding Alpine state. In dual mode ThumbUpperValue places the upper thumb.",
		"/control/rangeSlider.templ", staticValuesUsage,
	) {
		<div class="flex flex-col gap-3">
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValue:      "30",
				TrackStartValue: "0",
				TrackEndValue:   "100",
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbDualValueModeEnabled: true,
				ThumbValue:                "25",
				ThumbUpperValue:           "75",
				TrackStartValue:           "0",
				TrackEndValue:             "100",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Static minimum",
				},
				ThumbUpper: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Static maximum",
				},
			})
		</div>
	}
}

templ RangeSliderNormalizationExample() {
	{{
		normalizeUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbDualValueModeEnabled:      true,
	ThumbValueTwoWayStatePath:      "lowerValue",
	ThumbUpperValueTwoWayStatePath: "upperValue",

	// OptionalFields
	ShouldNormalizeInitialState: true,
	TrackStartValue:             "0",
	TrackEndValue:               "100",
})`
	}}
	@DemoExampleCard(
		"Initial State Normalization",
		"ShouldNormalizeInitialState orders crossed thumbs and pulls out-of-range values back into the track on load. Without it the thumbs start where the state says.",
		"/control/rangeSlider.templ", normalizeUsage,
	) {
		<div id="range-slider-initial-state-demo" x-data="{lowerValue: 80, upperValue: 20, overflowLowerValue: 150, overflowUpperValue: 20, sliderValue: 150}" class="flex flex-col gap-3">
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbDualValueModeEnabled:      true,
				ThumbValueTwoWayStatePath:      "lowerValue",
				ThumbUpperValueTwoWayStatePath: "upperValue",
				ShouldNormalizeInitialState:    true,
				TrackStartValue:                "0",
				TrackEndValue:                  "100",
				TrackSteps:                     "1",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Initial minimum",
				},
				ThumbUpper: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Initial maximum",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbDualValueModeEnabled:      true,
				ThumbValueTwoWayStatePath:      "overflowLowerValue",
				ThumbUpperValueTwoWayStatePath: "overflowUpperValue",
				ShouldNormalizeInitialState:    true,
				TrackStartValue:                "0",
				TrackEndValue:                  "100",
				TrackSteps:                     "1",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Overflow minimum",
				},
				ThumbUpper: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Overflow maximum",
				},
			})
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbValueTwoWayStatePath:   "sliderValue",
				ShouldNormalizeInitialState: true,
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Initial single value",
				},
			})
			<p class={ DemoLiveStateClasses }>Normalized Range: $<span x-text="lowerValue"></span> - $<span x-text="upperValue"></span>, Overflow Range: $<span x-text="overflowLowerValue"></span> - $<span x-text="overflowUpperValue"></span>, Slider: <span x-text="sliderValue"></span></p>
		</div>
		<div id="range-slider-unnormalized-demo" x-data="{lowerValue: 80, upperValue: 20}" class="mt-4 flex flex-col gap-3">
			@uiControl.RangeSlider(uiControl.RangeSliderSettings{
				ThumbDualValueModeEnabled:      true,
				ThumbValueTwoWayStatePath:      "lowerValue",
				ThumbUpperValueTwoWayStatePath: "upperValue",
				TrackStartValue:                "0",
				TrackEndValue:                  "100",
				TrackSteps:                     "1",
				Thumb: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Raw minimum",
				},
				ThumbUpper: uiControl.RangeSliderThumbSettings{
					AriaLabel: "Raw maximum",
				},
			})
			<p class={ DemoLiveStateClasses }>Raw Range: $<span x-text="lowerValue"></span> - $<span x-text="upperValue"></span></p>
		</div>
	}
}

templ RangeSliderDemo() {
	{{
		demoUsage := `@uiControl.RangeSlider(uiControl.RangeSliderSettings{
	ThumbValueTwoWayStatePath: "sliderValue",

	// OptionalFields
	TrackStartValue: "0",
	TrackEndValue:   "100",
})`
	}}
	<div class="flex flex-col gap-4" id="range-slider-demo">
		@DemoComponentSection(DemoComponentSectionSettings{
			ComponentPath:          "/control/rangeSlider.templ",
			Description:            "A range slider allows users to select a value from a range by dragging a thumb along a track.",
			LiveExampleDescription: "A slider bound to one numeric Alpine state path. Drag the thumb or use the arrow keys.",
			Title:                  ".RangeSlider",
			UsageCode:              demoUsage,
			AlpineStateCode:        `<div x-data="{sliderValue: 50}"></div>`,
		}) {
			<div x-data="{sliderValue: 50}" class="flex w-full flex-col gap-2">
				@uiControl.RangeSlider(uiControl.RangeSliderSettings{
					ThumbValueTwoWayStatePath: "sliderValue",
				})
				<p class={ DemoLiveStateClasses }>Value: <span x-text="sliderValue"></span></p>
			</div>
		}
		@DemoAdvancedExamples("range-slider-demo", []uiDisplay.AccordionItemSettings{
			{Title: "Sizes", Icon: "ph-ruler", Content: RangeSliderSizesExample()},
			{Title: "Thumb Shapes", Icon: "ph-square", Content: RangeSliderThumbShapesExample()},
			{Title: "Thumb Colors & Icons", Icon: "ph-palette", Content: RangeSliderThumbColorsExample()},
			{Title: "Value Bubble", Icon: "ph-chat-circle-text", Content: RangeSliderValueBubbleExample()},
			{Title: "Track Labels", Icon: "ph-tag", Content: RangeSliderTrackLabelsExample()},
			{Title: "Track Colors & Icons", Icon: "ph-paint-brush", Content: RangeSliderTrackColorsExample()},
			{Title: "Steps & Ticks", Icon: "ph-dots-nine", Content: RangeSliderStepsTicksExample()},
			{Title: "Track Tooltip", Icon: "ph-cursor-click", Content: RangeSliderTrackTooltipExample()},
			{Title: "Dual-Thumb Mode", Icon: "ph-arrows-left-right", Content: RangeSliderDualModeExample()},
			{Title: "Static Thumb Values", Icon: "ph-hash", Content: RangeSliderStaticValuesExample()},
			{Title: "Initial State Normalization", Icon: "ph-sort-ascending", Content: RangeSliderNormalizationExample()},
		})
	</div>
}
