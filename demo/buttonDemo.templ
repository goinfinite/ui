package main

import (
	uiControl "github.com/goinfinite/ui/src/control"
	uiDisplay "github.com/goinfinite/ui/src/display"
	uiToolset "github.com/goinfinite/ui/src/toolset"
)

templ ButtonSizesExample() {
	{{
		sizesUsage := `@uiControl.Button(uiControl.ButtonSettings{
	Label: "Button",

	// OptionalFields
	Size: uiControl.ButtonSizeMd,
})`
	}}
	@DemoExampleCard(
		"Sizes", "Size scales the button and its type: xs, sm, md, lg, or xl.",
		"/control/button.templ", sizesUsage,
	) {
		<div class="flex flex-col gap-2">
			@uiControl.Button(uiControl.ButtonSettings{
				Label:    "Button",
				IconLeft: "ph-info",
				Size:     uiControl.ButtonSizeXs,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:    "Button",
				IconLeft: "ph-info",
				Size:     uiControl.ButtonSizeSm,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:    "Button",
				IconLeft: "ph-info",
				Size:     uiControl.ButtonSizeMd,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:    "Button",
				IconLeft: "ph-info",
				Size:     uiControl.ButtonSizeLg,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:    "Button",
				IconLeft: "ph-info",
				Size:     uiControl.ButtonSizeXl,
			})
		</div>
	}
}

templ ButtonShapesExample() {
	{{
		shapesUsage := `@uiControl.Button(uiControl.ButtonSettings{
	Label: "Button",

	// OptionalFields
	Shape: uiToolset.ShapeRounded,
})`
	}}
	@DemoExampleCard(
		"Shapes", "Shape rounds the button frame: square, rounded, or circular.",
		"/control/button.templ", shapesUsage,
	) {
		<div class="flex flex-col gap-2">
			@uiControl.Button(uiControl.ButtonSettings{
				Label: "Square",
				Shape: uiToolset.ShapeSquare,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label: "Rounded",
				Shape: uiToolset.ShapeRounded,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label: "Circular",
				Shape: uiToolset.ShapeCircular,
			})
		</div>
	}
}

templ ButtonIconsExample() {
	{{
		iconsUsage := `@uiControl.Button(uiControl.ButtonSettings{
	Label:   "Upload",
	IconTop: "ph-cloud-arrow-up",

	// OptionalFields
	IconLeft:                 "ph-folder",
	IconLeftOneWayStatePath:  "leftIconClass",
	IconRight:                "ph-arrow-right",
	IconRightOneWayStatePath: "rightIconClass",
})`
	}}
	@DemoExampleCard(
		"Icons",
		"IconLeft and IconRight flank the label with Phosphor icons. IconTop renders above the label and combines with both side icons. The state paths bind each icon class to Alpine state.",
		"/control/button.templ", iconsUsage,
	) {
		<div
			class="flex flex-col gap-3"
			x-data="{leftIconClass: 'ph-lightning', rightIconClass: 'ph-check-circle'}"
		>
			<div class="flex flex-wrap items-center gap-3">
				@uiControl.Button(uiControl.ButtonSettings{
					Label:    "Info",
					IconLeft: "ph-info",
				})
				@uiControl.Button(uiControl.ButtonSettings{
					Label:     "Warning",
					IconRight: "ph-warning",
				})
				@uiControl.Button(uiControl.ButtonSettings{
					Label:                    "Dynamic Icons",
					IconLeftOneWayStatePath:  "leftIconClass",
					IconRightOneWayStatePath: "rightIconClass",
				})
			</div>
			<div class="flex flex-wrap items-center gap-3">
				@uiControl.Button(uiControl.ButtonSettings{
					Label:     "Upload",
					IconTop:   "ph-cloud-arrow-up",
					IconLeft:  "ph-folder",
					IconRight: "ph-arrow-right",
				})
				@uiControl.Button(uiControl.ButtonSettings{
					Label:           "Sync",
					IconTop:         "ph-arrows-clockwise",
					BackgroundColor: "primary-600",
				})
				@uiControl.Button(uiControl.ButtonSettings{
					IconTop:   "ph-plus",
					AriaLabel: "Add",
					Shape:     uiToolset.ShapeCircular,
				})
				@uiControl.Button(uiControl.ButtonSettings{
					IconTop:           "ph-heart",
					AriaLabel:         "Favorite",
					ShouldTrackAction: true,
					OnClickFunc:       "Promise.resolve()",
					Shape:             uiToolset.ShapeCircular,
				})
			</div>
		</div>
	}
}

templ ButtonColorsExample() {
	{{
		colorsUsage := `@uiControl.Button(uiControl.ButtonSettings{
	Label: "Save",

	// OptionalFields
	BackgroundColor:      "emerald-500",
	BackgroundColorHover: "emerald-600",
	TextColor:            "neutral-50",
	TextColorHover:       "neutral-50",
})`
	}}
	@DemoExampleCard(
		"Colors",
		"Background and text colors accept Tailwind tokens. The Hover variants paint the hover state.",
		"/control/button.templ", colorsUsage,
	) {
		<div class="flex flex-col gap-2">
			@uiControl.Button(uiControl.ButtonSettings{
				Label:    "Default",
				IconLeft: "ph-info",
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:           "Red",
				IconLeft:        "ph-warning",
				BackgroundColor: "red-500",
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:           "Green",
				IconRight:       "ph-check",
				BackgroundColor: "emerald-500",
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:           "Secondary",
				IconLeft:        "ph-star",
				BackgroundColor: "secondary-500",
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:                "Hover Text",
				IconLeft:             "ph-cursor-click",
				BackgroundColor:      "sky-500/10",
				BackgroundColorHover: "sky-500/20",
				TextColor:            "sky-200",
				TextColorHover:       "sky-50",
			})
		</div>
	}
}

templ ButtonRingsExample() {
	{{
		ringsUsage := `@uiControl.Button(uiControl.ButtonSettings{
	Label: "Red Ring",

	// OptionalFields
	BackgroundColor:      "red-500/10",
	BackgroundColorHover: "red-500/20",
	RingColor:            "red-500",
	RingColorHover:       "red-400",
	RingThickness:        uiToolset.RingThicknessMd,
})`
	}}
	@DemoExampleCard(
		"Rings",
		"RingColor and RingThickness outline the button. The Hover variants paint the hover ring.",
		"/control/button.templ", ringsUsage,
	) {
		<div class="flex flex-col gap-3">
			@uiControl.Button(uiControl.ButtonSettings{
				Label:           "Red Ring",
				BackgroundColor: "red-500/10",
				RingColor:       "red-500",
				RingThickness:   uiToolset.RingThicknessMd,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:                "Green Hover",
				BackgroundColor:      "yellow-500/10",
				BackgroundColorHover: "green-500/10",
				RingColor:            "yellow-500",
				RingColorHover:       "green-500",
				RingThickness:        uiToolset.RingThicknessMd,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:         "ThicknessXs",
				RingColor:     "blue-500",
				RingThickness: uiToolset.RingThicknessXs,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:         "ThicknessXl",
				RingColor:     "violet-500",
				RingThickness: uiToolset.RingThicknessXl,
			})
		</div>
	}
}

templ ButtonTooltipHtmlContent() {
	<span class="flex items-center gap-1">
		<i class="ph-bold ph-check text-emerald-300"></i>
		Rich tooltip content
	</span>
}

templ ButtonTooltipsExample() {
	{{
		tooltipsUsage := `@uiControl.Button(uiControl.ButtonSettings{
	Label: "Top Tooltip",

	// OptionalFields
	TooltipContent:         "This tooltip appears on top",
	TooltipPosition:        uiToolset.TooltipPositionTop,
	TooltipBackgroundColor: "violet-950/95",
	TooltipTextColor:       "violet-100",
	TooltipRingColor:       "violet-500",
	TooltipRingThickness:   uiToolset.RingThicknessMd,
	TooltipMinWidthClass:   "min-w-48",
	TooltipMaxWidthClass:   "max-w-72",
	TooltipMinHeightClass:  "min-h-12",
	TooltipMaxHeightClass:  "max-h-32",
})`
	}}
	@DemoExampleCard(
		"Tooltips",
		"TooltipContent renders a tooltip on hover. TooltipPosition places it on any side. TooltipBackgroundColor, TooltipTextColor, TooltipRingColor, and TooltipRingThickness style the surface. The Min and Max width and height classes set its size limits. TooltipContentHtml accepts a component, and TooltipContentOneWayStatePath binds live text.",
		"/control/button.templ", tooltipsUsage,
	) {
		<div class="flex flex-col gap-2" x-data="{ dynamicTooltip: 'Live tooltip text' }">
			@uiControl.Button(uiControl.ButtonSettings{
				Label:           "Top Tooltip",
				IconLeft:        "ph-arrow-up",
				TooltipContent:  "This tooltip appears on top",
				TooltipPosition: uiToolset.TooltipPositionTop,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:           "Bottom Tooltip",
				IconLeft:        "ph-arrow-down",
				TooltipContent:  "This tooltip appears on bottom",
				TooltipPosition: uiToolset.TooltipPositionBottom,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:           "Left Tooltip",
				IconLeft:        "ph-arrow-left",
				TooltipContent:  "This tooltip appears on left",
				TooltipPosition: uiToolset.TooltipPositionLeft,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:           "Right Tooltip",
				IconLeft:        "ph-arrow-right",
				TooltipContent:  "This tooltip appears on right",
				TooltipPosition: uiToolset.TooltipPositionRight,
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:                  "Styled Tooltip",
				IconLeft:               "ph-paint-brush",
				TooltipContent:         "A styled tooltip surface with a ring and size limits.",
				TooltipPosition:        uiToolset.TooltipPositionTop,
				TooltipBackgroundColor: "violet-950/95",
				TooltipTextColor:       "violet-100",
				TooltipRingColor:       "violet-500",
				TooltipRingThickness:   uiToolset.RingThicknessMd,
				TooltipMinWidthClass:   "min-w-48",
				TooltipMaxWidthClass:   "max-w-72",
				TooltipMinHeightClass:  "min-h-12",
				TooltipMaxHeightClass:  "max-h-32",
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:              "HTML Tooltip",
				IconLeft:           "ph-code",
				TooltipContentHtml: ButtonTooltipHtmlContent(),
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:                         "Live Tooltip",
				IconLeft:                      "ph-activity",
				TooltipContentOneWayStatePath: "dynamicTooltip",
			})
		</div>
	}
}

templ ButtonDisabledBindingExample() {
	{{
		disabledUsage := `@uiControl.Button(uiControl.ButtonSettings{
	Label: "Click Me",

	// OptionalFields
	OnClickFunc:               "clickCount++",
	OnClickPreventDefault:     true,
	IsDisabled:                true,
	IsDisabledOneWayStatePath: "shouldDisable",
	IsVisibleOneWayStatePath:  "isVisible",
})`
	}}
	@DemoExampleCard(
		"Disabled Binding",
		"IsDisabledOneWayStatePath disables the button from Alpine state. IsDisabled disables it outright. IsVisibleOneWayStatePath hides it from Alpine state, and OnClickPreventDefault calls preventDefault before the click handler.",
		"/control/button.templ", disabledUsage,
	) {
		<div
			x-data="{clickCount: 0, isVisible: true, get shouldDisable() { return this.clickCount > 0 }}"
			class="flex flex-col gap-2"
		>
			<div class="flex flex-col gap-2">
				@uiControl.Button(uiControl.ButtonSettings{
					Label:                     "Click Me",
					IconLeft:                  "ph-plus",
					OnClickFunc:               "clickCount++",
					OnClickPreventDefault:     true,
					IsDisabledOneWayStatePath: "shouldDisable",
					IsVisibleOneWayStatePath:  "isVisible",
					IsFullWidth:               true,
				})
				@uiControl.Button(uiControl.ButtonSettings{
					Label:       "Always Disabled",
					IconLeft:    "ph-prohibit",
					IsDisabled:  true,
					IsFullWidth: true,
				})
				<div class="flex flex-row items-center gap-2">
					<p class={ DemoLiveStateInlineClasses }>
						Count: <span x-text="clickCount"></span>
					</p>
					@uiControl.Button(uiControl.ButtonSettings{
						IconLeft:    "ph-arrow-counter-clockwise",
						OnClickFunc: "clickCount = 0",
						Size:        uiControl.ButtonSizeSm,
						Shape:       uiToolset.ShapeCircular,
					})
					@uiControl.Button(uiControl.ButtonSettings{
						Label:           "Toggle Visibility",
						IconLeft:        "ph-eye",
						OnClickFunc:     "isVisible = !isVisible",
						Size:            uiControl.ButtonSizeSm,
						BackgroundColor: "neutral-700",
					})
				</div>
			</div>
		</div>
	}
}

templ ButtonFullWidthSubmitExample() {
	{{
		formUsage := `@uiControl.Button(uiControl.ButtonSettings{
	Label: "Save",

	// OptionalFields
	IsFullWidth: true,
	IsSubmit:    true,
})`
	}}
	@DemoExampleCard(
		"Full-Width & Submit",
		"IsFullWidth stretches the button to its container. IsSubmit renders a submit input for forms.",
		"/control/button.templ", formUsage,
	) {
		<div class="flex flex-col gap-2">
			@uiControl.Button(uiControl.ButtonSettings{
				Label:           "Full Width Action",
				IconLeft:        "ph-check",
				IsFullWidth:     true,
				BackgroundColor: "primary-600",
			})
			@uiControl.Button(uiControl.ButtonSettings{
				Label:    "Submit",
				IsSubmit: true,
			})
		</div>
	}
}

templ ButtonActionStatesExample() {
	{{
		actionUsage := `<form hx-post="/api/v1/account/" hx-swap="none">
	@uiControl.Button(uiControl.ButtonSettings{
		Label:    "Save",
		IsSubmit: true,

		// OptionalFields
		ShouldTrackAction:    true,
		PendingLabel:         "Saving",
		PendingIcon:          "ph-hourglass",
		PendingIconAnimation: uiToolset.AnimationPulse,
		SucceededLabel:       "Saved",
		SucceededIcon:        "ph-thumbs-up",
		FailedLabel:          "Save failed",
		FailedIcon:           "ph-skull",
	})
</form>

@uiControl.Button(uiControl.ButtonSettings{
	Label:       "Sync",
	OnClickFunc: "UiToolset.JsonAjax('POST', '/api/v1/sync/')",

	// OptionalFields
	ShouldTrackAction: true,
	PendingLabel:      "Syncing",
	SucceededLabel:    "Synced",
	FailedLabel:       "Sync failed",
})

@uiControl.Button(uiControl.ButtonSettings{
	Label: "Delete account",

	// OptionalFields
	IsPendingOneWayStatePath: "isSyncing",
	PendingLabel:             "Wait for the sync",
})`
	}}
	@DemoExampleCard(
		"Action States",
		"ShouldTrackAction makes the button report the action it starts: the owning form when IsSubmit is set, or the promise OnClickFunc returns. It shows PendingLabel while the action runs, then SucceededLabel or FailedLabel for two seconds. The four labels each accept a OneWayStatePath. PendingIcon, SucceededIcon, and FailedIcon replace the default icons, and PendingIconAnimation takes a uiToolset.Animation* constant. IsPendingOneWayStatePath shows the pending state from Alpine state.",
		"/control/button.templ", actionUsage,
	) {
		@uiToolset.MinifierTemplateJs(&buttonDemoAlpineState)
		<div class="flex flex-col gap-3" x-data="buttonDemoActions">
			<p class="text-xs font-bold text-neutral-400">Form actions</p>
			<div class="flex flex-row flex-wrap gap-3">
				<form hx-get="assets/ui-logo.svg" hx-swap="none">
					@uiControl.Button(uiControl.ButtonSettings{
						Label:             "Save",
						IconLeft:          "ph-floppy-disk",
						IsSubmit:          true,
						ShouldTrackAction: true,
						PendingLabel:      "Saving",
						SucceededLabel:    "Saved",
						FailedLabel:       "Save failed",
						BackgroundColor:   "primary-600",
					})
				</form>
				<form hx-get="assets/missing-action-target" hx-swap="none">
					@uiControl.Button(uiControl.ButtonSettings{
						Label:             "Save to a missing endpoint",
						IconLeft:          "ph-floppy-disk",
						IsSubmit:          true,
						ShouldTrackAction: true,
						PendingLabel:      "Saving",
						SucceededLabel:    "Saved",
						FailedLabel:       "Save failed",
					})
				</form>
			</div>
			<p class="text-xs font-bold text-neutral-400">Custom action icons and animation</p>
			<div class="flex flex-row flex-wrap gap-3">
				<form hx-get="assets/ui-logo.svg" hx-swap="none">
					@uiControl.Button(uiControl.ButtonSettings{
						Id:                   "button-demo-custom-icons",
						Label:                "Save with custom icons",
						IsSubmit:             true,
						ShouldTrackAction:    true,
						PendingIcon:          "ph-hourglass",
						PendingIconAnimation: uiToolset.AnimationPulse,
						SucceededIcon:        "ph-thumbs-up",
						FailedIcon:           "ph-skull",
						PendingLabel:         "Saving",
						SucceededLabel:       "Saved",
						FailedLabel:          "Save failed",
					})
				</form>
				<form hx-get="assets/ui-logo.svg" hx-swap="none">
					@uiControl.Button(uiControl.ButtonSettings{
						Id:                   "button-demo-no-animation",
						Label:                "Save with no animation",
						IsSubmit:             true,
						ShouldTrackAction:    true,
						PendingIconAnimation: uiToolset.AnimationNone,
						PendingLabel:         "Saving",
						SucceededLabel:       "Saved",
					})
				</form>
			</div>
			<p class="text-xs font-bold text-neutral-400">Click actions, no form</p>
			<div class="flex flex-row flex-wrap gap-3">
				@uiControl.Button(uiControl.ButtonSettings{
					Id:                "button-demo-sync",
					Label:             "Sync",
					IconLeft:          "ph-arrows-clockwise",
					OnClickFunc:       "syncAccounts()",
					ShouldTrackAction: true,
					PendingLabel:      "Syncing",
					SucceededLabel:    "Synced",
					FailedLabel:       "Sync failed",
				})
				@uiControl.Button(uiControl.ButtonSettings{
					Id:                "button-demo-broken-sync",
					Label:             "Sync a broken mirror",
					IconLeft:          "ph-arrows-clockwise",
					OnClickFunc:       "syncBrokenMirror()",
					ShouldTrackAction: true,
					PendingLabel:      "Syncing",
					SucceededLabel:    "Synced",
					FailedLabel:       "Sync failed",
				})
			</div>
			<p class="text-xs font-bold text-neutral-400">Dynamic labels</p>
			<div class="flex flex-row flex-wrap gap-3">
				@uiControl.Button(uiControl.ButtonSettings{
					Id:                            "button-demo-dynamic-labels",
					Label:                         "Static fallback",
					LabelOneWayStatePath:          "dynamicButtonLabel",
					IconLeft:                      "ph-tag",
					OnClickFunc:                   "syncAccounts()",
					ShouldTrackAction:             true,
					PendingLabelOneWayStatePath:   "dynamicPendingLabel",
					SucceededLabelOneWayStatePath: "dynamicSucceededLabel",
					FailedLabelOneWayStatePath:    "dynamicFailedLabel",
				})
				@uiControl.Button(uiControl.ButtonSettings{
					Id:                            "button-demo-dynamic-failure-labels",
					Label:                         "Static fallback",
					LabelOneWayStatePath:          "dynamicButtonLabel",
					IconLeft:                      "ph-tag",
					OnClickFunc:                   "syncBrokenMirror()",
					ShouldTrackAction:             true,
					PendingLabelOneWayStatePath:   "dynamicPendingLabel",
					SucceededLabelOneWayStatePath: "dynamicSucceededLabel",
					FailedLabelOneWayStatePath:    "dynamicFailedLabel",
				})
				@uiControl.Button(uiControl.ButtonSettings{
					Id:                   "button-demo-dynamic-idle-label",
					Label:                "Static fallback",
					LabelOneWayStatePath: "dynamicButtonLabel",
				})
			</div>
			<p class="text-xs font-bold text-neutral-400">Shared pending state</p>
			<div class="flex flex-row flex-wrap gap-3">
				@uiControl.Button(uiControl.ButtonSettings{
					Id:                       "button-demo-start-sync",
					Label:                    "Start sync",
					OnClickFunc:              "startSharedSync()",
					IsPendingOneWayStatePath: "isSyncing",
					PendingLabel:             "Syncing",
				})
				@uiControl.Button(uiControl.ButtonSettings{
					Id:                       "button-demo-delete-account",
					Label:                    "Delete account",
					IsPendingOneWayStatePath: "isSyncing",
					PendingLabel:             "Wait for the sync",
				})
			</div>
		</div>
	}
}

templ ButtonCountdownExample() {
	{{
		countdownUsage := `@uiControl.Button(uiControl.ButtonSettings{
	Label:                           "Delete",
	CountdownSeconds:                5,

	// OptionalFields
	CountdownTriggerOneWayStatePath: "retryCount",
})`
	}}
	@DemoExampleCard(
		"Countdown",
		"CountdownSeconds disables the button and shows the remaining seconds in the label. The countdown starts on mount. CountdownTriggerOneWayStatePath restarts it when an Alpine value changes, so a failed attempt can start it again.",
		"/control/button.templ", countdownUsage,
	) {
		<div class="flex flex-col gap-3" x-data="{retryCount: 0}">
			<div class="flex flex-wrap items-center gap-3">
				@uiControl.Button(uiControl.ButtonSettings{
					Id:               "button-demo-countdown",
					Label:            "Delete",
					IconLeft:         "ph-trash",
					CountdownSeconds: 5,
					BackgroundColor:  "red-500/20",
					TextColor:        "red-200",
				})
				@uiControl.Button(uiControl.ButtonSettings{
					Label:           "Restart countdown",
					IconLeft:        "ph-arrow-counter-clockwise",
					OnClickFunc:     "retryCount++",
					Size:            uiControl.ButtonSizeSm,
					BackgroundColor: "neutral-50/10",
				})
			</div>
			<div class="flex flex-wrap items-center gap-3">
				@uiControl.Button(uiControl.ButtonSettings{
					Id:                              "button-demo-triggered-countdown",
					Label:                           "Delete after retry",
					IconLeft:                        "ph-trash",
					CountdownSeconds:                2,
					CountdownTriggerOneWayStatePath: "retryCount",
					BackgroundColor:                 "red-500/20",
					TextColor:                       "red-200",
				})
				<p class={ DemoLiveStateInlineClasses }>
					Failed attempts: <span x-text="retryCount"></span>
				</p>
			</div>
		</div>
	}
}

templ ButtonTextCaseExample() {
	{{
		textCaseUsage := `@uiControl.Button(uiControl.ButtonSettings{
	Label:    "New Record",
	TextCase: uiToolset.TextCaseUpper,
})`
	}}
	@DemoExampleCard(
		"Text Case",
		"TextCase transforms the button label. It accepts uiToolset.TextCaseNone (the default, as typed), TextCaseLower, TextCaseUpper, or TextCaseCapitalize.",
		"/control/button.templ",
		textCaseUsage,
	) {
		<div class="flex flex-wrap items-center gap-2">
			for _, textCase := range []string{
				uiToolset.TextCaseNone,
				uiToolset.TextCaseLower,
				uiToolset.TextCaseUpper,
				uiToolset.TextCaseCapitalize,
			} {
				@uiControl.Button(uiControl.ButtonSettings{
					Label:           "New Record (" + textCase + ")",
					IconLeft:        "ph-plus",
					TextCase:        textCase,
					BackgroundColor: "primary-600",
				})
			}
		</div>
	}
}

templ ButtonDemo() {
	{{
		demoUsage := `@uiControl.Button(uiControl.ButtonSettings{
	Label:       "Click me",
	IconLeft:    "ph-info",
	OnClickFunc: "alert('Button clicked!')",
})`
	}}
	<div class="flex flex-col gap-4" id="button-demo">
		@DemoComponentSection(DemoComponentSectionSettings{
			ComponentPath:          "/control/button.templ",
			Description:            "A button is a clickable element that can be used to trigger an action.",
			LiveExampleDescription: "The action buttons an app reaches for: a primary action, a quiet secondary, and a destructive one.",
			Title:                  ".Button",
			UsageCode:              demoUsage,
		}) {
			<div x-data="{saveCount: 0}" class="flex flex-row flex-wrap items-center gap-3">
				@uiControl.Button(uiControl.ButtonSettings{
					Label:           "New Record",
					IconLeft:        "ph-plus",
					OnClickFunc:     "saveCount++",
					BackgroundColor: "primary-600",
				})
				@uiControl.Button(uiControl.ButtonSettings{
					Label:           "Export",
					IconLeft:        "ph-download",
					BackgroundColor: "neutral-50/10",
				})
				@uiControl.Button(uiControl.ButtonSettings{
					Label:           "Delete",
					IconLeft:        "ph-trash",
					BackgroundColor: "red-500/20",
					TextColor:       "red-200",
				})
				<p class={ DemoLiveStateClasses }>
					New Record clicks: <span x-text="saveCount"></span>
				</p>
			</div>
		}
		@DemoAdvancedExamples("button-demo", []uiDisplay.AccordionItemSettings{
			{Title: "Sizes", Icon: "ph-ruler", Content: ButtonSizesExample()},
			{Title: "Shapes", Icon: "ph-square", Content: ButtonShapesExample()},
			{Title: "Icons", Icon: "ph-star", Content: ButtonIconsExample()},
			{Title: "Colors", Icon: "ph-palette", Content: ButtonColorsExample()},
			{Title: "Rings", Icon: "ph-circle", Content: ButtonRingsExample()},
			{Title: "Tooltips", Icon: "ph-chats", Content: ButtonTooltipsExample()},
			{Title: "Disabled Binding", Icon: "ph-prohibit", Content: ButtonDisabledBindingExample()},
			{Title: "Full-Width & Submit", Icon: "ph-arrows-out", Content: ButtonFullWidthSubmitExample()},
			{Title: "Action States", Icon: "ph-spinner", Content: ButtonActionStatesExample()},
			{Title: "Countdown", Icon: "ph-timer", Content: ButtonCountdownExample()},
			{Title: "Text Case", Icon: "ph-text-t", Content: ButtonTextCaseExample()},
		})
	</div>
}
