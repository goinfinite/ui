package main

import (
	uiControl "github.com/goinfinite/ui/src/control"
	uiDisplay "github.com/goinfinite/ui/src/display"
	uiStructural "github.com/goinfinite/ui/src/structural"
)

templ SidebarDemoHeader() {
	<div class="flex flex-col gap-2 overflow-hidden p-3">
		<h4 class="text-wrap break-words text-lg font-bold" x-show="!isCollapsed">Sidebar Header</h4>
		<h4 class="text-wrap break-words text-lg font-bold" x-show="isCollapsed">SH</h4>
		<p class="text-sm text-neutral-400" x-show="!isCollapsed">This is the header content</p>
	</div>
}

templ SidebarDemoMiddle() {
	<div class="flex flex-col gap-5 p-3">
		<div class="flex flex-col gap-2">
			<h4 class="text-lg font-bold" x-show="!isCollapsed">Navigation</h4>
			<h4 class="text-center text-lg font-bold" x-show="isCollapsed">N</h4>
			<div class="flex flex-col gap-1" :class="{'*:justify-center': isCollapsed}">
				<a href="#" class="flex items-center gap-2 rounded-md p-2 text-neutral-50 hover:bg-neutral-800">
					<i class="ph-duotone ph-house"></i>
					<span x-show="!isCollapsed">Home</span>
				</a>
				<a href="#" class="flex items-center gap-2 rounded-md bg-neutral-800 p-2 text-neutral-50">
					<i class="ph-duotone ph-chart-line-up"></i>
					<span x-show="!isCollapsed">Dashboard</span>
				</a>
				<a href="#" class="flex items-center gap-2 rounded-md p-2 text-neutral-50 hover:bg-neutral-800">
					<i class="ph-duotone ph-gear"></i>
					<span x-show="!isCollapsed">Settings</span>
				</a>
			</div>
		</div>
		<div class="flex flex-col gap-2">
			<h4 class="text-lg font-bold" x-show="!isCollapsed">Recent Items</h4>
			<h4 class="text-center text-lg font-bold" x-show="isCollapsed">R</h4>
			<div class="flex flex-col gap-1" :class="{'*:justify-center': isCollapsed}">
				for i := 1; i <= 3; i++ {
					<div class="flex items-center gap-2 rounded-md p-2 text-neutral-400">
						<i class="ph-duotone ph-file-text"></i>
						<span x-show="!isCollapsed">Document { i }</span>
					</div>
				}
			</div>
		</div>
		<div class="flex flex-col gap-2">
			<h4 class="text-lg font-bold" x-show="!isCollapsed">Projects</h4>
			<h4 class="text-center text-lg font-bold" x-show="isCollapsed">P</h4>
			<div class="flex flex-col gap-1" :class="{'*:justify-center': isCollapsed}">
				for i := 1; i <= 10; i++ {
					<div class="flex items-center gap-2 rounded-md p-2 text-neutral-400">
						<i class="ph-duotone ph-folder"></i>
						<span x-show="!isCollapsed">Project { i }</span>
					</div>
				}
			</div>
		</div>
	</div>
}

templ SidebarDemoFooter() {
	<div class="flex flex-col gap-2 p-3">
		<h4 class="text-wrap break-words text-lg font-bold" x-show="!isCollapsed">Sidebar Footer</h4>
		<h4 class="text-wrap break-words text-lg font-bold" x-show="isCollapsed">SF</h4>
		<p class="text-sm text-neutral-400" x-show="!isCollapsed">This is the footer content</p>
	</div>
}

templ SidebarAttachmentModeExample() {
	{{
		attachmentUsage := `@uiStructural.Sidebar(uiStructural.SidebarSettings{
	MiddleContent: SidebarDemoMiddle(),

	// OptionalFields
	AttachmentModeTwoWayStatePath: "attachmentMode",
})`
	}}
	@DemoExampleCard(
		"Attachment Modes",
		"inline keeps the sidebar in the page flow. fixed pins it to the viewport while the rest of the page scrolls.",
		"/structural/sidebar.templ",
		attachmentUsage,
	) {
		<div
			class="grid items-center gap-10 md:grid-cols-2"
			x-data="{isAttachmentVisible: true, isCollapsed: false, attachmentMode: 'inline'}"
		>
			<div class="flex flex-col gap-2">
				<p class="text-sm text-neutral-400">AttachmentMode</p>
				<div class="flex flex-wrap gap-2">
					@uiControl.Button(uiControl.ButtonSettings{
						Label:           "Inline",
						IconLeft:        "ph-layout",
						OnClickFunc:     "attachmentMode = 'inline'",
						Size:            uiControl.ButtonSizeSm,
						BackgroundColor: "neutral-50/10",
					})
					@uiControl.Button(uiControl.ButtonSettings{
						Label:       "Fixed",
						IconLeft:    "ph-push-pin",
						OnClickFunc: "attachmentMode = 'fixed'",
						Size:        uiControl.ButtonSizeSm,
					})
				</div>
			</div>
			<div class="h-128 flex-none overflow-hidden rounded-md border border-neutral-800">
				@uiStructural.Sidebar(uiStructural.SidebarSettings{
					MiddleContent:                 SidebarDemoMiddle(),
					HeaderContent:                 SidebarDemoHeader(),
					FooterContent:                 SidebarDemoFooter(),
					BackgroundColor:               "bg-neutral-50/5",
					IsVisibleTwoWayStatePath:      "isAttachmentVisible",
					IsCollapsedTwoWayStatePath:    "isCollapsed",
					AttachmentModeTwoWayStatePath: "attachmentMode",
				})
			</div>
		</div>
	}
}

templ SidebarOffCanvasExample() {
	{{
		offCanvasUsage := `@uiStructural.Sidebar(uiStructural.SidebarSettings{
	MiddleContent: SidebarDemoMiddle(),

	// OptionalFields
	IsOffCanvas:                   true,
	IsOffCanvasTwoWayStatePath:    "isOffCanvas",
	IsVisibleTwoWayStatePath:      "isVisible",
})`
	}}
	@DemoExampleCard(
		"Off-Canvas",
		"IsOffCanvas overlays the sidebar on the content instead of pushing it. Pair it with IsVisibleTwoWayStatePath for a drawer.",
		"/structural/sidebar.templ",
		offCanvasUsage,
	) {
		<div
			class="grid items-center gap-10 md:grid-cols-2"
			x-data="{isOffCanvasVisible: true, isCollapsed: false, isOffCanvas: false}"
		>
			<div class="flex flex-col gap-2">
				<p class="text-sm text-neutral-400">OffCanvas</p>
				<div class="flex flex-wrap gap-2">
					@uiControl.Button(uiControl.ButtonSettings{
						Label:           "Off",
						IconLeft:        "ph-x",
						OnClickFunc:     "isOffCanvas = false",
						Size:            uiControl.ButtonSizeSm,
						BackgroundColor: "neutral-50/10",
					})
					@uiControl.Button(uiControl.ButtonSettings{
						Label:       "On",
						IconLeft:    "ph-check",
						OnClickFunc: "isOffCanvas = true",
						Size:        uiControl.ButtonSizeSm,
					})
					@uiControl.Button(uiControl.ButtonSettings{
						Label:       "Toggle Visibility",
						IconLeft:    "ph-eye",
						OnClickFunc: "isOffCanvasVisible = !isOffCanvasVisible",
						Size:        uiControl.ButtonSizeSm,
					})
				</div>
			</div>
			<div class="h-128 flex-none overflow-hidden rounded-md border border-neutral-800">
				@uiStructural.Sidebar(uiStructural.SidebarSettings{
					MiddleContent:              SidebarDemoMiddle(),
					HeaderContent:              SidebarDemoHeader(),
					FooterContent:              SidebarDemoFooter(),
					BackgroundColor:            "bg-neutral-50/5",
					IsVisibleTwoWayStatePath:   "isOffCanvasVisible",
					IsCollapsedTwoWayStatePath: "isCollapsed",
					IsOffCanvas:                true,
					IsOffCanvasTwoWayStatePath: "isOffCanvas",
				})
			</div>
		</div>
	}
}

templ SidebarSideExample() {
	{{
		sideUsage := `@uiStructural.Sidebar(uiStructural.SidebarSettings{
	MiddleContent: SidebarDemoMiddle(),

	// OptionalFields
	SideTwoWayStatePath: "side",
})`
	}}
	@DemoExampleCard(
		"Side",
		"Side attaches the sidebar to the left or right edge.",
		"/structural/sidebar.templ",
		sideUsage,
	) {
		<div
			class="grid items-center gap-10 md:grid-cols-2"
			x-data="{isSideVisible: true, isCollapsed: false, side: 'left'}"
		>
			<div class="flex flex-col gap-2">
				<p class="text-sm text-neutral-400">Side</p>
				<div class="flex flex-wrap gap-2">
					@uiControl.Button(uiControl.ButtonSettings{
						Label:           "Left",
						IconLeft:        "ph-align-left",
						OnClickFunc:     "side = 'left'",
						Size:            uiControl.ButtonSizeSm,
						BackgroundColor: "neutral-50/10",
					})
					@uiControl.Button(uiControl.ButtonSettings{
						Label:       "Right",
						IconLeft:    "ph-align-right",
						OnClickFunc: "side = 'right'",
						Size:        uiControl.ButtonSizeSm,
					})
				</div>
			</div>
			<div class="h-128 flex-none overflow-hidden rounded-md border border-neutral-800">
				@uiStructural.Sidebar(uiStructural.SidebarSettings{
					MiddleContent:              SidebarDemoMiddle(),
					HeaderContent:              SidebarDemoHeader(),
					FooterContent:              SidebarDemoFooter(),
					BackgroundColor:            "bg-neutral-50/5",
					IsVisibleTwoWayStatePath:   "isSideVisible",
					IsCollapsedTwoWayStatePath: "isCollapsed",
					SideTwoWayStatePath:        "side",
				})
			</div>
		</div>
	}
}

templ SidebarWidthBackgroundExample() {
	{{
		widthUsage := `@uiStructural.Sidebar(uiStructural.SidebarSettings{
	MiddleContent: SidebarDemoMiddle(),

	// OptionalFields
	Width:           "w-46",
	BackgroundColor: "bg-primary-900/80",
})`
	}}
	@DemoExampleCard(
		"Width & Background",
		"Width accepts a Tailwind width class. BackgroundColor accepts a Tailwind background class, opacity included.",
		"/structural/sidebar.templ",
		widthUsage,
	) {
		<div class="h-128 flex-none overflow-hidden rounded-md border border-neutral-800" x-data="{isWidthVisible: true, isCollapsed: false}">
			@uiStructural.Sidebar(uiStructural.SidebarSettings{
				MiddleContent:              SidebarDemoMiddle(),
				HeaderContent:              SidebarDemoHeader(),
				FooterContent:              SidebarDemoFooter(),
				BackgroundColor:            "bg-primary-900/80",
				Width:                      "w-46",
				IsVisibleTwoWayStatePath:   "isWidthVisible",
				IsCollapsedTwoWayStatePath: "isCollapsed",
			})
		</div>
	}
}

templ SidebarDemo() {
	{{
		demoUsage := `@uiStructural.Sidebar(uiStructural.SidebarSettings{
	MiddleContent: SidebarDemoMiddle(),

	// OptionalFields
	HeaderContent:              SidebarDemoHeader(),
	FooterContent:              SidebarDemoFooter(),
	IsVisibleTwoWayStatePath:   "isVisible",
	IsCollapsedTwoWayStatePath: "isCollapsed",
})`
	}}
	<div class="flex flex-col gap-4" id="sidebar-demo">
		@DemoComponentSection(DemoComponentSectionSettings{
			ComponentPath:          "/structural/sidebar.templ",
			Description:            "A sidebar is a vertical navigation component that can contain various types of content.",
			LiveExampleDescription: "An app shell with header, middle, and footer content. Collapse it or hide it from the controls.",
			Title:                  ".Sidebar",
			UsageCode:              demoUsage,
			AlpineStateCode: `<div x-data="{
  isVisible: true,
  isCollapsed: false,
}"></div>`,
		}) {
			<div
				class="grid items-center gap-10 md:grid-cols-2"
				x-data="{isVisible: true, isCollapsed: false}"
			>
				<div class="flex flex-col gap-2">
					<p class="text-sm text-neutral-400">Controls</p>
					<div class="flex flex-wrap gap-2">
						@uiControl.Button(uiControl.ButtonSettings{
							Label:       "Toggle Visibility",
							IconLeft:    "ph-eye",
							OnClickFunc: "isVisible = !isVisible",
							Size:        uiControl.ButtonSizeSm,
						})
						@uiControl.Button(uiControl.ButtonSettings{
							Label:       "Toggle Collapsed",
							IconLeft:    "ph-arrows-in",
							OnClickFunc: "isCollapsed = !isCollapsed",
							Size:        uiControl.ButtonSizeSm,
						})
					</div>
				</div>
				<div class="h-128 flex-none overflow-hidden rounded-md border border-neutral-800">
					@uiStructural.Sidebar(uiStructural.SidebarSettings{
						MiddleContent:              SidebarDemoMiddle(),
						HeaderContent:              SidebarDemoHeader(),
						FooterContent:              SidebarDemoFooter(),
						BackgroundColor:            "bg-neutral-50/5",
						IsVisibleTwoWayStatePath:   "isVisible",
						IsCollapsedTwoWayStatePath: "isCollapsed",
					})
				</div>
			</div>
		}
		@DemoAdvancedExamples([]uiDisplay.AccordionItemSettings{
			{Title: "Attachment Modes", Icon: "ph-push-pin", Content: SidebarAttachmentModeExample()},
			{Title: "Off-Canvas", Icon: "ph-crop", Content: SidebarOffCanvasExample()},
			{Title: "Side", Icon: "ph-align-left", Content: SidebarSideExample()},
			{Title: "Width & Background", Icon: "ph-paint-bucket", Content: SidebarWidthBackgroundExample()},
		})
	</div>
}
