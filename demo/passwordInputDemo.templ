package main

import (
	uiDisplay "github.com/goinfinite/ui/src/display"
	uiForm "github.com/goinfinite/ui/src/form"
)

templ PasswordInputCustomRulesExample() {
	{{
		customRulesUsage := `@uiForm.PasswordInput(uiForm.PasswordInputSettings{
	InputName:       "customPassword",
	Label:           "Password",
	TwoWayStatePath: "customPassword",

	// OptionalFields
	Rules: uiForm.PasswordInputRules{
		MinLength:                   12,
		MaxLength:                   24,
		GenerationLength:            16,
		ShouldIncludeLowercaseChars: true,
		ShouldIncludeUppercaseChars: true,
		ShouldIncludeNumbers:        true,
		ShouldIncludeSpecialChars:   false,
	},
	ShouldShowGenerateButton: true,
	ShouldShowStrengthMeter:  true,
})`
	}}
	@DemoExampleCard(
		"Custom Rules",
		"Rules drive the generated password and the criteria checklist: length range, generation length, and the required character classes.",
		"/form/passwordInput.templ", customRulesUsage,
	) {
		<div x-data="{customPassword: ''}" class="flex flex-col gap-3">
			@uiForm.PasswordInput(uiForm.PasswordInputSettings{
				InputName:       "customPassword",
				Label:           "Password",
				TwoWayStatePath: "customPassword",
				Rules: uiForm.PasswordInputRules{
					MinLength:                   12,
					MaxLength:                   24,
					GenerationLength:            16,
					ShouldIncludeLowercaseChars: true,
					ShouldIncludeUppercaseChars: true,
					ShouldIncludeNumbers:        true,
					ShouldIncludeSpecialChars:   false,
				},
				ShouldShowGenerateButton: true,
				ShouldShowStrengthMeter:  true,
			})
			<p class={ DemoLiveStateClasses }>
				Value: <span x-text="customPassword"></span>
			</p>
		</div>
	}
}

templ PasswordInputGenerateOnlyExample() {
	{{
		generateOnlyUsage := `@uiForm.PasswordInput(uiForm.PasswordInputSettings{
	InputName:       "generatedPassword",
	Label:           "Generated Password",
	TwoWayStatePath: "generatedPassword",

	// OptionalFields
	ShouldShowGenerateButton: true,
})`
	}}
	@DemoExampleCard(
		"Generate Button Only",
		"Set ShouldShowStrengthMeter to false to keep just the field and the generate button.",
		"/form/passwordInput.templ", generateOnlyUsage,
	) {
		<div x-data="{generatedPassword: ''}" class="flex flex-col gap-3">
			@uiForm.PasswordInput(uiForm.PasswordInputSettings{
				InputName:                "generatedPassword",
				Label:                    "Generated Password",
				TwoWayStatePath:          "generatedPassword",
				ShouldShowGenerateButton: true,
			})
			<p class={ DemoLiveStateClasses }>
				Value: <span x-text="generatedPassword"></span>
			</p>
		</div>
	}
}

templ PasswordInputMeterOnlyExample() {
	{{
		meterOnlyUsage := `@uiForm.PasswordInput(uiForm.PasswordInputSettings{
	InputName:       "meterPassword",
	Label:           "Password",
	TwoWayStatePath: "meterPassword",

	// OptionalFields
	ShouldShowStrengthMeter: true,
})`
	}}
	@DemoExampleCard(
		"Strength Meter Only",
		"Set ShouldShowGenerateButton to false to keep the reveal toggle and the strength meter only.",
		"/form/passwordInput.templ", meterOnlyUsage,
	) {
		<div x-data="{meterPassword: ''}" class="flex flex-col gap-3">
			@uiForm.PasswordInput(uiForm.PasswordInputSettings{
				InputName:               "meterPassword",
				Label:                   "Password",
				TwoWayStatePath:         "meterPassword",
				ShouldShowStrengthMeter: true,
			})
		</div>
	}
}

templ PasswordInputSizesExample() {
	{{
		sizesUsage := `@uiForm.PasswordInput(uiForm.PasswordInputSettings{
	InputName:                "sizedPassword",
	Label:                    "Password",
	TwoWayStatePath:          "sizedPassword",
	ShouldShowGenerateButton: true,
	ShouldShowStrengthMeter:  true,
	Size:                     uiForm.InputFieldSizeLg,
})`
	}}
	@DemoExampleCard(
		"Sizes",
		"Size reaches InputField through the password component, so the field, the label, and the action buttons scale together: xs, sm, md (the default), lg, or xl.",
		"/form/passwordInput.templ", sizesUsage,
	) {
		<div class="flex flex-col gap-4 lg:*:max-w-60" x-data="{xsPass: '', smPass: '', mdPass: '', lgPass: '', xlPass: ''}">
			for _, inputSize := range []string{
				uiForm.InputFieldSizeXs,
				uiForm.InputFieldSizeSm,
				uiForm.InputFieldSizeMd,
				uiForm.InputFieldSizeLg,
				uiForm.InputFieldSizeXl,
			} {
				@uiForm.PasswordInput(uiForm.PasswordInputSettings{
					InputName:                "passwordSize",
					Label:                    "Password (" + inputSize + ")",
					TwoWayStatePath:          inputSize + "Pass",
					ShouldShowGenerateButton: true,
					ShouldShowStrengthMeter:  false,
					Size:                     inputSize,
				})
			}
		</div>
	}
}

templ PasswordInputHintsExample() {
	{{
		hintsUsage := `@uiForm.PasswordInput(uiForm.PasswordInputSettings{
	InputName:                "hintedPassword",
	Label:                    "Password",
	TwoWayStatePath:          "hintedPassword",
	ShouldShowGenerateButton: true,
	ShouldShowStrengthMeter:  true,
	HintValue:                "Use at least 12 characters.",
	HintDisplay:              uiForm.InputHintDisplayTooltip,
})`
	}}
	@DemoExampleCard(
		"Hints",
		"PasswordInput forwards the hint settings to InputField, so the hint shows as a tooltip or a description line.",
		"/form/passwordInput.templ", hintsUsage,
	) {
		<div class="flex flex-col gap-6" x-data="{hintedPassword: ''}">
			@uiForm.PasswordInput(uiForm.PasswordInputSettings{
				InputName:                "hintedPasswordDescription",
				Label:                    "Password",
				TwoWayStatePath:          "hintedPassword",
				ShouldShowGenerateButton: true,
				ShouldShowStrengthMeter:  true,
				HintValue:                "This is a helpful hint displayed as a description below the field.",
				HintDisplay:              uiForm.InputHintDisplayDescription,
			})
			@uiForm.PasswordInput(uiForm.PasswordInputSettings{
				InputName:                "hintedPasswordTooltip",
				Label:                    "Password",
				TwoWayStatePath:          "hintedPassword",
				ShouldShowGenerateButton: true,
				ShouldShowStrengthMeter:  true,
				HintValue:                "This is a helpful hint displayed as a tooltip.",
				HintDisplay:              uiForm.InputHintDisplayTooltip,
			})
		</div>
	}
}

templ PasswordInputHintIconStyleExample() {
	{{
		hintIconUsage := `@uiForm.PasswordInput(uiForm.PasswordInputSettings{
	InputName:                "boxedHintPassword",
	Label:                    "Password",
	TwoWayStatePath:          "boxedHintPassword",
	ShouldShowGenerateButton: true,
	ShouldShowStrengthMeter:  true,
	HintValue:                "Use at least 12 characters.",
	HintDisplay:              uiForm.InputHintDisplayTooltip,
	HintIconStyle:            uiForm.InputHintIconStyleBoxed,
})`
	}}
	@DemoExampleCard(
		"Hint Icon Styles",
		"HintIconStyle renders the hint trigger as an icon or as a boxed tooltip.",
		"/form/passwordInput.templ", hintIconUsage,
	) {
		<div x-data="{boxedHintPassword: ''}">
			@uiForm.PasswordInput(uiForm.PasswordInputSettings{
				InputName:                "boxedHintPassword",
				Label:                    "Password",
				TwoWayStatePath:          "boxedHintPassword",
				ShouldShowGenerateButton: true,
				ShouldShowStrengthMeter:  true,
				HintValue:                "This is a helpful hint displayed as a boxed tooltip.",
				HintDisplay:              uiForm.InputHintDisplayTooltip,
				HintIconStyle:            uiForm.InputHintIconStyleBoxed,
			})
		</div>
	}
}

templ PasswordInputActionButtonStylesExample() {
	{{
		actionButtonStylesUsage := `@uiForm.PasswordInput(uiForm.PasswordInputSettings{
	InputName:                "plainActionPassword",
	Label:                    "Password",
	TwoWayStatePath:          "plainActionPassword",
	ShouldShowGenerateButton: true,
	ShouldShowStrengthMeter:  true,
	ActionButtonStyle:        uiForm.PasswordInputActionButtonStylePlain,
})`
	}}
	@DemoExampleCard(
		"Action Button Styles",
		"ActionButtonStyle accepts PasswordInputActionButtonStyleBoxed (the default) or PasswordInputActionButtonStylePlain for bare icons.",
		"/form/passwordInput.templ", actionButtonStylesUsage,
	) {
		<div x-data="{boxedActionPassword: '', plainActionPassword: ''}" class="flex flex-col gap-3">
			@uiForm.PasswordInput(uiForm.PasswordInputSettings{
				InputName:                "boxedActionPassword",
				Label:                    "Password (boxed)",
				TwoWayStatePath:          "boxedActionPassword",
				ShouldShowGenerateButton: true,
				ShouldShowStrengthMeter:  true,
			})
			@uiForm.PasswordInput(uiForm.PasswordInputSettings{
				InputName:                "plainActionPassword",
				Label:                    "Password (plain)",
				TwoWayStatePath:          "plainActionPassword",
				ShouldShowGenerateButton: true,
				ShouldShowStrengthMeter:  true,
				ActionButtonStyle:        uiForm.PasswordInputActionButtonStylePlain,
			})
		</div>
	}
}

templ PasswordInputStrengthColorsExample() {
	{{
		strengthColorsUsage := `@uiForm.PasswordInput(uiForm.PasswordInputSettings{
	InputName:                "coloredPassword",
	Label:                    "Password",
	TwoWayStatePath:          "coloredPassword",
	ShouldShowGenerateButton: true,
	ShouldShowStrengthMeter:  true,

	// OptionalFields
	StrengthMeterColor:               "primary-500",
	StrengthCriteriaTextColor:        "primary-200",
	StrengthCriteriaFulfilledIconColor:   "emerald-400",
	StrengthCriteriaUnfulfilledIconColor: "amber-400",
})`
	}}
	@DemoExampleCard(
		"Strength Meter Colors",
		"StrengthMeterColor paints the bar. StrengthCriteriaTextColor paints the checklist, and the two icon colors paint the pass and fail marks.",
		"/form/passwordInput.templ", strengthColorsUsage,
	) {
		<div x-data="{coloredPassword: 'password'}" class="flex flex-col gap-3">
			@uiForm.PasswordInput(uiForm.PasswordInputSettings{
				InputName:                        "coloredPassword",
				Label:                            "Password",
				TwoWayStatePath:                  "coloredPassword",
				ShouldShowGenerateButton:         true,
				ShouldShowStrengthMeter:          true,
				StrengthMeterColor:               "primary-500",
				StrengthCriteriaTextColor:        "primary-200",
				StrengthCriteriaFulfilledIconColor:   "emerald-400",
				StrengthCriteriaUnfulfilledIconColor: "amber-400",
			})
			<p class={ DemoLiveStateClasses }>
				Value: <span x-text="coloredPassword"></span>
			</p>
		</div>
	}
}

templ PasswordInputDemo() {
	{{
		demoUsage := `@uiForm.PasswordInput(uiForm.PasswordInputSettings{
	InputName:       "password",
	Label:           "Password",
	TwoWayStatePath: "password",

	// OptionalFields
	ShouldShowGenerateButton: true,
	ShouldShowStrengthMeter:  true,
})`
	}}
	<div class="flex flex-col gap-4" id="password-input-demo">
		@DemoComponentSection(DemoComponentSectionSettings{
			ComponentPath:          "/form/passwordInput.templ",
			Description:            "A password input adds a reveal toggle, a random password generator, and a strength meter to the standard field. The meter shows a percentage bar plus a criteria checklist that updates as the user types.",
			LiveExampleDescription: "Type a password to watch the meter, reveal it with the eye toggle, or generate a strong one with the binary button.",
			Title:                  ".PasswordInput",
			UsageCode:              demoUsage,
			AlpineStateCode:        `<div x-data="{password: ''}"></div>`,
		}) {
			<div x-data="{password: ''}" class="flex flex-col gap-3">
				@uiForm.PasswordInput(uiForm.PasswordInputSettings{
					InputName:                "password",
					Label:                    "Password",
					TwoWayStatePath:          "password",
					ShouldShowGenerateButton: true,
					ShouldShowStrengthMeter:  true,
				})
				<p class={ DemoLiveStateClasses }>
					Value: <span x-text="password"></span>
				</p>
			</div>
		}
		@DemoAdvancedExamples([]uiDisplay.AccordionItemSettings{
			{Title: "Custom Rules", Icon: "ph-sliders", Content: PasswordInputCustomRulesExample()},
			{Title: "Generate Button Only", Icon: "ph-binary", Content: PasswordInputGenerateOnlyExample()},
			{Title: "Strength Meter Only", Icon: "ph-gauge", Content: PasswordInputMeterOnlyExample()},
			{Title: "Strength Meter Colors", Icon: "ph-palette", Content: PasswordInputStrengthColorsExample()},
			{Title: "Sizes", Icon: "ph-ruler", Content: PasswordInputSizesExample()},
			{Title: "Hints", Icon: "ph-info", Content: PasswordInputHintsExample()},
			{Title: "Hint Icon Styles", Icon: "ph-question", Content: PasswordInputHintIconStyleExample()},
			{Title: "Action Button Styles", Icon: "ph-eye", Content: PasswordInputActionButtonStylesExample()},
		})
	</div>
}
