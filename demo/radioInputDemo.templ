package main

import (
	uiDisplay "github.com/goinfinite/ui/src/display"
	uiForm "github.com/goinfinite/ui/src/form"
	uiToolset "github.com/goinfinite/ui/src/toolset"
)

templ RadioInputSizesExample() {
	{{
		sizesUsage := `@uiForm.RadioInput(uiForm.RadioInputSettings{
	Label:           "Option 1",
	StateValue:      "option1",
	TwoWayStatePath: "selectedOption",

	// OptionalFields
	InputName: "options",
	Size:      uiForm.RadioInputSizeMd,
	TextCase:  uiToolset.TextCaseUpper,
})`
	}}
	@DemoExampleCard(
		"Sizes",
		"Size scales the radio and its label: xs, sm, md, lg, or xl. TextCase transforms the label, and InputName names the radio in the form.",
		"/form/radioInput.templ", sizesUsage,
	) {
		<div class="flex flex-col gap-3" x-data="{selectedOption: 'option1'}">
			for _, radioSize := range []string{uiForm.RadioInputSizeXs, uiForm.RadioInputSizeSm, uiForm.RadioInputSizeMd, uiForm.RadioInputSizeLg, uiForm.RadioInputSizeXl} {
				@uiForm.RadioInput(uiForm.RadioInputSettings{
					Label:           radioSize,
					StateValue:      radioSize,
					TwoWayStatePath: "selectedOption",
					InputName:       "options",
					Size:            radioSize,
					TextCase:        uiToolset.TextCaseUpper,
				})
			}
		</div>
	}
}

templ RadioInputColorsExample() {
	{{
		colorsUsage := `@uiForm.RadioInput(uiForm.RadioInputSettings{
	Label:           "Option 1",
	StateValue:      "option1",
	TwoWayStatePath: "selectedOption",

	// OptionalFields
	Style: uiForm.RadioInputStyle{
		ActiveColor:    "violet-400",
		FocusRingColor: "violet-400",
		TextColor:      "violet-100",
	},
})`
	}}
	@DemoExampleCard(
		"Colors",
		"Style sets the idle text color, the checked and hover color, and the keyboard focus ring around the icon.",
		"/form/radioInput.templ", colorsUsage,
	) {
		<div class="flex flex-col gap-2" x-data="{selectedOption: 'option1'}">
			@uiForm.RadioInput(uiForm.RadioInputSettings{
				Label:           "Option 1",
				StateValue:      "option1",
				TwoWayStatePath: "selectedOption",
				Style: uiForm.RadioInputStyle{
					ActiveColor:    "violet-400",
					FocusRingColor: "violet-400",
					TextColor:      "violet-100",
				},
			})
			@uiForm.RadioInput(uiForm.RadioInputSettings{
				Label:           "Option 2",
				StateValue:      "option2",
				TwoWayStatePath: "selectedOption",
				Style: uiForm.RadioInputStyle{
					ActiveColor:    "violet-400",
					FocusRingColor: "violet-400",
					TextColor:      "violet-100",
				},
			})
			<p class={ DemoLiveStateClasses }>
				Value: <span x-text="selectedOption"></span>
			</p>
		</div>
	}
}

templ RadioInputDemo() {
	{{
		demoUsage := `@uiForm.RadioInput(uiForm.RadioInputSettings{
	Label:           "Option 1",
	StateValue:      "option1",
	TwoWayStatePath: "selectedOption",
	InputId:         "radioOption1",
	InputName:       "options",
})`
	}}
	<div class="flex flex-col gap-4" id="radio-input-demo">
		@DemoComponentSection(DemoComponentSectionSettings{
			ComponentPath:          "/form/radioInput.templ",
			Description:            "A radio input allows users to select one option from a set of options.",
			LiveExampleDescription: "A radio group bound to one shared Alpine state path.",
			Title:                  ".RadioInput",
			UsageCode:              demoUsage,
			AlpineStateCode:        `<div x-data="{selectedOption: 'option2'}"></div>`,
		}) {
			<div x-data="{selectedOption: 'option2'}" class="flex flex-col gap-4">
				<div class="flex flex-col gap-2">
					@uiForm.RadioInput(uiForm.RadioInputSettings{
						Label:           "Option 1",
						StateValue:      "option1",
						TwoWayStatePath: "selectedOption",
						InputId:         "radioOption1",
						InputName:       "options",
					})
					@uiForm.RadioInput(uiForm.RadioInputSettings{
						Label:           "Option 2",
						StateValue:      "option2",
						TwoWayStatePath: "selectedOption",
						InputId:         "radioOption2",
						InputName:       "options",
					})
				</div>
				<p class={ DemoLiveStateClasses }>
					Value: <span x-text="selectedOption"></span>
				</p>
			</div>
		}
		@DemoAdvancedExamples("radio-input-demo", []uiDisplay.AccordionItemSettings{
			{Title: "Sizes", Icon: "ph-ruler", Content: RadioInputSizesExample()},
			{Title: "Colors", Icon: "ph-paint-brush", Content: RadioInputColorsExample()},
		})
	</div>
}
